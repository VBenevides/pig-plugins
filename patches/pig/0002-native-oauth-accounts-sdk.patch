+package sdk
+
+import (
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/extensions/sdk/json"
+)
+
+func TestNativeOAuthAccountSDKCalls(t *testing.T) {
+	ext := New("native-oauth-accounts")
+	var accounts []OAuthAccount
+	var auth map[string]any
+	var failure error
+	ext.Command("probe", "probe native accounts", func(ctx Context, _ string) error {
+		var err error
+		accounts, err = ctx.OAuthAccounts()
+		if err != nil {
+			return err
+		}
+		auth, err = ctx.OAuthAccountAuth(accounts[0].ID)
+		if err != nil {
+			return err
+		}
+		if err := ctx.SelectOAuthAccount(accounts[1].ID); err != nil {
+			return err
+		}
+		_, failure = ctx.OAuthAccountAuth("missing")
+		return nil
+	})
+	host, _, done := surfaceHost(t, ext, nil)
+	defer surfaceShutdown(t, host, done)
+	calls := []string{}
+	runSurfaceCommand(t, host, "probe", func(call *callMsg) *callResultMsg {
+		calls = append(calls, call.Method)
+		var params struct {
+			ID string `json:"id"`
+		}
+		if len(call.Args) > 0 && string(call.Args) != "null" {
+			if err := json.Unmarshal(call.Args, &params); err != nil {
+				t.Fatal(err)
+			}
+		}
+		switch call.Method {
+		case "oauthAccounts":
+			return &callResultMsg{Result: json.RawMessage(`[{"id":"first","provider":"openai-codex","label":"First","active":true,"expires":1000},{"id":"second","provider":"openai-codex","label":"Second","active":false,"expires":2000}]`)}
+		case "oauthAccountAuth":
+			if params.ID == "missing" {
+				return &callResultMsg{Error: &errorInfo{Message: "oauth accounts: account not found"}}
+			}
+			if params.ID != "first" {
+				t.Fatal("wrong account auth argument")
+			}
+			return &callResultMsg{Result: json.RawMessage(`{"type":"oauth","access":"fixture-access","expires":1000,"accountId":"fixture-account"}`)}
+		case "selectOAuthAccount":
+			if params.ID != "second" {
+				t.Fatal("wrong selection argument")
+			}
+			return &callResultMsg{Result: json.RawMessage(`null`)}
+		default:
+			t.Fatal("unexpected host call", call.Method)
+			return nil
+		}
+	})
+	if len(calls) != 4 || len(accounts) != 2 || !accounts[0].Active || accounts[1].Active {
+		t.Fatal("native metadata was not preserved")
+	}
+	if auth["access"] != "fixture-access" || failure == nil || failure.Error() != "oauth accounts: account not found" {
+		t.Fatal("native credential result or missing-ID error was not preserved")
+	}
+}
