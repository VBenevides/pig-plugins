+package sdk
+
+// OAuthAccount is safe native login metadata. ID is an opaque local account ID,
+// not a token or the provider's account ID. Expires is milliseconds since epoch.
+type OAuthAccount struct {
+	ID       string  `json:"id"`
+	Provider string  `json:"provider"`
+	Label    string  `json:"label"`
+	Active   bool    `json:"active"`
+	Expires  float64 `json:"expires"`
+}
+
+// OAuthAccounts lists native OAuth logins without refreshing or returning tokens.
+func (c Context) OAuthAccounts() ([]OAuthAccount, error) {
+	return hostValue[[]OAuthAccount](c, "oauthAccounts", nil)
+}
+
+// OAuthAccountAuth explicitly reads a native credential for quota requests.
+// The returned type/access/expires/accountId fields include the access token.
+// Do not log, display, or persist this result. This read does not refresh tokens.
+func (c Context) OAuthAccountAuth(id string) (map[string]any, error) {
+	return hostValue[map[string]any](c, "oauthAccountAuth", map[string]string{"id": id})
+}
+
+// SelectOAuthAccount durably selects the same credential used by native requests.
+func (c Context) SelectOAuthAccount(id string) error {
+	_, err := hostValue[any](c, "selectOAuthAccount", map[string]string{"id": id})
+	return err
+}
