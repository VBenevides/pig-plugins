diff --git a/internal/codingagent/distribution_versions_test.go b/internal/codingagent/distribution_versions_test.go
new file mode 100644
index 0000000..b8acb1f
--- /dev/null
+++ b/internal/codingagent/distribution_versions_test.go
@@ -0,0 +1,42 @@
+package codingagent
+
+import (
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/internal/coding/pigversion"
+	"github.com/MichaelKinsy/PiG/tui/widthx"
+	pigplugins "github.com/VBenevides/pig-plugins"
+)
+
+func distributionVersionText() string {
+	return "PiG - " + pigversion.Version + " | PiG Plugins - " + pigplugins.Version()
+}
+
+func TestDistributionVersionsStayInStartupHeader(t *testing.T) {
+	isolatePigHome(t)
+	for _, width := range []int{20, 40, 70, 120} {
+		t.Run(strconv.Itoa(width), func(t *testing.T) {
+			m := &InteractiveMode{opts: InteractiveModeOptions{LoginVisible: true}, extHeader: newSpecialLinesComponent(nil)}
+			m.restoreBuiltInHeader()
+			lines := m.extHeader.Render(width)
+			for _, line := range lines {
+				if widthx.VisibleWidth(line) > width {
+					t.Fatalf("header exceeds %d columns: %q", width, line)
+				}
+			}
+			if width == 120 {
+				want := distributionVersionText()
+				if got := stripANSITest(strings.Join(lines, "\n")); !strings.Contains(got, want) {
+					t.Fatalf("header missing embedded versions %q: %q", want, got)
+				}
+			}
+			m.opts.LoginVisible = false
+			m.restoreBuiltInHeader()
+			if got := m.extHeader.Render(width); len(got) != 0 {
+				t.Fatalf("quiet startup rendered header: %q", got)
+			}
+		})
+	}
+}
