@@ -0,0 +1,41 @@
+package codingagent
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestExpandInlineSkillCommands(t *testing.T) {
+	skills := []*SkillDef{
+		{Name: "alpha", Body: "alpha body", Path: "/skills/alpha.md", Dir: "/skills", SourceInfo: PiSourceInfo{Source: "inline"}},
+		{Name: "beta", Body: "beta body", Path: "/skills/beta.md", Dir: "/skills", SourceInfo: PiSourceInfo{Source: "inline"}},
+	}
+
+	t.Run("expands each known skill once and keeps the text", func(t *testing.T) {
+		text := "fix the bug /skill:beta then /skill:alpha and /skill:beta again, /skill:missing"
+		got, ok, failure := ExpandInlineSkillCommands(text, skills)
+		if !ok || failure != nil {
+			t.Fatalf("ok=%v failure=%v", ok, failure)
+		}
+		if !strings.HasSuffix(got, "\n\n"+text) {
+			t.Errorf("original text is not preserved at the end: %q", got)
+		}
+		if strings.Count(got, "<skill name=\"beta\"") != 1 || strings.Count(got, "<skill name=\"alpha\"") != 1 {
+			t.Errorf("each skill must expand once: %q", got)
+		}
+		if strings.Index(got, "name=\"beta\"") > strings.Index(got, "name=\"alpha\"") {
+			t.Errorf("blocks must follow order of first mention: %q", got)
+		}
+		if strings.Contains(got, "name=\"missing\"") {
+			t.Errorf("unknown skill expanded: %q", got)
+		}
+	})
+
+	t.Run("leaves unknown skills, plain text and commands alone", func(t *testing.T) {
+		for _, text := range []string{"use /skill:missing", "no skill here", "/other /skill:alpha", "path/skill:alpha"} {
+			if got, ok, failure := ExpandInlineSkillCommands(text, skills); ok {
+				t.Errorf("%q expanded to %q (failure %v)", text, got, failure)
+			}
+		}
+	})
+}
diff --git a/internal/codingagent/skills.go b/internal/codingagent/skills.go
index d480d19..9a1e18c 100644
--- a/internal/codingagent/skills.go
+++ b/internal/codingagent/skills.go
@@ -312,6 +312,38 @@ func ExpandSkillCommand(text string, skills []*SkillDef) (string, bool, *extensi
 	return block, true, nil
 }
 
+// inlineSkillTokenRe finds `/skill:name` tokens that start the text or follow whitespace.
+var inlineSkillTokenRe = lazyregexp.New(`(?:^|\s)/skill:([A-Za-z0-9_-]+)`)
+
+// ExpandInlineSkillCommands expands `/skill:name` tokens inside a prompt that does not start with `/`. Each known skill
+// is expanded once, in order of first mention. The skill blocks come first and the original text follows unchanged.
+// Unknown skills are left alone. Read and parse errors leave input unchanged and carry a skill_expansion diagnostic.
+func ExpandInlineSkillCommands(text string, skills []*SkillDef) (string, bool, *extension.ExtensionError) {
+	if strings.HasPrefix(text, "/") {
+		return "", false, nil
+	}
+	seen := map[string]bool{}
+	var blocks []string
+	for _, match := range inlineSkillTokenRe.FindAllStringSubmatch(text, -1) {
+		name := match[1]
+		if seen[name] {
+			continue
+		}
+		seen[name] = true
+		block, ok, failure := ExpandSkillCommand("/skill:"+name, skills)
+		if failure != nil {
+			return "", false, failure
+		}
+		if ok {
+			blocks = append(blocks, block)
+		}
+	}
+	if len(blocks) == 0 {
+		return "", false, nil
+	}
+	return strings.Join(blocks, "\n\n") + "\n\n" + text, true, nil
+}
+
 // skillBlockRe matches upstream's parseSkillBlock regex:
 //
 //	/^<skill name="([^"]+)" location="([^"]+)">\n([\s\S]*?)\n<\/skill>(?:\n\n([\s\S]+))?$/
