diff --git a/tui/skill_slash_autocomplete.go b/tui/skill_slash_autocomplete.go
new file mode 100644
index 0000000..5a5ca2c
--- /dev/null
+++ b/tui/skill_slash_autocomplete.go
@@ -0,0 +1,117 @@
+package tui
+
+// Mid-prompt skill autocomplete. A "/" that starts a line or follows whitespace, after prompt text, lists skills
+// only. Commands stay limited to the start of the message, and a token that matches no skill falls through to path
+// completion. The matching rules follow Oh My Pi (pi-tui/src/autocomplete.ts).
+
+import (
+	"strings"
+	"unicode/utf8"
+
+	"github.com/MichaelKinsy/PiG/tui/widthx"
+)
+
+const skillCommandPrefix = "skill:"
+
+// trailingSlashToken finds a "/token" that ends text, starts the text or follows whitespace, and has no further
+// "/" or whitespace. It returns the index of the slash.
+func trailingSlashToken(text string) (int, bool) {
+	slash := strings.LastIndexByte(text, '/')
+	if slash < 0 || strings.IndexFunc(text[slash+1:], widthx.IsJSSpace) >= 0 {
+		return 0, false
+	}
+	if slash > 0 {
+		if r, _ := utf8.DecodeLastRuneInString(text[:slash]); !widthx.IsJSSpace(r) {
+			return 0, false
+		}
+	}
+	return slash, true
+}
+
+// proseBefore reports whether the prompt has text before byte offset end of line row, on that line or an earlier one.
+func proseBefore(lines []string, row, end int) bool {
+	if row < 0 || row >= len(lines) {
+		return false
+	}
+	if widthx.JSTrim(lines[row][:max(0, min(end, len(lines[row])))]) != "" {
+		return true
+	}
+	for _, line := range lines[:row] {
+		if widthx.JSTrim(line) != "" {
+			return true
+		}
+	}
+	return false
+}
+
+// midPromptSlashToken returns the text after the slash when the cursor (byte column) is inside a slash token that
+// follows prompt text, on this line or on an earlier one.
+func midPromptSlashToken(lines []string, row, col int) (string, bool) {
+	if row < 0 || row >= len(lines) {
+		return "", false
+	}
+	before := lines[row][:min(col, len(lines[row]))]
+	slash, ok := trailingSlashToken(before)
+	if !ok || !proseBefore(lines, row, slash) {
+		return "", false
+	}
+	return before[slash+1:], true
+}
+
+// midPromptSkillMatches reports whether token (without the slash) is skill-shaped enough to list the command.
+// A stray "/word" in prose must not keep the popup open, so only these tokens match: a prefix of "skill:", a
+// "skill:..." query that fuzzy-matches the name, or a prefix of the bare name or of a hyphen-separated segment.
+func midPromptSkillMatches(token, name string) bool {
+	token, name = strings.ToLower(token), strings.ToLower(name)
+	if !strings.HasPrefix(name, skillCommandPrefix) {
+		return false
+	}
+	if strings.HasPrefix(skillCommandPrefix, token) {
+		return true
+	}
+	if strings.HasPrefix(token, skillCommandPrefix) {
+		return len(FuzzyFilter([]string{name}, token, func(s string) string { return s })) > 0
+	}
+	bare := name[len(skillCommandPrefix):]
+	for i := 0; i < len(bare); i++ {
+		if (i == 0 || bare[i-1] == '-') && strings.HasPrefix(bare[i:], token) {
+			return true
+		}
+	}
+	return false
+}
+
+// midPromptSkillSuggestions lists skill commands for token, or returns nil when none match.
+func (p *SlashOnlyProvider) midPromptSkillSuggestions(token string) *AutocompleteSuggestions {
+	var matched []SlashCommand
+	for _, c := range p.Commands {
+		if midPromptSkillMatches(token, c.Name) {
+			matched = append(matched, c)
+		}
+	}
+	if strings.HasPrefix(strings.ToLower(token), skillCommandPrefix) && len(token) > len(skillCommandPrefix) {
+		matched = FuzzyFilter(matched, token, func(c SlashCommand) string { return c.Name })
+	}
+	if len(matched) == 0 {
+		return nil
+	}
+	items := make([]AutocompleteItem, len(matched))
+	for i, c := range matched {
+		items[i] = AutocompleteItem{Value: c.Name, Label: c.Name, Description: c.Description}
+	}
+	return &AutocompleteSuggestions{Items: items, Prefix: "/" + token}
+}
+
+// acceptSubmits reports whether accepting a completion with this prefix also submits the prompt. Only a slash name
+// at the start of the message does; a path or skill completed after prompt text only edits the text.
+func acceptSubmits(lines []string, row, col int, prefix string) bool {
+	return strings.HasPrefix(prefix, "/") && !proseBefore(lines, row, col-len(prefix))
+}
+
+// midPromptSlashContext reports whether the cursor sits in a slash token after prompt text, which opens the popup
+// without a trigger character.
+func (e *Editor) midPromptSlashContext() bool {
+	lines, row, col := e.autocompleteView()
+	_, ok := midPromptSlashToken(lines, row, col)
+	return ok
+}
diff --git a/tui/skill_slash_autocomplete_test.go b/tui/skill_slash_autocomplete_test.go
new file mode 100644
index 0000000..1341802
--- /dev/null
+++ b/tui/skill_slash_autocomplete_test.go
@@ -0,0 +1,107 @@
+package tui
+
+import (
+	"slices"
+	"testing"
+)
+
+func skillTestCommands() []SlashCommand {
+	return []SlashCommand{
+		{Name: "help", Description: "Show help"},
+		{Name: "skill:humanizer", Description: "Humanize text"},
+		{Name: "skill:research-last30days", Description: "Research"},
+		{Name: "skill:brainstorm", Description: "Ideas"},
+	}
+}
+
+func suggestionValues(s *AutocompleteSuggestions) []string {
+	if s == nil {
+		return nil
+	}
+	values := make([]string, len(s.Items))
+	for i, item := range s.Items {
+		values[i] = item.Value
+	}
+	return values
+}
+
+func TestMidPromptSlashListsOnlySkills(t *testing.T) {
+	provider := NewCombinedProvider(skillTestCommands(), t.TempDir(), "")
+	tests := []struct {
+		name   string
+		lines  []string
+		row    int
+		col    int
+		want   []string
+		prefix string
+	}{
+		{"bare slash lists every skill", []string{"fix it /"}, 0, 8, []string{"skill:humanizer", "skill:research-last30days", "skill:brainstorm"}, "/"},
+		{"bare name prefix", []string{"fix it /hum"}, 0, 11, []string{"skill:humanizer"}, "/hum"},
+		{"hyphen segment prefix", []string{"fix it /last"}, 0, 12, []string{"skill:research-last30days"}, "/last"},
+		{"skill namespace query", []string{"fix it /skill:br"}, 0, 16, []string{"skill:brainstorm"}, "/skill:br"},
+		{"commands are not offered", []string{"fix it /hel"}, 0, 11, nil, ""},
+		{"later line after prompt text", []string{"first line", "/hum"}, 1, 4, []string{"skill:humanizer"}, "/hum"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := provider.GetSuggestions(tt.lines, tt.row, tt.col)
+			if !slices.Equal(suggestionValues(got), tt.want) {
+				t.Fatalf("values = %v, want %v", suggestionValues(got), tt.want)
+			}
+			if got != nil && got.Prefix != tt.prefix {
+				t.Errorf("prefix = %q, want %q", got.Prefix, tt.prefix)
+			}
+		})
+	}
+}
+
+func TestMidPromptSlashLeavesPathsAndLeadingCommands(t *testing.T) {
+	provider := NewCombinedProvider(skillTestCommands(), t.TempDir(), "")
+	if got := provider.GetSuggestions([]string{"see /tmp/x"}, 0, 10); got != nil {
+		for _, item := range got.Items {
+			if len(item.Value) >= 6 && item.Value[:6] == "skill:" {
+				t.Errorf("path token produced skill %q", item.Value)
+			}
+		}
+	}
+	got := provider.GetSuggestions([]string{"/hel"}, 0, 4)
+	if want := []string{"help"}; !slices.Equal(suggestionValues(got), want) {
+		t.Errorf("leading command values = %v, want %v", suggestionValues(got), want)
+	}
+}
+
+func TestMidPromptSkillCompletionInsertsTokenWithoutSubmit(t *testing.T) {
+	provider := NewCombinedProvider(skillTestCommands(), t.TempDir(), "")
+	lines := []string{"fix it /hum later"}
+	got := provider.GetSuggestions([]string{"fix it /hum"}, 0, 11)
+	if got == nil {
+		t.Fatal("no suggestions")
+	}
+	out, row, col := provider.ApplyCompletion(lines, 0, 11, got.Items[0], got.Prefix)
+	if want := "fix it /skill:humanizer  later"; out[0] != want || row != 0 || col != len("fix it /skill:humanizer ") {
+		t.Errorf("completion = %q row %d col %d, want %q", out[0], row, col, want)
+	}
+	if acceptSubmits([]string{"fix it /hum"}, 0, 11, "/hum") {
+		t.Error("accepting mid-text must not submit")
+	}
+	if !acceptSubmits([]string{"/hel"}, 0, 4, "/hel") {
+		t.Error("accepting a leading command must submit")
+	}
+}
+
+func TestEditorOpensSkillPopupMidText(t *testing.T) {
+	editor := NewEditor()
+	editor.SetAutocomplete(NewCombinedProvider(skillTestCommands(), t.TempDir(), ""))
+	for _, r := range "fix it /hum" {
+		editor.HandleInput(string(r))
+	}
+	if !editor.AutocompleteOpen() {
+		t.Fatal("skill popup did not open mid-text")
+	}
+	if editor.AutocompleteAccept() {
+		t.Error("accepting mid-text must not submit")
+	}
+	if got, want := editor.Text(), "fix it /skill:humanizer "; got != want {
+		t.Errorf("text = %q, want %q", got, want)
+	}
+}
