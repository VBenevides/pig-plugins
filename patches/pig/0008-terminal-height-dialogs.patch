+package tui
+
+import "strconv"
+
+// SetTerminalHeight budgets the complete selector, not just its message body.
+func (e *ExtensionSelectorComponent) SetTerminalHeight(height int) {
+	e.terminalHeight = max(0, height)
+}
+
+func (e *ExtensionSelectorComponent) pageRows() int {
+	if e.terminalHeight > 0 {
+		return max(1, e.bodyRows)
+	}
+	return extensionSelectorBodyRows
+}
+
+func (e *ExtensionSelectorComponent) renderHeight(width int, text func(string) []string, border []string) []string {
+	budget := max(1, e.terminalHeight*7/10)
+	oneLine := func(value string) string {
+		rows := text(value)
+		if len(rows) == 0 {
+			return ""
+		}
+		return rows[0]
+	}
+	var lines []string
+	borders := 0
+	if budget >= 4 {
+		borders = 2 * len(border)
+		lines = append(lines, border...)
+	}
+	// Reserve body space, but keep every approval option visible whenever it
+	// physically fits. At extremely small heights, options follow the cursor.
+	optionRows := min(len(e.rowTexts), max(1, budget-borders-2))
+	remaining := max(0, budget-borders-optionRows)
+	hintRows := 0
+	if remaining >= 4 {
+		hintRows = 1
+	}
+	body := text(e.titleText)
+	body = append(body, styledDescriptionLines(e.descriptionText, width)...)
+	e.bodyRows = max(0, remaining-hintRows)
+	scrolling := len(body) > e.bodyRows
+	if scrolling && e.bodyRows > 1 {
+		e.bodyRows-- // reserve a one-row scroll indicator
+	}
+	e.bodyScroll = max(0, min(e.bodyScroll, max(0, len(body)-e.bodyRows)))
+	end := min(len(body), e.bodyScroll+e.bodyRows)
+	lines = append(lines, body[e.bodyScroll:end]...)
+	if scrolling && remaining-hintRows > 1 {
+		status := "lines " + strconv.Itoa(e.bodyScroll+1) + "-" + strconv.Itoa(end) + " of " + strconv.Itoa(len(body)) + "  pgup/pgdn scroll"
+		lines = append(lines, oneLine(ActiveTheme().FgText("muted", status)))
+	}
+	start := max(0, min(e.cursor, len(e.rowTexts)-optionRows))
+	for _, row := range e.rowTexts[start : start+optionRows] {
+		lines = append(lines, oneLine(row))
+	}
+	if hintRows > 0 {
+		lines = append(lines, oneLine(e.hintText))
+	}
+	if borders > 0 {
+		lines = append(lines, border...)
+	}
+	return lines
+}
