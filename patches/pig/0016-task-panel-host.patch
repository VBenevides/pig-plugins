diff --git a/internal/codingagent/interactive_tasks.go b/internal/codingagent/interactive_tasks.go
new file mode 100644
index 0000000..7d30532
--- /dev/null
+++ b/internal/codingagent/interactive_tasks.go
@@ -0,0 +1,50 @@
+package codingagent
+
+import (
+	"os"
+
+	"github.com/MichaelKinsy/PiG/tui"
+)
+
+func taskPanelEnabled() bool { return os.Getenv("PIG_PLUGINS_HOST_VERSION") != "" }
+
+type taskWidgetContent []string
+
+func (c taskWidgetContent) WidgetContent() ([]string, bool) { return append([]string(nil), c...), true }
+func (c taskWidgetContent) Render(int) []string             { return append([]string(nil), c...) }
+func (c taskWidgetContent) Invalidate()                     {}
+
+func (m *InteractiveMode) taskWidget(component tui.Component) tui.Component {
+	if !taskPanelEnabled() {
+		return component
+	}
+	source, ok := component.(interface{ WidgetContent() ([]string, bool) })
+	if !ok {
+		return component
+	}
+	if _, ok := source.WidgetContent(); !ok {
+		return component
+	}
+	if m.taskPanel == nil {
+		m.taskPanel = &tui.TaskPanel{
+			RequestRender: func() {
+				if m.tuiInst != nil {
+					m.tuiInst.RequestRender()
+				}
+			},
+			ReturnFocus: func() {
+				if m.tuiInst != nil {
+					m.tuiInst.SetFocus(m.editor)
+				}
+			},
+		}
+	}
+	m.taskPanel.Content = func() []string { lines, _ := source.WidgetContent(); return lines }
+	return m.taskPanel
+}
+
+func (m *InteractiveMode) releaseTaskPanelFocus() {
+	if m.tuiInst != nil && m.tuiInst.GetFocusedComponent() == m.taskPanel {
+		m.tuiInst.SetFocus(m.editor)
+	}
+}
