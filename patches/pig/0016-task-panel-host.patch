--- /dev/null
+++ b/tui/task_panel_test.go
@@ -0,0 +1,108 @@
+package tui
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/tui/widthx"
+)
+
+func taskPanelFixture(n int) (*TaskPanel, *[]string) {
+	content := []string{"Tasks"}
+	for i := 0; i < n; i++ {
+		content = append(content, fmt.Sprintf("[ ] task %d", i))
+	}
+	return &TaskPanel{Content: func() []string { return content }}, &content
+}
+
+func TestTaskPanelFixedHeightAndWidths(t *testing.T) {
+	for _, n := range []int{0, 1, 2, 3, 4, 30} {
+		p, content := taskPanelFixture(n)
+		before := append([]string(nil), (*content)...)
+		for _, width := range []int{0, 1, 8, 80} {
+			rows := p.Render(width)
+			want := 4
+			if n == 0 {
+				want = 0
+			}
+			if len(rows) != want {
+				t.Fatalf("tasks=%d height=%d", n, len(rows))
+			}
+			for _, row := range rows {
+				if widthx.VisibleWidth(row) > width {
+					t.Fatalf("width=%d row=%q", width, row)
+				}
+			}
+		}
+		if !reflect.DeepEqual(before, *content) {
+			t.Fatal("task source changed")
+		}
+	}
+}
+
+func TestTaskPanelKeyboardMouseAndFocus(t *testing.T) {
+	p, _ := taskPanelFixture(30)
+	returned, renders := 0, 0
+	p.ReturnFocus = func() { returned++ }
+	p.RequestRender = func() { renders++ }
+	p.HandleInput("j")
+	if p.offset != 0 {
+		t.Fatal("unfocused key captured")
+	}
+	result := p.HandleMouse(TuiMouseEvent{Type: MousePress, Button: MouseButtonLeft})
+	if result == nil || !result.Focus {
+		t.Fatal("click did not request focus")
+	}
+	p.SetFocused(true)
+	p.HandleInput("j")
+	p.HandleInput("\x1b[B")
+	if p.offset != 2 {
+		t.Fatalf("down keys: %d", p.offset)
+	}
+	p.HandleInput("\x1b[107;1:3u")
+	if p.offset != 2 {
+		t.Fatal("key release scrolled")
+	}
+	p.HandleInput("k")
+	p.HandleInput("\x1b[A")
+	if p.offset != 0 {
+		t.Fatal("up keys failed")
+	}
+	p.HandleMouse(TuiMouseEvent{Type: MouseWheel, WheelDelta: 100})
+	rows := p.Render(100)
+	if p.offset != 27 || !strings.Contains(rows[3], "task 29") || !strings.Contains(rows[0], "FOCUSED") {
+		t.Fatalf("last tasks unavailable: %v", rows)
+	}
+	p.HandleMouse(TuiMouseEvent{Type: MouseWheel, WheelDelta: -100})
+	if p.offset != 0 {
+		t.Fatal("wheel exceeded first task")
+	}
+	p.HandleInput("\x1b")
+	if returned != 1 || p.Focused() || renders == 0 {
+		t.Fatal("Escape did not return focus")
+	}
+}
+
+func TestTaskPanelFollowsActiveUntilManualScroll(t *testing.T) {
+	p, content := taskPanelFixture(12)
+	(*content)[9] = "[•] active"
+	if rows := p.Render(100); !strings.Contains(strings.Join(rows, "\n"), "active") {
+		t.Fatalf("active task hidden: %v", rows)
+	}
+	p.scroll(-100)
+	(*content)[9] = "[✓] previous"
+	(*content)[12] = "[•] next active"
+	if rows := p.Render(100); p.offset != 0 || strings.Contains(strings.Join(rows, "\n"), "next active") {
+		t.Fatalf("manual position lost: %v", rows)
+	}
+	*content = (*content)[:3]
+	if len(p.Render(100)) != 4 || p.offset != 0 {
+		t.Fatal("short update changed height")
+	}
+	*content = nil
+	if rows := p.Render(100); len(rows) != 0 {
+		t.Fatalf("empty panel: %v", rows)
+	}
+}
