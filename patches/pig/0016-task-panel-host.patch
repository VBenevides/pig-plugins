@@ -0,0 +1,91 @@
+package codingagent
+
+import (
+	"fmt"
+	"io"
+	"strings"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/coding/extension/host/subprocess"
+	"github.com/MichaelKinsy/PiG/tui"
+)
+
+func TestTaskWidgetViewportSurvivesUpdatesAndClearsFocus(t *testing.T) {
+	t.Setenv("PIG_PLUGINS_HOST_VERSION", "test")
+	m := NewInteractiveMode(nil, InteractiveModeOptions{TuiMode: "fullscreen", AgentDir: t.TempDir()})
+	m.rendererOut = io.Discard
+	handle := m.createInteractiveTui(t.Context())
+	defer handle.cleanup()
+	prepareInteractionTestLayout(m)
+	m.mountInteractiveTui(false)
+	m.uiTaskCh = make(chan func(), 64)
+	ui := &ExtUIContext{m: m}
+	content := []string{"Tasks"}
+	for i := 0; i < 30; i++ {
+		content = append(content, fmt.Sprintf("[ ] task %d", i))
+	}
+	ui.SetWidget("todo-widget", content, nil)
+	runPostedTasks(t, m)
+	panel := m.taskPanel
+	if panel == nil || len(panel.Render(100)) != 4 {
+		t.Fatal("task viewport not mounted")
+	}
+	m.tuiInst.SetFocus(panel)
+	panel.HandleMouse(tui.TuiMouseEvent{Type: tui.MouseWheel, WheelDelta: 100})
+	if rows := panel.Render(100); !strings.Contains(rows[3], "task 29") {
+		t.Fatalf("truncated content: %v", rows)
+	}
+	updated := append([]string(nil), content...)
+	updated[30] = "[•] updated task"
+	ui.SetWidget("todo-widget", updated, nil)
+	runPostedTasks(t, m)
+	if m.taskPanel != panel || m.tuiInst.GetFocusedComponent() != panel || !strings.Contains(panel.Render(100)[3], "updated task") {
+		t.Fatal("update lost viewport or focus")
+	}
+	panel.HandleInput("\x1b")
+	if m.tuiInst.GetFocusedComponent() != m.editor {
+		t.Fatal("Escape did not focus editor")
+	}
+	m.tuiInst.SetFocus(panel)
+	m.clearInprocessWidget("todo-widget")
+	if m.taskPanel != nil || m.tuiInst.GetFocusedComponent() != m.editor {
+		t.Fatal("removed panel retained focus")
+	}
+}
+
+func TestTaskWidgetProxyHasAllRowsAndKeepsOtherWidgets(t *testing.T) {
+	t.Setenv("PIG_PLUGINS_HOST_VERSION", "test")
+	m := &InteractiveMode{widgetContainer: tui.NewContainer()}
+	proxy := subprocess.NewPushProxy(func() {}, nil)
+	content := []string{"Tasks"}
+	for i := 0; i < 30; i++ {
+		content = append(content, fmt.Sprintf("[ ] task %d", i))
+	}
+	proxy.UpdateContent(content)
+	other := subprocess.NewPushProxy(func() {}, nil)
+	other.UpdateContent([]string{"other widget"})
+	m.syncWidgets(map[string]*subprocess.PushProxy{"todo-widget": proxy, "other": other})
+	if m.taskPanel == nil {
+		t.Fatal("proxy not wrapped")
+	}
+	m.taskPanel.HandleMouse(tui.TuiMouseEvent{Type: tui.MouseWheel, WheelDelta: 100})
+	if !strings.Contains(m.taskPanel.Render(100)[3], "task 29") {
+		t.Fatal("proxy content truncated")
+	}
+	if !strings.Contains(strings.Join(m.widgetContainer.Render(100), "\n"), "other widget") {
+		t.Fatal("other widget changed")
+	}
+	snapshot, ok := proxy.WidgetContent()
+	if !ok {
+		t.Fatal("text content not available")
+	}
+	snapshot[1] = "mutated"
+	again, _ := proxy.WidgetContent()
+	if again[1] == "mutated" {
+		t.Fatal("snapshot changed source")
+	}
+	m.syncWidgets(nil)
+	if m.taskPanel != nil {
+		t.Fatal("removed proxy kept viewport")
+	}
+}
diff --git a/tui/task_panel.go b/tui/task_panel.go
new file mode 100644
index 0000000..19a525f
--- /dev/null
+++ b/tui/task_panel.go
@@ -0,0 +1,110 @@
+package tui
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/MichaelKinsy/PiG/tui/widthx"
+)
+
+// TaskPanel is a display-only viewport: one header and three task rows.
+// Content supplies untruncated string-list entries, with a header first.
+type TaskPanel struct {
+	Content       func() []string
+	RequestRender func()
+	ReturnFocus   func()
+	offset        int
+	manual        bool
+	focused       bool
+	rows          []string
+	header        string
+}
+
+func (p *TaskPanel) sync() {
+	var content []string
+	if p.Content != nil {
+		content = p.Content()
+	}
+	p.rows, p.header = nil, "Tasks"
+	if len(content) > 0 {
+		p.header, p.rows = content[0], content[1:]
+	}
+	if !p.manual {
+		for i, row := range p.rows {
+			if strings.HasPrefix(widthx.StripTerminalSequences(row), "[•]") {
+				if i < p.offset || i >= p.offset+3 {
+					p.offset = i
+				}
+				break
+			}
+		}
+	}
+	p.offset = max(0, min(p.offset, max(0, len(p.rows)-3)))
+}
+
+func (p *TaskPanel) Render(width int) []string {
+	p.sync()
+	if len(p.rows) == 0 {
+		return nil
+	}
+	hint := " · click to focus"
+	prefix := ""
+	if p.focused {
+		prefix = "[FOCUSED] "
+		hint = " · ↑↓ j/k · Esc: input"
+	}
+	header := fmt.Sprintf("%s%s · %d–%d/%d%s", prefix, p.header, p.offset+1, min(p.offset+3, len(p.rows)), len(p.rows), hint)
+	rows := []string{widthx.TruncateToWidth(header, max(0, width), "…", false)}
+	for i := 0; i < 3; i++ {
+		row := ""
+		if p.offset+i < len(p.rows) {
+			row = p.rows[p.offset+i]
+		}
+		rows = append(rows, widthx.TruncateToWidth(row, max(0, width), "…", false))
+	}
+	return rows
+}
+
+func (p *TaskPanel) scroll(delta int) {
+	p.sync()
+	p.manual = true
+	p.offset = max(0, min(max(0, len(p.rows)-3), p.offset+delta))
+	if p.RequestRender != nil {
+		p.RequestRender()
+	}
+}
+
+func (p *TaskPanel) HandleInput(data string) {
+	if !p.focused || IsKeyRelease(data) {
+		return
+	}
+	switch {
+	case MatchesKeyID(data, "up"), data == "k":
+		p.scroll(-1)
+	case MatchesKeyID(data, "down"), data == "j":
+		p.scroll(1)
+	case MatchesKeyID(data, "escape"):
+		p.focused = false
+		if p.ReturnFocus != nil {
+			p.ReturnFocus()
+		}
+		if p.RequestRender != nil {
+			p.RequestRender()
+		}
+	}
+}
+
+func (p *TaskPanel) HandleMouse(event TuiMouseEvent) *TuiMouseDispatchResult {
+	switch {
+	case event.Type == MouseWheel:
+		p.scroll(event.WheelDelta)
+		return &TuiMouseDispatchResult{TuiMouseEventResult: TuiMouseEventResult{Handled: true}}
+	case (event.Type == MousePress || event.Type == MouseClick) && event.Button == MouseButtonLeft:
+		return &TuiMouseDispatchResult{TuiMouseEventResult: TuiMouseEventResult{Focus: true}}
+	}
+	return nil
+}
+
+func (p *TaskPanel) SetFocused(focused bool) { p.focused = focused }
+func (p *TaskPanel) Focused() bool           { return p.focused }
+func (p *TaskPanel) Invalidate()             {}
diff --git a/tui/task_panel_test.go b/tui/task_panel_test.go
new file mode 100644
