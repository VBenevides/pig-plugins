diff --git a/tui/inline_command.go b/tui/inline_command.go
new file mode 100644
index 0000000..480adbe
--- /dev/null
+++ b/tui/inline_command.go
@@ -0,0 +1,77 @@
+package tui
+
+import (
+	"slices"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/MichaelKinsy/PiG/internal/jsstring"
+	"github.com/MichaelKinsy/PiG/tui/widthx"
+)
+
+// TakeInlineCommand removes a known slash command ending at the cursor without
+// clearing surrounding text, paste markers, or the draft's undo history.
+func (e *Editor) TakeInlineCommand(known func(string) bool) (string, bool) {
+	if e.remote != nil {
+		return "", false
+	}
+	row, col := e.cursor[0], e.cursor[1]
+	before := jsstring.Slice(e.lines[row], 0, col)
+	// Search backwards so slashes in command arguments (such as model IDs)
+	// do not hide the command name.
+	for end := len(before); end > 0; {
+		slash := strings.LastIndexByte(before[:end], '/')
+		if slash < 0 {
+			break
+		}
+		end = slash
+		if slash > 0 {
+			r, _ := utf8.DecodeLastRuneInString(before[:slash])
+			if !widthx.IsJSSpace(r) {
+				continue
+			}
+		}
+		command := strings.TrimSpace(before[slash:])
+		fields := strings.Fields(command)
+		if len(fields) == 0 || !known(strings.TrimPrefix(fields[0], "/")) {
+			continue
+		}
+		// Leading commands with no surrounding draft retain the normal submit path.
+		after := jsstring.Slice(e.lines[row], col)
+		if !proseBefore(e.lines, row, slash) && strings.TrimSpace(after+strings.Join(e.lines[row+1:], "\n")) == "" {
+			return "", false
+		}
+		e.saveHistory()
+		e.lastAction = ""
+		e.lines[row] = before[:slash] + after
+		e.setCursorCol(jsstring.Length(before[:slash]))
+		e.AutocompleteCancel()
+		e.Invalidate()
+		if e.OnChange != nil {
+			e.OnChange(e.Text())
+		}
+		return command, true
+	}
+	return "", false
+}
+
+// RestoreDraftIfCleared captures draft state for a command that may clear the
+// input. A newer nonempty draft is never overwritten by delayed completion.
+func (e *Editor) RestoreDraftIfCleared() func() {
+	lines, cursor := slices.Clone(e.lines), e.cursor
+	pastes, counter := clonePastes(e.pastes), e.pasteCounter
+	history := slices.Clone(e.history)
+	return func() {
+		if e.Text() != "" {
+			return
+		}
+		e.lines, e.cursor = lines, cursor
+		e.pastes, e.pasteCounter = pastes, counter
+		e.history = history
+		e.lastAction = ""
+		e.Invalidate()
+		if e.OnChange != nil {
+			e.OnChange(e.Text())
+		}
+	}
+}
