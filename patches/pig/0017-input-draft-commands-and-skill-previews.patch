+package codingagent
+
+import (
+	"context"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/tui"
+)
+
+func TestInlineCommandRunsWithoutSubmittingDraft(t *testing.T) {
+	for _, idle := range []bool{true, false} {
+		q := newInputQueueMode(t)
+		q.isIdle = idle
+		q.editor.SetText("explain this /mode ask")
+		q.editor.OnSubmit = func(string) { t.Fatal("local command submitted the draft") }
+		calls := 0
+		q.slashRegistry.Register(BuiltinSlashCommand{Name: "mode", Handler: func(sc *SlashContext) error {
+			calls++
+			if sc.Args != "ask" {
+				t.Fatalf("args = %q", sc.Args)
+			}
+			q.editor.Clear() // Commands that clear input must still preserve the draft.
+			return nil
+		}})
+		if err := q.handleEditorAction(context.Background(), actionSubmit, "\r"); err != nil {
+			t.Fatal(err)
+		}
+		if calls != 1 || q.editor.Text() != "explain this " {
+			t.Fatalf("idle=%v calls=%d draft=%q", idle, calls, q.editor.Text())
+		}
+		q.stop()
+		q.backgroundCancel()
+	}
+}
+
+func TestInlineClearDiscardsOnlyInput(t *testing.T) {
+	q := newInputQueueMode(t)
+	defer q.stop()
+	defer q.backgroundCancel()
+	q.chatContainer.Add(tui.NewText("conversation remains"))
+	q.editor.SetText("discard this /clear")
+	if !q.handleInlineEditorCommand(context.Background()) {
+		t.Fatal("clear not handled")
+	}
+	if q.editor.Text() != "" || len(q.chatContainer.Render(80)) == 0 {
+		t.Fatal("clear did not discard just the input")
+	}
+}
+
+func TestInlineSendQueuesDraftOnceDuringCompaction(t *testing.T) {
+	for _, tc := range []struct {
+		command string
+		mode    compactionQueueMode
+	}{
+		{"/send", compactionQueueSteer},
+		{"/send queue", compactionQueueFollowUp},
+	} {
+		t.Run(tc.command, func(t *testing.T) {
+			q := newInputQueueMode(t)
+			defer q.stop()
+			defer q.backgroundCancel()
+			q.isCompacting = true
+			q.editor.SetText("send this draft " + tc.command)
+			if !q.handleInlineEditorCommand(context.Background()) {
+				t.Fatal("send not handled")
+			}
+			if q.editor.Text() != "" || len(q.compactionQueue) != 1 || q.compactionQueue[0].text != "send this draft" || q.compactionQueue[0].mode != tc.mode {
+				t.Fatalf("draft=%q queue=%+v", q.editor.Text(), q.compactionQueue)
+			}
+			if q.handleInlineEditorCommand(context.Background()) || len(q.compactionQueue) != 1 {
+				t.Fatal("send duplicated a queued message")
+			}
+		})
+	}
+}
+
+func TestDraftCommandValidationDoesNotDiscardInput(t *testing.T) {
+	q := newInputQueueMode(t)
+	defer q.stop()
+	defer q.backgroundCancel()
+	q.editor.SetText("keep this /send invalid")
+	if !q.handleInlineEditorCommand(context.Background()) || q.editor.Text() != "keep this " {
+		t.Fatal("invalid send lost draft")
+	}
+	for _, line := range []string{"/clear invalid", "/send invalid"} {
+		sc := q.buildSlashContext(context.Background())
+		if err := q.slashRegistry.Dispatch(sc, line, nil); err == nil {
+			t.Fatalf("%q accepted invalid arguments", line)
+		}
+	}
+}
