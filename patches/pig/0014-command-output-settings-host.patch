@@ -0,0 +1,140 @@
+package codingagent
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/MichaelKinsy/PiG/tui"
+)
+
+func TestReducerSettingsRoundTripAndLayers(t *testing.T) {
+	for _, value := range []bool{false, true} {
+		original := Settings{ReduceCommandOutput: new(value)}
+		data, err := json.Marshal(original)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var decoded Settings
+		if err := json.Unmarshal(data, &decoded); err != nil {
+			t.Fatal(err)
+		}
+		if decoded.ReduceCommandOutput == nil || *decoded.ReduceCommandOutput != value {
+			t.Fatalf("round trip: %s", data)
+		}
+		cloned := cloneSettings(original)
+		*cloned.ReduceCommandOutput = !value
+		if *original.ReduceCommandOutput != value {
+			t.Fatal("clone aliases original")
+		}
+	}
+	global := Settings{ReduceCommandOutput: new(true)}
+	project := Settings{ReduceCommandOutput: new(false)}
+	merged := mergeSettings(global, project)
+	if merged.ReduceCommandOutput == nil || *merged.ReduceCommandOutput {
+		t.Fatal("project false did not override global true")
+	}
+	*merged.ReduceCommandOutput = true
+	if *project.ReduceCommandOutput {
+		t.Fatal("merge aliases project")
+	}
+	if got := mergeSettings(global, Settings{}); got.ReduceCommandOutput == nil || !*got.ReduceCommandOutput {
+		t.Fatal("absent project setting lost global value")
+	}
+	for _, text := range []string{`{"reduceCommandOutput":"true"}`, `{"reduceCommandOutput":1}`, `{"reduceCommandOutput":{}}`} {
+		var decoded Settings
+		if err := json.Unmarshal([]byte(text), &decoded); err == nil {
+			t.Fatalf("accepted %s", text)
+		}
+	}
+}
+
+func TestReducerSettingsSelectorPersistence(t *testing.T) {
+	sm := NewSettingsManager(t.TempDir(), t.TempDir())
+	var applied []string
+	sc := &SlashContext{SettingsManager: sm, OnSettingApplied: func(id, value string) { applied = append(applied, id+"="+value) }}
+	sc.ShowSettingsList = func(items []tui.SettingItem, change func(string, string) string) {
+		found := false
+		for _, item := range items {
+			if item.ID == "reduce-command-output" {
+				found = true
+				if item.Label != "Reduce command output" || item.CurrentValue != "false" {
+					t.Fatalf("row: %+v", item)
+				}
+			}
+		}
+		if !found {
+			t.Fatal("missing reducer setting")
+		}
+		for _, value := range []string{"true", "false"} {
+			if got := change("reduce-command-output", value); got != value {
+				t.Fatalf("toggle returned %q", got)
+			}
+			reloaded := NewSettingsManager(sm.CWD(), sm.AgentDir())
+			if got := reloaded.ExtensionSettings()["reduceCommandOutput"]; got != (value == "true") {
+				t.Fatalf("persisted setting: %v", got)
+			}
+		}
+	}
+	if err := settingsHandler(sc); err != nil {
+		t.Fatal(err)
+	}
+	if strings.Join(applied, ",") != "reduce-command-output=true,reduce-command-output=false" {
+		t.Fatalf("callbacks: %v", applied)
+	}
+	// Keep the host's existing in-memory-on-save-error semantics, but report
+	// the persistence failure and do not fire the successful-save callback.
+	if err := os.Remove(sm.GlobalPath()); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(sm.GlobalPath(), 0700); err != nil {
+		t.Fatal(err)
+	}
+	notified := false
+	sc.Append = func(text string) { notified = strings.Contains(text, "Failed to save settings") }
+	sc.ShowSettingsList = func(_ []tui.SettingItem, change func(string, string) string) {
+		if got := change("reduce-command-output", "true"); got != "true" {
+			t.Fatalf("row did not reflect the host's in-memory value: %s", got)
+		}
+	}
+	if err := settingsHandler(sc); err != nil {
+		t.Fatal(err)
+	}
+	if !notified || len(applied) != 2 {
+		t.Fatalf("failed save: notified=%v callbacks=%v", notified, applied)
+	}
+}
+
+func TestReducerSettingsModalToggle(t *testing.T) {
+	m, _ := newExtensionDialogProbe(t)
+	m.opts.SettingsManager = NewSettingsManager(t.TempDir(), t.TempDir())
+	done := make(chan error, 1)
+	go func() { done <- settingsHandler(m.buildSlashContext(t.Context())) }()
+	for _, key := range []string{"R", "e", "d", "u", "c", "e", "\r", "\x1b[C"} {
+		sendModalKey(t, m, key)
+	}
+	if got := m.opts.SettingsManager.ExtensionSettings()["reduceCommandOutput"]; got != true {
+		t.Fatalf("modal did not enable: %v", got)
+	}
+	for _, key := range []string{"\r", "\x1b[C", "\x1b"} {
+		sendModalKey(t, m, key)
+	}
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("settings did not close")
+	}
+	if got := NewSettingsManager(m.opts.SettingsManager.CWD(), m.opts.SettingsManager.AgentDir()).ExtensionSettings()["reduceCommandOutput"]; got != false {
+		t.Fatalf("modal did not persist off: %v", got)
+	}
+	data, err := os.ReadFile(filepath.Join(m.opts.SettingsManager.AgentDir(), "settings.json"))
+	if err != nil || !strings.Contains(string(data), `"reduceCommandOutput": false`) {
+		t.Fatalf("saved: %s %v", data, err)
+	}
+}
