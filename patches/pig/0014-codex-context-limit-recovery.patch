+package ai
+
+import "testing"
+
+func TestCodexContextLimitOverflow(t *testing.T) {
+	for _, text := range []string{"Context limit exceeded", "Codex error: context_limit_exceeded", "context_length_exceeded"} {
+		message := AssistantMessage{Provider: "openai-codex", StopReason: StopReasonError, ErrorMessage: text}
+		if !IsContextOverflow(message, 200000) {
+			t.Errorf("%q was not recognized as context overflow", text)
+		}
+	}
+	for _, text := range []string{"Usage limit exceeded", "Rate limit: context limit exceeded", "websocket: close 1000 (normal)"} {
+		message := AssistantMessage{Provider: "openai-codex", StopReason: StopReasonError, ErrorMessage: text}
+		if IsContextOverflow(message, 200000) {
+			t.Errorf("%q was incorrectly recognized as context overflow", text)
+		}
+	}
+}
