+package codingagent_test
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/MichaelKinsy/PiG/ai"
+)
+
+func TestInteractiveCodexContextLimitRecoversInRunningSession(t *testing.T) {
+	pair := newSessionPair(t, `{"compaction":{"keepRecentTokens":1},"retry":{"enabled":false}}`, 100000, nil,
+		replyError("Context limit exceeded"),
+		reply("compaction summary", ai.Usage{}),
+		reply("recovered answer", ai.Usage{Input: 10, Output: 10}),
+		reply("next answer", ai.Usage{Input: 10, Output: 10}),
+	)
+	pair.harness.Do(func() { pair.harness.Enter(strings.Repeat("x", 5000)) })
+	pair.harness.WaitIdle(t, 10*time.Second)
+	if got := len(pair.provider.requestLog()); got != 3 {
+		t.Fatalf("model requests = %d, want overflow, compaction, recovery", got)
+	}
+	if last := pair.session.LastAssistantText(); last == nil || *last != "recovered answer" {
+		t.Fatalf("last answer = %v", last)
+	}
+	var compactions, omissions int
+	for _, entry := range pair.session.Inner().Entries() {
+		switch entry.Base.Type {
+		case "compaction":
+			compactions++
+		case "context_edit":
+			omissions++
+		}
+	}
+	if compactions != 1 || omissions != 1 {
+		t.Fatalf("compactions=%d omissions=%d, want one durable recovery", compactions, omissions)
+	}
+	pair.harness.Do(func() { pair.harness.Enter("continue without restarting") })
+	pair.harness.WaitIdle(t, 10*time.Second)
+	if last := pair.session.LastAssistantText(); last == nil || *last != "next answer" {
+		t.Fatalf("session did not accept the next prompt: %v", last)
+	}
+}
