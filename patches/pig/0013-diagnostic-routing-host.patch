+func TestDiagnosticRoutingLateNoticeAfterSessionReplacement(t *testing.T) {
+	t.Setenv("PIG_HOME", t.TempDir())
+	build := func() (*coding.Services, *coding.Session) {
+		services, err := coding.NewServices(coding.ServicesOptions{CWD: t.TempDir(), AgentDir: t.TempDir()})
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(services.Close)
+		session, err := coding.NewSession(services, coding.SessionOptions{NoSession: true, SkipBuiltinTools: true})
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { _ = session.Close() })
+		return services, session
+	}
+	firstServices, first := build()
+	h := icodingagent.NewTestHarness(t, icodingagent.InteractiveOptions{
+		CWD: firstServices.CWD(), AgentDir: firstServices.AgentDir(), SessionHandle: first,
+		SettingsManager: firstServices.SettingsManager(), ModelRegistry: firstServices.Registry().ModelRegistry,
+	}, nil)
+	lateNotify := h.Notify
+	secondServices, second := build()
+	replacement := icodingagent.InteractiveReplacement{
+		CWD: secondServices.CWD(), SessionDir: second.Inner().GetSessionDir(), Settings: secondServices.SettingsManager().Get(),
+		SettingsManager: secondServices.SettingsManager(), ModelRegistry: secondServices.Registry().ModelRegistry,
+		SessionStartEvent: extension.SessionStartEvent{Type: "session_start", Reason: "new"},
+	}
+	if err := h.RebindToReplacement(t.Context(), second, replacement); err != nil {
+		t.Fatal(err)
+	}
+	h.Do(func() { h.Key("replacement draft"); lateNotify("late diagnostic from previous session") })
+	if h.EditorText() != "replacement draft" || !strings.Contains(h.Chat(), "late diagnostic from previous session") {
+		t.Fatalf("draft=%q chat=%s", h.EditorText(), h.Chat())
+	}
+}
