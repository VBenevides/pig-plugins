+// Distribution regression: UI-only notices and provider/retry errors must not
+// become draft text, move the cursor, or enter a later model request as input.
+func TestDiagnosticRoutingPreservesDraftAcrossRetries(t *testing.T) {
+	typed := false
+	pair := newSessionPair(t, `{"compaction":{"enabled":false},"retry":{"enabled":true,"maxRetries":1,"baseDelayMs":1,"maxAgentDelayMs":1}}`, 100000,
+		func(h *icodingagent.TestHarness, event agent.AgentEvent) {
+			if _, ok := event.(agent.AutoRetryStartEvent); ok && !typed {
+				typed = true
+				h.Key("draft marker")
+				h.Key("\x1b[D")
+				h.Key("\x1b[D")
+			}
+			if _, ok := event.(agent.MessageEndEvent); ok {
+				h.Notify("auto-models: native OAuth credentials unavailable or expired")
+			}
+		}, replyError("Claude HTTP 429 fixture-rate-limit"), replyError("Claude HTTP 429 fixture-rate-limit"), reply("received draft", ai.Usage{}))
+	pair.harness.Do(func() { pair.harness.Enter("initial request") })
+	pair.harness.WaitIdle(t, 10*time.Second)
+	if !typed || pair.harness.EditorText() != "draft marker" {
+		t.Fatalf("draft=%q typed=%v", pair.harness.EditorText(), typed)
+	}
+	chat := pair.harness.Chat()
+	if !strings.Contains(chat, "429") || !strings.Contains(chat, "Retry failed") || !strings.Contains(chat, "native OAuth credentials unavailable") {
+		t.Fatalf("diagnostics not visible in transcript: %s", chat)
+	}
+	pair.harness.Do(func() { pair.harness.Key("X"); pair.harness.Key("\r") })
+	pair.harness.WaitIdle(t, 10*time.Second)
+	requests := pair.provider.requestLog()
+	if len(requests) != 3 || !strings.Contains(requests[2], "draft markXer") || strings.Contains(requests[2], "native OAuth credentials") || strings.Contains(requests[2], "fixture-rate-limit") {
+		t.Fatalf("error injected or cursor moved: %v", requests)
+	}
+}
+
+func TestDiagnosticRoutingPreservesQueuedInputAfterCancellation(t *testing.T) {
+	pair := newSessionPair(t, `{"compaction":{"enabled":false},"retry":{"enabled":false}}`, 100000, nil,
+		func() *ai.AssistantMessage {
+			return &ai.AssistantMessage{Provider: "faux", Model: "faux-1", StopReason: ai.StopReasonAborted, ErrorMessage: "cancelled"}
+		})
+	pair.harness.Do(func() { pair.harness.Enter("cancelled request") })
+	pair.harness.WaitIdle(t, 10*time.Second)
+	pair.session.Agent().Steer(agent.AgentMessage{User: &agent.UserMessage{Role: "user", Content: ai.UserText("queued steering")}})
+	pair.session.Agent().FollowUp(agent.AgentMessage{User: &agent.UserMessage{Role: "user", Content: ai.UserText("queued follow-up")}})
+	pair.harness.Do(func() {
+		pair.harness.Key("new draft")
+		for range 100 {
+			pair.harness.Notify("late diagnostic after cancellation")
+		}
+	})
+	steering, followUp := pair.harness.QueuedMessages()
+	if pair.harness.EditorText() != "new draft" || steering != 1 || followUp != 1 || len(pair.provider.requestLog()) != 1 {
+		t.Fatalf("draft=%q steering=%d follow-up=%d requests=%v", pair.harness.EditorText(), steering, followUp, pair.provider.requestLog())
+	}
+}
