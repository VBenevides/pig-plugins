+package cli
+
+import (
+	"encoding/json"
+	"path/filepath"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/ai"
+	"github.com/MichaelKinsy/PiG/coding"
+)
+
+func TestStartupModelUsesRemoteCatalogBeforeProviderFallback(t *testing.T) {
+	t.Setenv("PIG_HOME", t.TempDir())
+	agentDir := t.TempDir()
+	const modelID = "gpt-future-startup-fixture"
+	record := json.RawMessage(`{"id":"gpt-future-startup-fixture","name":"Current catalog name","api":"openai-codex-responses","provider":"openai-codex","baseUrl":"https://chatgpt.com/backend-api","reasoning":true,"input":["text"],"cost":{"input":3,"output":9,"cacheRead":0.3,"cacheWrite":0},"contextWindow":500000,"maxTokens":64000,"thinkingLevelMap":{"medium":"medium","high":"high"}}`)
+	models, err := ai.DecodeStoredModels([]json.RawMessage{record})
+	if err != nil {
+		t.Fatal(err)
+	}
+	generatedAt := ai.GetBuiltinModelDataGeneratedAt()
+	if generatedAt == nil {
+		t.Fatal("missing catalog generation timestamp")
+	}
+	storeEntry := ai.ModelsStoreEntry{Models: models, CheckedAt: new(float64(1)), LastModified: new(*generatedAt + 1)}
+	if err := ai.NewFileModelsStore(filepath.Join(agentDir, "models-store.json")).Write(t.Context(), "openai-codex", storeEntry); err != nil {
+		t.Fatal(err)
+	}
+	services, err := coding.CreateAgentSessionServices(coding.CreateAgentSessionServicesOptions{CWD: t.TempDir(), AgentDir: agentDir})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer services.Close()
+	result := services.ModelRuntime().Refresh(t.Context(), ai.ModelsRefreshOptions{Providers: []string{"openai-codex"}, AllowNetwork: new(false)})
+	if len(result.Errors) != 0 {
+		t.Fatalf("restore catalog: %v", result.Errors)
+	}
+	entry := resolveStartupModelEntry("openai-codex", modelID, services.Registry().ModelRegistry)
+	if entry.DisplayName != "Current catalog name" || !entry.Reasoning || entry.ContextWindow != 500000 || entry.MaxTokens != 64000 {
+		t.Fatalf("startup used fallback metadata: name=%q reasoning=%v context=%d maxTokens=%d", entry.DisplayName, entry.Reasoning, entry.ContextWindow, entry.MaxTokens)
+	}
+}
