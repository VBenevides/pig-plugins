@@ -0,0 +1,84 @@
+package coding
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"reflect"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/ai"
+)
+
+// Model switching must use the same composed catalog as the selector and runtime,
+// including models added or changed after the binary's catalog was generated.
+func TestBuildModelUsesCurrentCatalogMetadata(t *testing.T) {
+	t.Setenv("PIG_HOME", t.TempDir())
+	for _, tc := range []struct {
+		name      string
+		modelID   string
+		reasoning bool
+	}{
+		{"new model", "gpt-future-catalog-fixture", true},
+		{"updated model", "gpt-5.3-codex", true},
+		{"reasoning removed", "gpt-5.3-codex", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			modelID := tc.modelID
+			agentDir := t.TempDir()
+			config := `{"providers":{"openai-codex":{"headers":{"X-Catalog-Fixture":"preserved"},"modelOverrides":{"` + modelID + `":{"maxTokens":32000}}}}}`
+			if err := os.WriteFile(filepath.Join(agentDir, "models.json"), []byte(config), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			record := json.RawMessage(`{"id":"` + modelID + `","name":"Updated reasoning model","api":"openai-codex-responses","provider":"openai-codex","baseUrl":"https://chatgpt.com/backend-api","reasoning":true,"input":["text","image"],"cost":{"input":3,"output":9,"cacheRead":0.3,"cacheWrite":0},"contextWindow":500000,"maxTokens":64000,"thinkingLevelMap":{"off":null,"low":"low","medium":"medium","high":"high"},"compat":{"supportsAdditionalTools":true},"inputLimits":{"images":{"maxPerRequest":42}}}`)
+			if !tc.reasoning {
+				record = json.RawMessage(strings.ReplaceAll(strings.ReplaceAll(string(record), `"reasoning":true`, `"reasoning":false`), `"thinkingLevelMap":{"off":null,"low":"low","medium":"medium","high":"high"}`, `"thinkingLevelMap":{"off":null}`))
+			}
+			generatedAt := ai.GetBuiltinModelDataGeneratedAt()
+			if generatedAt == nil {
+				t.Fatal("missing catalog generation timestamp")
+			}
+			entry := ai.ModelsStoreEntry{Models: mustStoredModels([]json.RawMessage{record}), CheckedAt: new(float64(1)), LastModified: new(*generatedAt + 1)}
+			if err := ai.NewFileModelsStore(filepath.Join(agentDir, "models-store.json")).Write(t.Context(), "openai-codex", entry); err != nil {
+				t.Fatal(err)
+			}
+			services, err := CreateAgentSessionServices(CreateAgentSessionServicesOptions{CWD: t.TempDir(), AgentDir: agentDir})
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(services.Close)
+			result := services.ModelRuntime().Refresh(t.Context(), ai.ModelsRefreshOptions{Providers: []string{"openai-codex"}, AllowNetwork: new(false)})
+			if len(result.Errors) != 0 {
+				t.Fatalf("restore catalog: %v", result.Errors)
+			}
+			expected := services.ModelRuntime().GetModel("openai-codex", modelID)
+			if expected == nil || expected.ProviderMeta.Reasoning != tc.reasoning || expected.Capabilities.ContextWindow != 500000 || expected.Capabilities.MaxOutputTokens != 32000 {
+				t.Fatal("cached catalog fixture was not restored")
+			}
+			resolved, ok := services.Registry().Resolve("openai-codex", modelID)
+			if !ok || resolved.Headers["X-Catalog-Fixture"] != "preserved" || resolved.MaxTokens != 32000 || resolved.Reasoning != tc.reasoning {
+				t.Fatal("catalog resolution lost provider headers, overrides, or reasoning metadata")
+			}
+			actual, err := BuildModel("openai-codex/"+modelID, services)
+			if err != nil {
+				t.Fatal(err)
+			}
+			// Catalog records carry input capabilities in Input; BuildModel also
+			// computes the provider-facing image and tool-use capability flags.
+			expectedCapabilities := expected.Capabilities
+			expectedCapabilities.SupportsImages = true
+			expectedCapabilities.SupportsToolUse = true
+			if !reflect.DeepEqual(actual.ProviderMeta, expected.ProviderMeta) || !reflect.DeepEqual(actual.Capabilities, expectedCapabilities) || !reflect.DeepEqual(actual.ThinkingLevelMap, expected.ThinkingLevelMap) || !reflect.DeepEqual(actual.InputLimits, expected.InputLimits) || !slices.Equal(actual.Input, expected.Input) || actual.DisplayName != expected.DisplayName {
+				t.Errorf("builder lost catalog metadata: reasoning=%v maxThinking=%q context=%d name=%q; want reasoning=%v maxThinking=%q context=%d name=%q", actual.ProviderMeta.Reasoning, actual.Capabilities.MaxThinking, actual.Capabilities.ContextWindow, actual.DisplayName, expected.ProviderMeta.Reasoning, expected.Capabilities.MaxThinking, expected.Capabilities.ContextWindow, expected.DisplayName)
+			}
+			if slices.Contains(ai.GetSupportedThinkingLevels(actual), ai.ModelThinkingLevel("medium")) != tc.reasoning {
+				t.Error("built model thinking levels do not match the current reasoning capability")
+			}
+			if actual.Provider == nil || actual.Provider.ID() != "openai-codex" {
+				t.Error("built model lost provider binding")
+			}
+		})
+	}
+}
