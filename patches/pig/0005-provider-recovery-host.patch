diff --git a/coding/session_summary_backpressure_test.go b/coding/session_summary_backpressure_test.go
new file mode 100644
index 0000000..e5d5e10
--- /dev/null
+++ b/coding/session_summary_backpressure_test.go
@@ -0,0 +1,90 @@
+package coding
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/MichaelKinsy/PiG/ai"
+	"github.com/MichaelKinsy/PiG/internal/codingagent/compaction"
+)
+
+func TestSummaryCompleterDrainsBackpressuredStream(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		message   ai.AssistantMessage
+		wantError string
+	}{
+		{"summary", ai.AssistantMessage{Content: []ai.AssistantContentBlock{ai.TextContent{Text: "durable summary"}}, StopReason: ai.StopReasonStop, Usage: ai.Usage{Input: 12, Output: 3}}, ""},
+		{"provider error", ai.AssistantMessage{StopReason: ai.StopReasonError, ErrorMessage: "summary provider unavailable"}, "summary provider unavailable"},
+		{"token cap", ai.AssistantMessage{StopReason: ai.StopReasonLength}, "generation hit the token cap"},
+		{"tool call", ai.AssistantMessage{Content: []ai.AssistantContentBlock{ai.ToolCall{ID: "call", Name: "read"}}, StopReason: ai.StopReasonToolUse}, "attempted to call a tool"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(t.Context(), time.Second)
+			defer cancel()
+			finished := make(chan struct{})
+			completer := compaction.ProviderCompleter{StreamFn: func(ctx context.Context, _ *ai.Model, _ ai.TranscriptContext, _ ai.StreamOptions) (*ai.AssistantMessageEventStream, error) {
+				stream := ai.NewAssistantMessageEventStream()
+				go func() {
+					defer close(finished)
+					defer stream.End(&tc.message)
+					for _, event := range []ai.AssistantMessageEvent{
+						ai.StartEvent{Partial: &tc.message},
+						ai.TextDeltaEvent{ContentIndex: 0, Delta: "durable summary", Partial: &tc.message},
+						ai.DoneEvent{Reason: tc.message.StopReason, Message: &tc.message},
+					} {
+						if err := stream.PushWithBackpressure(ctx, event); err != nil {
+							return
+						}
+					}
+				}()
+				return stream, nil
+			}}
+			text, usage, err := completer.CompleteSimple(ctx, &ai.Model{}, "", nil, ai.StreamOptions{})
+			cancel()
+			select {
+			case <-finished:
+			case <-time.After(time.Second):
+				t.Fatal("summary producer did not exit")
+			}
+			if tc.wantError != "" {
+				if err == nil || !strings.Contains(err.Error(), tc.wantError) {
+					t.Fatalf("summary error = %v, want %q", err, tc.wantError)
+				}
+				return
+			}
+			if err != nil || text != "durable summary" || usage == nil || *usage != tc.message.Usage {
+				t.Fatalf("summary = %q, usage = %+v, error = %v", text, usage, err)
+			}
+		})
+	}
+}
+
+func TestSummaryCompleterCancellationWithoutTerminalResult(t *testing.T) {
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	stream := ai.NewAssistantMessageEventStream()
+	stream.End()
+	completer := compaction.ProviderCompleter{StreamFn: func(context.Context, *ai.Model, ai.TranscriptContext, ai.StreamOptions) (*ai.AssistantMessageEventStream, error) {
+		cancel()
+		return stream, nil
+	}}
+	finished := make(chan error, 1)
+	go func() {
+		_, _, err := completer.CompleteSimple(ctx, &ai.Model{}, "", nil, ai.StreamOptions{})
+		finished <- err
+	}()
+	select {
+	case err := <-finished:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("summary cancellation = %v", err)
+		}
+	case <-time.After(time.Second):
+		stream.End(&ai.AssistantMessage{StopReason: ai.StopReasonAborted})
+		<-finished
+		t.Fatal("summary completer ignored cancellation while waiting for a terminal result")
+	}
+}
