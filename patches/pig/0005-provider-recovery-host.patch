new file mode 100644
index 0000000..cb9ce23
--- /dev/null
+++ b/ai/event_stream_backpressure.go
@@ -0,0 +1,35 @@
+package ai
+
+import "context"
+
+// PushWithBackpressure is for a serialized external producer, not a provider
+// running under the continuation executor. It leaves at most one unread event
+// queued. Do not mix with concurrent Push calls; bound event sizes at ingress.
+func (s *AssistantMessageEventStream) PushWithBackpressure(ctx context.Context, event AssistantMessageEvent) error {
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		s.mu.Lock()
+		if s.terminal {
+			s.mu.Unlock()
+			return nil
+		}
+		if len(s.queue) == 0 {
+			s.mu.Unlock()
+			return s.Push(event)
+		}
+		if s.drained == nil {
+			s.drained = make(chan struct{})
+		}
+		drained, done := s.drained, s.done
+		s.mu.Unlock()
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-done:
+			return nil
+		case <-drained:
+		}
+	}
+}
