+package coding
+
+import (
+	"github.com/MichaelKinsy/PiG/agent"
+	"github.com/MichaelKinsy/PiG/ai"
+	"github.com/MichaelKinsy/PiG/coding/extension"
+	"github.com/MichaelKinsy/PiG/internal/codingagent/compaction"
+	"testing"
+)
+
+func TestGenerationReplaySessionPolicy(t *testing.T) {
+	for _, tc := range []struct {
+		name, provider, text string
+		veto                 bool
+		calls                int
+	}{
+		{"legacy Cursor", "cursor", "RPC rejected (HTTP 503)", false, 1},
+		{"typed request", "synthetic", "RPC rejected (HTTP 503)", true, 1},
+		{"overflow cannot bypass veto", "synthetic", "HTTP 503 maximum context length exceeded", true, 1},
+		{"unrelated provider retries", "synthetic", "RPC rejected (HTTP 503)", false, 2},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			failure := func([]ai.Message) *ai.AssistantMessage {
+				return &ai.AssistantMessage{Provider: tc.provider, Model: "synthetic", ReplayProhibited: tc.veto, StopReason: ai.StopReasonError, ErrorMessage: tc.text, Content: []ai.AssistantContentBlock{ai.TextContent{Text: "partial answer"}}}
+			}
+			h := newRetryEventsHarness(t, `{"retry":{"enabled":true,"maxRetries":1,"baseDelayMs":1}}`, extension.Extension{}, nil, failure, fauxReply("retried", ai.StopReasonStop, 0))
+			// The suite's faux delta adapter overwrites provider identity and does not
+			// carry private response metadata. Use the actual scripted error here.
+			h.provider.streamDeltas = false
+			if err := h.session.Prompt(t.Context(), "replay policy", nil); err != nil {
+				t.Fatal(err)
+			}
+			if got := h.provider.callCount(); got != tc.calls {
+				t.Fatalf("calls=%d want %d", got, tc.calls)
+			}
+			if tc.calls == 1 {
+				messages := h.session.Messages()
+				last := messages[len(messages)-1].Assistant
+				if last == nil || last.ErrorMessage != tc.text || last.Provider != tc.provider {
+					t.Fatalf("lost failed response: %+v", last)
+				}
+			}
+		})
+	}
+}
+
+func TestGenerationReplayDoesNotRepeatCompletedTools(t *testing.T) {
+	tool := &retryEchoTool{}
+	failure := func([]ai.Message) *ai.AssistantMessage {
+		return &ai.AssistantMessage{Provider: "synthetic", ReplayProhibited: true, StopReason: ai.StopReasonError, ErrorMessage: "HTTP 503"}
+	}
+	h := newRetryEventsHarness(t, retryEventsSettings, extension.Extension{}, []agent.AgentTool{tool}, fauxToolCallOnly("echo", ai.JsonObject{"text": "one effect"}), failure, fauxToolCallOnly("echo", ai.JsonObject{"text": "duplicate effect"}))
+	h.provider.streamDeltas = false
+	if err := h.session.Prompt(t.Context(), "one tool", nil); err != nil {
+		t.Fatal(err)
+	}
+	if h.provider.callCount() != 2 || len(tool.ran()) != 1 {
+		t.Fatalf("calls=%d tool runs=%v", h.provider.callCount(), tool.ran())
+	}
+}
+
+func TestGenerationReplaySummaryCompleterPreservesVeto(t *testing.T) {
+	provider := &scriptedProvider{responses: []scriptedResponse{func([]ai.Message) *ai.AssistantMessage {
+		return &ai.AssistantMessage{ReplayProhibited: true, StopReason: ai.StopReasonError, ErrorMessage: "HTTP 503"}
+	}}}
+	_, _, err := (compaction.ProviderCompleter{}).CompleteSimple(t.Context(), fakeModelWithProvider(provider), "summary", nil, ai.StreamOptions{})
+	if !ai.IsGenerationReplayProhibited(err) || err.Error() != "HTTP 503" || provider.callCount() != 1 {
+		t.Fatalf("calls=%d err=%v", provider.callCount(), err)
+	}
+}
