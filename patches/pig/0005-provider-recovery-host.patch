@@ -0,0 +1,44 @@
+package ai
+
+// GenerationReplayProhibited reports a request's veto on automatic generation
+// replay. A veto is independent of status text and cannot grant retry permission.
+func (message AssistantMessage) GenerationReplayProhibited() bool {
+	// Cursor's existing contract also applies to legacy responses written before
+	// replayProhibited was carried over the native provider bridge.
+	return message.ReplayProhibited || message.Provider == "cursor"
+}
+
+// AssistantCallError retains response policy when a message becomes an error,
+// for example at the summarization boundary. Wrapping with %w preserves it.
+type AssistantCallError struct {
+	Message AssistantMessage
+}
+
+func (err *AssistantCallError) Error() string {
+	if err.Message.ErrorMessage == "" {
+		return "Unknown error"
+	}
+	return err.Message.ErrorMessage
+}
+
+func (err *AssistantCallError) GenerationReplayProhibited() bool {
+	return err.Message.GenerationReplayProhibited()
+}
+
+// IsGenerationReplayProhibited recognizes a veto through wrapped errors.
+func IsGenerationReplayProhibited(err error) bool {
+	if policy, ok := err.(interface{ GenerationReplayProhibited() bool }); ok && policy.GenerationReplayProhibited() {
+		return true
+	}
+	switch wrapped := err.(type) {
+	case interface{ Unwrap() []error }:
+		for _, cause := range wrapped.Unwrap() {
+			if IsGenerationReplayProhibited(cause) {
+				return true
+			}
+		}
+	case interface{ Unwrap() error }:
+		return IsGenerationReplayProhibited(wrapped.Unwrap())
+	}
+	return false
+}
