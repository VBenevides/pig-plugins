+// WaitForRegistrationRefresh is a startup barrier before a network catalog pass.
+// Unlike a normal runtime yield, it also waits for already launched local passes.
+// Never call it from a provider callback: the callback can belong to that pass.
+func (r *ModelRegistry) WaitForRegistrationRefresh(ctx context.Context) error {
+	r.YieldToRegistrationRefresh(ctx)
+	state := &r.registrationRefresh
+	for {
+		state.mu.Lock()
+		var pending chan struct{}
+		for done := range state.running {
+			pending = done
+			break
+		}
+		state.mu.Unlock()
+		if pending == nil {
+			return ctx.Err()
+		}
+		select {
+		case <-pending:
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}
+}
