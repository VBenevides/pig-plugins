@@ -0,0 +1,51 @@
+package codingagent
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestStartupRegistrationBarrierWaitsForLaunchedPass(t *testing.T) {
+	registry := NewModelRegistry(t.TempDir())
+	t.Cleanup(registry.CloseModelTasks)
+	// Simulate a launched local registration pass whose goroutine has not yet
+	// reached the provider. A normal yield finds nothing queued and returns.
+	done := make(chan struct{})
+	registry.registrationRefresh.running = map[chan struct{}]struct{}{done: {}}
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	finished := make(chan error, 1)
+	go func() { finished <- registry.WaitForRegistrationRefresh(ctx) }()
+	select {
+	case err := <-finished:
+		t.Fatalf("barrier skipped active registration: %v", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+	registry.registrationRefresh.mu.Lock()
+	delete(registry.registrationRefresh.running, done)
+	close(done)
+	registry.registrationRefresh.mu.Unlock()
+	select {
+	case err := <-finished:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("barrier did not settle")
+	}
+}
+
+func TestStartupRegistrationBarrierHonorsCancellation(t *testing.T) {
+	registry := NewModelRegistry(t.TempDir())
+	t.Cleanup(registry.CloseModelTasks)
+	done := make(chan struct{})
+	defer close(done)
+	registry.registrationRefresh.running = map[chan struct{}]struct{}{done: {}}
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	if err := registry.WaitForRegistrationRefresh(ctx); !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled barrier: %v", err)
+	}
+}
