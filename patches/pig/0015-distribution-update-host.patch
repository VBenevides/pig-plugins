diff --git a/cmd/pig/plugins_distribution.go b/cmd/pig/plugins_distribution.go
new file mode 100644
--- /dev/null
+++ b/cmd/pig/plugins_distribution.go
@@ -0,0 +1,31 @@
+package main
+
+import (
+	"fmt"
+	"os"
+
+	"github.com/VBenevides/pig-plugins/distribution"
+)
+
+func init() {
+	if err := distribution.Prepare(Version); err != nil {
+		fmt.Fprintln(os.Stderr, "pig-plugins:", err)
+		os.Exit(1)
+	}
+	if len(os.Args) > 1 && os.Args[1] == "--update" {
+		if len(os.Args) != 2 {
+			fmt.Fprintln(os.Stderr, "usage: pig-plugins --update")
+			os.Exit(2)
+		}
+		os.Exit(runSelfUpdate(false))
+	}
+}
+
+// Every self-update route rebuilds the distribution, never a stock PiG binary.
+func runSelfUpdate(_ bool) int {
+	if err := distribution.Update(); err != nil {
+		fmt.Fprintln(os.Stderr, "pig-plugins:", err)
+		return 1
+	}
+	return 0
+}
