+++ b/coding/extension/host/subprocess/image_preview_test.go
@@ -0,0 +1,76 @@
+package subprocess
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"image"
+	"image/png"
+	"strings"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/tui"
+)
+
+func TestNativePreviewGraphicsAndFallback(t *testing.T) {
+	previous := tui.GetCapabilities()
+	defer tui.SetCapabilities(previous)
+	var buf bytes.Buffer
+	if err := png.Encode(&buf, image.NewNRGBA(image.Rect(0, 0, 432, 240))); err != nil {
+		t.Fatal(err)
+	}
+	args, err := json.Marshal(map[string]any{"data": base64.StdEncoding.EncodeToString(buf.Bytes()), "width": 36, "height": 10})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, protocol := range []tui.ImageProtocol{"", tui.ImageProtocolKitty, tui.ImageProtocolITerm2} {
+		tui.SetCapabilities(tui.TerminalCapabilities{Images: protocol})
+		result, err := (&UIBridge{}).handleRenderImage(args)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var value struct {
+			Frame struct {
+				Lines     []string
+				Supported bool
+			}
+		}
+		if err := json.Unmarshal(result.Result, &value); err != nil {
+			t.Fatal(err)
+		}
+		if value.Frame.Supported != (protocol != "") {
+			t.Fatalf("protocol %q: %+v", protocol, value)
+		}
+		if protocol != "" && (len(value.Frame.Lines) == 0 || !strings.Contains(strings.Join(value.Frame.Lines, ""), "\x1b")) {
+			t.Fatalf("missing graphics for %q", protocol)
+		}
+	}
+	if _, err := (&UIBridge{}).handleRenderImage(json.RawMessage(`{"data":"invalid","width":36,"height":10}`)); err == nil {
+		t.Fatal("invalid PNG accepted")
+	}
+}
+
+func TestPreviewWidgetKeepsAllRowsAndRejectsStaleWidth(t *testing.T) {
+	bridge := newTestBridge(&mockUIContext{})
+	lines := make([]string, 44)
+	for i := range lines {
+		lines[i] = "preview"
+	}
+	args, err := json.Marshal(map[string]any{"key": "gallery", "lines": lines, "width": 80})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := bridge.handleSetPreviewWidget("images", args); err != nil {
+		t.Fatal(err)
+	}
+	proxy := bridge.widgets["gallery"]
+	if proxy == nil || bridge.widgetOwners["gallery"] != "images" {
+		t.Fatal("missing gallery widget")
+	}
+	if got := proxy.Render(80); len(got) != len(lines) {
+		t.Fatalf("gallery truncated: %d rows", len(got))
+	}
+	if got := proxy.Render(40); len(got) != 0 {
+		t.Fatalf("stale frame painted: %v", got)
+	}
+}
