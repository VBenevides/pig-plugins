diff --git a/internal/codingagent/ext_ui_conditional_editor.go b/internal/codingagent/ext_ui_conditional_editor.go
new file mode 100644
index 0000000..e60d91e
--- /dev/null
+++ b/internal/codingagent/ext_ui_conditional_editor.go
@@ -0,0 +1,62 @@
+package codingagent
+
+import (
+	"context"
+	"sync"
+	"time"
+)
+
+// CompareAndSetEditorText applies a background draft transform only if typing or
+// submission has not changed the expanded text. All editor access stays on its owner.
+func (u *ExtUIContext) CompareAndSetEditorText(ctx context.Context, expected, text string) (bool, error) {
+	// Bound cleanup even if the owner loop is shutting down or in a modal phase.
+	ctx, cancel := context.WithTimeout(ctx, time.Second)
+	defer cancel()
+	apply := func() bool {
+		if ctx.Err() != nil || u.m.editor == nil || u.m.editor.GetExpandedText() != expected {
+			return false
+		}
+		u.m.editor.SetText(text)
+		if u.m.tuiInst != nil {
+			u.m.requestRender()
+		}
+		return true
+	}
+	if err := ctx.Err(); err != nil {
+		return false, err
+	}
+	if u.m.runCtx == nil {
+		return apply(), nil
+	}
+	var mu sync.Mutex
+	applied, cancelled := false, false
+	result := make(chan struct{}, 1)
+	if err := u.m.postToMain(ctx, func() {
+		mu.Lock()
+		if !cancelled {
+			applied = apply()
+		}
+		mu.Unlock()
+		result <- struct{}{}
+	}); err != nil {
+		return false, err
+	}
+	var err error
+	select {
+	case <-result:
+	case <-ctx.Done():
+		err = ctx.Err()
+	case <-u.m.runCtx.Done():
+		err = context.Cause(u.m.runCtx)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	cancelled = true
+	if applied {
+		return true, nil
+	}
+	if err == nil {
+		err = ctx.Err()
+	}
+	return false, err
+}
diff --git a/internal/codingagent/ext_ui_conditional_editor_test.go b/internal/codingagent/ext_ui_conditional_editor_test.go
new file mode 100644
index 0000000..ac55e34
--- /dev/null
+++ b/internal/codingagent/ext_ui_conditional_editor_test.go
@@ -0,0 +1,78 @@
+package codingagent
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/tui"
+)
+
+func TestConditionalEditorReplacementRunsOnOwner(t *testing.T) {
+	for _, currText := range []string{"/tmp/paste.png", "new typing", ""} {
+		t.Run(currText, func(t *testing.T) {
+			m := &InteractiveMode{editor: tui.NewEditor(), runCtx: t.Context(), uiTaskCh: make(chan func(), 1)}
+			m.editor.SetText("/tmp/paste.png")
+			ui := &ExtUIContext{m: m}
+			type result struct {
+				applied bool
+				err     error
+			}
+			done := make(chan result, 1)
+			go func() {
+				applied, err := ui.CompareAndSetEditorText(t.Context(), "/tmp/paste.png", "[Image #1]")
+				done <- result{applied, err}
+			}()
+			task := <-m.uiTaskCh
+			// Typing or submission can win before the owner accepts the transform.
+			m.editor.SetText(currText)
+			task()
+			got := <-done
+			wantApplied := currText == "/tmp/paste.png"
+			if got.err != nil || got.applied != wantApplied {
+				t.Fatalf("result=%+v", got)
+			}
+			want := currText
+			if wantApplied {
+				want = "[Image #1]"
+			}
+			if text := m.editor.GetExpandedText(); text != want {
+				t.Fatalf("text=%q want=%q", text, want)
+			}
+		})
+	}
+}
+
+func TestConditionalEditorReplacementCancellation(t *testing.T) {
+	m := &InteractiveMode{editor: tui.NewEditor(), runCtx: t.Context(), uiTaskCh: make(chan func(), 1)}
+	m.editor.SetText("/tmp/paste.png")
+	ctx, cancel := context.WithCancel(t.Context())
+	done := make(chan error, 1)
+	go func() {
+		_, err := (&ExtUIContext{m: m}).CompareAndSetEditorText(ctx, "/tmp/paste.png", "[Image #1]")
+		done <- err
+	}()
+	task := <-m.uiTaskCh
+	cancel()
+	task()
+	if err := <-done; err == nil {
+		t.Fatal("cancelled transform succeeded")
+	}
+	if text := m.editor.Text(); text != "/tmp/paste.png" {
+		t.Fatalf("cancelled transform changed draft: %q", text)
+	}
+}
+
+func TestConditionalEditorReplacementTimeoutRejectsLateTask(t *testing.T) {
+	m := &InteractiveMode{editor: tui.NewEditor(), runCtx: t.Context(), uiTaskCh: make(chan func(), 1)}
+	m.editor.SetText("/tmp/paste.png")
+	applied, err := (&ExtUIContext{m: m}).CompareAndSetEditorText(t.Context(), "/tmp/paste.png", "[Image #1]")
+	if applied || !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("applied=%v err=%v", applied, err)
+	}
+	// A queued task must not change the draft after its caller has abandoned it.
+	(<-m.uiTaskCh)()
+	if text := m.editor.Text(); text != "/tmp/paste.png" {
+		t.Fatalf("late task changed draft: %q", text)
+	}
+}
