@@ -0,0 +1,38 @@
+package subprocess
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+
+	"github.com/MichaelKinsy/PiG/coding/extension"
+)
+
+// Optional additive capability: compare and replacement must share the editor owner loop.
+type conditionalEditorUI interface {
+	CompareAndSetEditorText(context.Context, string, string) (bool, error)
+}
+
+func (b *UIBridge) handleCompareAndSetEditorText(ctx context.Context, ui extension.UIContext, args json.RawMessage) (*CallResultPayload, error) {
+	var p struct {
+		Expected string `json:"expected"`
+		Text     string `json:"text"`
+	}
+	if err := json.Unmarshal(args, &p); err != nil {
+		return nil, fmt.Errorf("parse compareAndSetEditorText args: %w", err)
+	}
+	applied := false
+	if ui != extension.NoopUIContext {
+		conditional, ok := ui.(conditionalEditorUI)
+		if !ok {
+			return nil, fmt.Errorf("UI does not support atomic editor replacement")
+		}
+		var err error
+		applied, err = conditional.CompareAndSetEditorText(ctx, p.Expected, p.Text)
+		if err != nil {
+			return nil, fmt.Errorf("replace unchanged editor text: %w", err)
+		}
+	}
+	result, err := json.Marshal(map[string]bool{"applied": applied})
+	return &CallResultPayload{Result: result}, err
+}
diff --git a/coding/extension/host/subprocess/conditional_editor_test.go b/coding/extension/host/subprocess/conditional_editor_test.go
new file mode 100644
index 0000000..3c8be71
--- /dev/null
+++ b/coding/extension/host/subprocess/conditional_editor_test.go
@@ -0,0 +1,51 @@
+package subprocess
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+)
+
+type conditionalEditorMock struct{ mockUIContext }
+
+func (u *conditionalEditorMock) CompareAndSetEditorText(_ context.Context, expected, text string) (bool, error) {
+	if u.editorText != expected {
+		return false, nil
+	}
+	u.editorText = text
+	return true, nil
+}
+
+func TestUIBridgeConditionalEditorReplacement(t *testing.T) {
+	ui := &conditionalEditorMock{mockUIContext: mockUIContext{editorText: "path"}}
+	bridge := newTestBridge(ui)
+	for _, want := range []bool{true, false} {
+		result, err := call(bridge, "ui.compareAndSetEditorText", `{"expected":"path","text":"marker"}`)
+		if err != nil || result.Error != nil {
+			t.Fatalf("result=%+v err=%v", result, err)
+		}
+		var out struct {
+			Applied bool `json:"applied"`
+		}
+		if err := json.Unmarshal(result.Result, &out); err != nil {
+			t.Fatal(err)
+		}
+		if out.Applied != want {
+			t.Fatalf("applied=%v want=%v", out.Applied, want)
+		}
+	}
+	if ui.editorText != "marker" {
+		t.Fatal(ui.editorText)
+	}
+}
+
+func TestUIBridgeConditionalEditorWithoutCapability(t *testing.T) {
+	ui := &mockUIContext{editorText: "new typing"}
+	_, err := call(newTestBridge(ui), "ui.compareAndSetEditorText", `{"expected":"path","text":"marker"}`)
+	if err == nil {
+		t.Fatal("unsupported UI silently accepted a transform")
+	}
+	if ui.editorText != "new typing" {
+		t.Fatal("unsupported UI changed editor")
+	}
+}
