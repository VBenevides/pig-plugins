@@ -0,0 +1,53 @@
+package subprocess
+
+import (
+	"encoding/json"
+	"fmt"
+
+	"github.com/MichaelKinsy/PiG/tui"
+)
+
+// Render through the host's configured image protocol and cell geometry, not
+// subprocess environment detection. Returned rows use the normal widget cache
+// and TUI image placement/cropping lifecycle.
+func (b *UIBridge) handleRenderImage(args json.RawMessage) (*CallResultPayload, error) {
+	var p struct {
+		Data   string `json:"data"`
+		Width  int    `json:"width"`
+		Height int    `json:"height"`
+	}
+	if err := json.Unmarshal(args, &p); err != nil {
+		return nil, fmt.Errorf("parse renderImage args: %w", err)
+	}
+	if len(p.Data) > 8<<20 || p.Width < 1 || p.Width > 240 || p.Height < 1 || p.Height > 40 {
+		return nil, fmt.Errorf("renderImage exceeds preview bounds")
+	}
+	dimensions := tui.GetPNGDimensions(p.Data)
+	if dimensions == nil || dimensions.WidthPx <= 0 || dimensions.HeightPx <= 0 || dimensions.WidthPx > 24000000/dimensions.HeightPx {
+		return nil, fmt.Errorf("renderImage requires a bounded PNG")
+	}
+	supported := tui.GetCapabilities().Images != ""
+	var lines []string
+	if supported {
+		preview := tui.NewImage(p.Data, "image/png", tui.DefaultImageTheme(), tui.ImageOptions{MaxWidthCells: p.Width, MaxHeightCells: p.Height}, dimensions)
+		lines = preview.Render(p.Width + 2)
+	}
+	result, err := json.Marshal(map[string]any{"frame": map[string]any{"lines": lines, "supported": supported}})
+	return &CallResultPayload{Result: result}, err
+}
+
+func (b *UIBridge) handleSetPreviewWidget(extName string, args json.RawMessage) (*CallResultPayload, error) {
+	var p struct {
+		Key   string   `json:"key"`
+		Lines []string `json:"lines"`
+		Width int      `json:"width"`
+	}
+	if err := json.Unmarshal(args, &p); err != nil {
+		return nil, fmt.Errorf("parse setPreviewWidget args: %w", err)
+	}
+	if len(args) > 24<<20 || len(p.Lines) > 200 || p.Width < 1 || p.Width > 10000 || p.Key == "" {
+		return nil, fmt.Errorf("setPreviewWidget exceeds preview bounds")
+	}
+	b.updateWidget(extName, p.Key, p.Lines, p.Width, "aboveEditor")
+	return &CallResultPayload{}, nil
+}
diff --git a/coding/extension/host/subprocess/image_preview_test.go b/coding/extension/host/subprocess/image_preview_test.go
