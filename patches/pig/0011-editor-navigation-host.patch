+package codingagent
+
+import (
+	"context"
+	"testing"
+)
+
+func TestTmuxDraftNavigationThroughInteractiveDispatch(t *testing.T) {
+	t.Setenv("TMUX", "test")
+	for _, tc := range []struct {
+		name string
+		keys []string
+		want string
+	}{
+		{"word delete", []string{"first second", "\x17"}, "first "},
+		{"page up", []string{"first\nlast", "\x1b[5~", "START"}, "STARTfirst\nlast"},
+		{"page down", []string{"first\nlast", "\x1b[5~", "\x1b[6~", "END"}, "first\nlastEND"},
+		{"arrows", []string{"new draft", "\x1b[A", "\x1b[A", "\x1b[B", "\x1b[B"}, "new draft"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			m, _ := newCustomEditorDispatchMode(t)
+			m.isIdle = true
+			m.editor.AddToHistory("older")
+			m.editor.Render(100)
+			for _, key := range tc.keys {
+				if err := m.dispatchKey(context.Background(), key); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if got := m.editor.Text(); got != tc.want {
+				t.Fatalf("draft = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
