diff --git a/tui/editor_draft_navigation_test.go b/tui/editor_draft_navigation_test.go
new file mode 100644
--- /dev/null
+++ b/tui/editor_draft_navigation_test.go
@@ -0,0 +1,95 @@
+package tui
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestDraftNavigationWordDelete(t *testing.T) {
+	for _, key := range []string{"\x17", "\x1b[127;5u", "\x1b[27;5;127~"} {
+		t.Run(key, func(t *testing.T) {
+			e := NewEditor()
+			e.SetText("first second")
+			e.HandleInput(key)
+			if e.Text() != "first " {
+				t.Fatalf("word delete: %q", e.Text())
+			}
+			e.HandleInput("\x19")
+			if e.Text() != "first second" {
+				t.Fatalf("yank: %q", e.Text())
+			}
+		})
+	}
+}
+
+func TestDraftNavigationPageKeys(t *testing.T) {
+	for _, text := range []string{"", "one", "first\n" + strings.Repeat("wrapped ", 30) + "\nlast😀"} {
+		e := NewEditor()
+		e.SetText(text)
+		e.Render(20)
+		e.HandleInput("\x1b[5~")
+		if e.cursor != [2]int{0, 0} {
+			t.Fatalf("page up: %v", e.cursor)
+		}
+		e.HandleInput("\x1b[6~")
+		want := [2]int{len(e.lines) - 1, jsStringLength(e.lines[len(e.lines)-1])}
+		if e.cursor != want {
+			t.Fatalf("page down: %v, want %v", e.cursor, want)
+		}
+		if e.Text() != text {
+			t.Fatalf("page keys changed text: %q", e.Text())
+		}
+	}
+}
+
+func TestDraftNavigationArrowsPreserveNewInput(t *testing.T) {
+	e := NewEditor()
+	e.AddToHistory("older")
+	e.AddToHistory("newer")
+	e.SetText("new draft\nsecond line")
+	e.Render(40)
+	for _, key := range []string{"\x1b[A", "\x1b[B"} {
+		for range 5 {
+			e.HandleInput(key)
+			if e.Text() != "new draft\nsecond line" || e.inputHistIdx != -1 {
+				t.Fatalf("arrows replaced draft: %q, index %d", e.Text(), e.inputHistIdx)
+			}
+		}
+	}
+	e.Clear()
+	e.HandleInput("\x1b[A")
+	if e.Text() != "newer" {
+		t.Fatalf("recall: %q", e.Text())
+	}
+	e.HandleInput("\x1b[A")
+	if e.Text() != "older" {
+		t.Fatalf("older recall: %q", e.Text())
+	}
+	e.HandleInput("\x1b[B")
+	e.HandleInput("\x1b[B")
+	if e.Text() != "" {
+		t.Fatalf("leave history: %q", e.Text())
+	}
+	e.HandleInput("\x1b[A")
+	e.HandleInput("edited")
+	for range 5 {
+		e.HandleInput("\x1b[A")
+		e.HandleInput("\x1b[B")
+	}
+	if e.Text() != "editednewer" {
+		t.Fatalf("edited history draft: %q", e.Text())
+	}
+}
+
+func TestDraftNavigationPageKeysReachFocusedEditor(t *testing.T) {
+	e := NewEditor()
+	screen := NewTuiAltScreen(nil, nil, "")
+	for _, component := range []Component{e, &struct{ *Editor }{e}} {
+		screen.SetFocus(component)
+		for _, key := range []string{"\x1b[5~", "\x1b[6~"} {
+			if action, handled := screen.matchViewportAction(key); handled {
+				t.Fatalf("viewport captured editor key as %s", action)
+			}
+		}
+	}
+}
