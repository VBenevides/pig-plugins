@@ -0,0 +1,65 @@
+package ai
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestExternalBackpressureCancellation(t *testing.T) {
+	stream := NewAssistantMessageEventStream()
+	message := &AssistantMessage{Content: []AssistantContentBlock{}, StopReason: StopReasonPending}
+	if err := stream.PushWithBackpressure(t.Context(), StartEvent{Partial: message}); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(t.Context())
+	waiting := make(chan error, 1)
+	go func() {
+		waiting <- stream.PushWithBackpressure(ctx, DoneEvent{Reason: StopReasonStop, Message: &AssistantMessage{Content: []AssistantContentBlock{}, StopReason: StopReasonStop}})
+	}()
+	select {
+	case err := <-waiting:
+		t.Fatalf("escaped queue: %v", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+	cancel()
+	if err := <-waiting; !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancel: %v", err)
+	}
+	stream.mu.Lock()
+	queued := len(stream.queue)
+	stream.mu.Unlock()
+	if queued != 1 {
+		t.Fatalf("queue=%d", queued)
+	}
+	stream.Push(ErrorEvent{Reason: StopReasonAborted, Error: &AssistantMessage{Content: []AssistantContentBlock{}, StopReason: StopReasonAborted}})
+	count := 0
+	for range stream.Events(t.Context()) {
+		count++
+	}
+	if count != 2 {
+		t.Fatalf("events=%d", count)
+	}
+}
+
+func TestExternalBackpressureResumesOnDrain(t *testing.T) {
+	stream := NewAssistantMessageEventStream()
+	if err := stream.PushWithBackpressure(t.Context(), StartEvent{Partial: &AssistantMessage{Content: []AssistantContentBlock{}}}); err != nil {
+		t.Fatal(err)
+	}
+	waiting := make(chan error, 1)
+	go func() {
+		waiting <- stream.PushWithBackpressure(t.Context(), DoneEvent{Reason: StopReasonStop, Message: &AssistantMessage{Content: []AssistantContentBlock{}, StopReason: StopReasonStop}})
+	}()
+	count := 0
+	for range stream.Events(t.Context()) {
+		count++
+	}
+	if err := <-waiting; err != nil {
+		t.Fatal(err)
+	}
+	if count != 2 {
+		t.Fatalf("events=%d", count)
+	}
+}
