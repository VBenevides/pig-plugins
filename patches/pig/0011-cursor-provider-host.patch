+package compaction
+
+import (
+	"fmt"
+	"github.com/MichaelKinsy/PiG/agent"
+	"github.com/MichaelKinsy/PiG/ai"
+	"testing"
+)
+
+func TestGenerationReplayVetoOverridesSummaryClassifier(t *testing.T) {
+	cause := &ai.AssistantCallError{Message: ai.AssistantMessage{ReplayProhibited: true, ErrorMessage: "HTTP 503"}}
+	failure := fmt.Errorf("wrapped summary: %w", cause)
+	calls, classifications := 0, 0
+	opts := &RetryOptions{Policy: RetryPolicy{Enabled: true, MaxRetries: 3}, IsRetryable: func(string) bool { classifications++; return true }}
+	_, _, err := completeSimpleWithRetries(t.Context(), opts, func() (string, *ai.Usage, error) { calls++; return "", nil, failure })
+	if calls != 1 || classifications != 0 || err != failure {
+		t.Fatalf("calls=%d classifiers=%d err=%v", calls, classifications, err)
+	}
+	if !ai.IsGenerationReplayProhibited(&summarizationCallError{failure}) {
+		t.Fatal("summary wrapper lost veto")
+	}
+	messages := convertToLlm([]agent.AgentMessage{{Assistant: &agent.AssistantMessage{ReplayProhibited: true}}})
+	if len(messages) != 1 || !messages[0].(ai.AssistantMessage).ReplayProhibited {
+		t.Fatal("summary transcript lost veto")
+	}
+}
