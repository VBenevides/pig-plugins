+func TestRPCGenerationReplayMetadata(t *testing.T) {
+	for _, prohibited := range []bool{false, true} {
+		wire, err := rpcAgentMessage(agent.AgentMessage{Assistant: &agent.AssistantMessage{Content: []ai.AssistantContentBlock{}, ReplayProhibited: prohibited, StopReason: ai.StopReasonError, ErrorMessage: "HTTP 503"}})
