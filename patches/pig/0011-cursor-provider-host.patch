index 0000000..8e115a7
--- /dev/null
+++ b/ai/generation_replay_test.go
@@ -0,0 +1,52 @@
+package ai
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"testing"
+)
+
+func TestGenerationReplayPolicy(t *testing.T) {
+	for _, tc := range []struct {
+		name, provider string
+		prohibited     bool
+		calls          int
+	}{
+		{"legacy Cursor", "cursor", false, 1},
+		{"typed request", "synthetic", true, 1},
+		{"unrelated transient", "synthetic", false, 3},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			calls := 0
+			response, err := RetryAssistantCall(t.Context(), func() (AssistantMessage, error) {
+				calls++
+				return AssistantMessage{Provider: tc.provider, ReplayProhibited: tc.prohibited, StopReason: StopReasonError, ErrorMessage: "RPC rejected (HTTP 503)"}, nil
+			}, &RetryPolicy{Enabled: true, MaxRetries: 2, BaseDelayMs: 0}, RetryCallbacks{})
+			if err != nil || calls != tc.calls || response.ErrorMessage != "RPC rejected (HTTP 503)" {
+				t.Fatalf("calls=%d response=%+v err=%v", calls, response, err)
+			}
+		})
+	}
+	message := AssistantMessage{Content: []AssistantContentBlock{}, Provider: "synthetic", ReplayProhibited: true, StopReason: StopReasonError, ErrorMessage: "HTTP 503"}
+	data, err := json.Marshal(message)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var restored AssistantMessage
+	if err = json.Unmarshal(data, &restored); err != nil {
+		t.Fatal(err)
+	}
+	if !restored.GenerationReplayProhibited() || !restored.Observe().ReplayProhibited || !cloneStartMessage(restored).ReplayProhibited {
+		t.Fatal("JSON, observation or frame cloning dropped the veto")
+	}
+	veto := &AssistantCallError{Message: restored}
+	wrapped := fmt.Errorf("summary: %w", veto)
+	joined := errors.Join(&AssistantCallError{Message: AssistantMessage{ErrorMessage: "ordinary error"}}, wrapped)
+	if !IsGenerationReplayProhibited(wrapped) || !IsGenerationReplayProhibited(joined) || IsGenerationReplayProhibited(errors.New("HTTP 503")) || IsGenerationReplayProhibited(nil) {
+		t.Fatal("wrapped/joined veto classification")
+	}
+	if veto.Error() != "HTTP 503" || (&AssistantCallError{}).Error() != "Unknown error" {
+		t.Fatal("diagnostic text changed")
+	}
+}
