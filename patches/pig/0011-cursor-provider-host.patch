+package agent
+
+import (
+	"encoding/json"
+	"github.com/MichaelKinsy/PiG/ai"
+	"testing"
+)
+
+func TestGenerationReplayPolicySurvivesAgentMessages(t *testing.T) {
+	message := agentAssistantMessage(&ai.AssistantMessage{Content: []ai.AssistantContentBlock{}, Provider: "synthetic", ReplayProhibited: true, StopReason: ai.StopReasonError, ErrorMessage: "HTTP 503"})
+	if !message.LLMMessage().ReplayProhibited {
+		t.Fatal("AI conversion dropped veto")
+	}
+	data, err := json.Marshal(AgentMessage{Assistant: message})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var restored AgentMessage
+	if err = json.Unmarshal(data, &restored); err != nil {
+		t.Fatal(err)
+	}
+	if restored.Assistant == nil || !restored.Assistant.ReplayProhibited || ai.IsRetryableAssistantError(restored.Assistant.LLMMessage()) {
+		t.Fatalf("session JSON dropped veto: %s", data)
+	}
+}
