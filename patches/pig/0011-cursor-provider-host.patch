+package coding
+
+import (
+	"github.com/MichaelKinsy/PiG/agent"
+	"github.com/MichaelKinsy/PiG/ai"
+	"github.com/MichaelKinsy/PiG/coding/extension"
+	"testing"
+)
+
+func TestGenerationReplaySessionPolicy(t *testing.T) {
+	for _, tc := range []struct {
+		name, provider, text string
+		veto                 bool
+		calls                int
+	}{
+		{"legacy Cursor", "cursor", "RPC rejected (HTTP 503)", false, 1},
+		{"typed request", "synthetic", "RPC rejected (HTTP 503)", true, 1},
+		{"overflow cannot bypass veto", "synthetic", "HTTP 503 maximum context length exceeded", true, 1},
+		{"unrelated provider retries", "synthetic", "RPC rejected (HTTP 503)", false, 2},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			failure := func([]ai.Message) *ai.AssistantMessage {
