+package tui
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/internal/jsstring"
+)
+
+func TestTakeInlineCommandPreservesDraftAndCursor(t *testing.T) {
+	for _, tc := range []struct {
+		text, before, command, want string
+		row                         int
+	}{
+		{"fix it //mode ask", "fix it //mode ask", "//mode ask", "fix it ", 0},
+		{"fix //mode ask then explain", "fix //mode ask", "//mode ask", "fix  then explain", 0},
+		{"🧠 explain //model openai/gpt-6.1 then continue", "🧠 explain //model openai/gpt-6.1", "//model openai/gpt-6.1", "🧠 explain  then continue", 0},
+		{"first line\n//mode act\nlast line", "//mode act", "//mode act", "first line\n\nlast line", 1},
+		{"//mode ask suffix", "//mode ask", "//mode ask", " suffix", 0},
+		{"first line\n/mode act\nlast line", "/mode act", "/mode act", "first line\n\nlast line", 1},
+		{"/mode ask suffix", "/mode ask", "/mode ask", " suffix", 0},
+		{"  /mode ask suffix", "  /mode ask", "/mode ask", "   suffix", 0},
+	} {
+		t.Run(tc.text, func(t *testing.T) {
+			e := NewEditor()
+			e.SetText(tc.text)
+			e.cursor = [2]int{tc.row, jsstring.Length(tc.before)}
+			got, ok := e.TakeInlineCommand(func(name string) bool { return name == "mode" || name == "model" })
+			if !ok || got != tc.command || e.Text() != tc.want {
+				t.Fatalf("command=%q ok=%v draft=%q; want %q / %q", got, ok, e.Text(), tc.command, tc.want)
+			}
+			if e.GetCursor().Line != tc.row || e.GetCursor().Col != jsstring.Length(tc.before[:strings.Index(tc.before, "/")]) {
+				t.Fatalf("cursor = %+v", e.GetCursor())
+			}
+		})
+	}
+}
+
+func TestInlineCommandsLeavePathsSkillsAndLeadingCommandsAlone(t *testing.T) {
+	for _, text := range []string{"//mode ask", "/mode ask", "example /mode ask", "read /tmp/file", "use path/mode", "use /skill:demo", "use //skill:demo", "use //unknown", "use `//mode`", "use ///mode"} {
+		e := NewEditor()
+		e.SetText(text)
+		if command, ok := e.TakeInlineCommand(func(name string) bool { return name == "mode" }); ok || e.Text() != text {
+			t.Fatalf("%q changed: %q %v %q", text, command, ok, e.Text())
+		}
+	}
+}
+
+func TestInlineCommandRetainsPasteMarkersAndUndo(t *testing.T) {
+	e := NewEditor()
+	pasted := strings.Repeat("pasted line\n", 15)
+	e.HandleInput("\x1b[200~" + pasted + "\x1b[201~")
+	e.InsertTextAtCursor(" //mode ask")
+	original := e.Text()
+	if _, ok := e.TakeInlineCommand(func(name string) bool { return name == "mode" }); !ok {
+		t.Fatal("command not found")
+	}
+	if !strings.Contains(e.GetExpandedText(), pasted) {
+		t.Fatal("paste content lost")
+	}
+	e.HandleInput("\x1f")
+	if e.Text() != original || !strings.Contains(e.GetExpandedText(), pasted) {
+		t.Fatalf("undo lost draft/paste: %q", e.GetExpandedText())
+	}
+}
+
+func TestMidPromptCommandCompletionPreservesSuffix(t *testing.T) {
+	provider := NewChatAutocompleteProvider(skillTestCommands(), t.TempDir(), "")
+	lines := []string{"fix it //hel later"}
+	got := provider.GetSuggestions(lines, 0, len("fix it //hel"))
+	if got == nil || len(got.Items) != 1 {
+		t.Fatalf("suggestions = %+v", got)
+	}
+	out, _, col := provider.ApplyCompletion(lines, 0, len("fix it //hel"), got.Items[0], got.Prefix)
+	if out[0] != "fix it //help  later" || col != len("fix it //help ") || acceptSubmits(lines, 0, len("fix it //hel"), got.Prefix) {
+		t.Fatalf("completion = %q, col=%d", out, col)
+	}
+}
+
+func TestSkillPreviewCapsVisualRowsWithoutTruncatingContent(t *testing.T) {
+	var body []string
+	for i := 0; i < 15; i++ {
+		body = append(body, fmt.Sprintf("skill row %02d", i))
+	}
+	content := strings.Join(body, "\n")
+	component := NewSkillInvocationMessage(ParsedSkillBlock{Name: "demo", Content: content})
+	collapsed := stripANSI(strings.Join(component.Render(80), "\n"))
+	if strings.Count(collapsed, "skill row") != 10 || !strings.Contains(collapsed, "5 more lines") {
+		t.Fatalf("collapsed = %q", collapsed)
+	}
+	component.SetExpanded(true)
+	if expanded := strings.Join(component.Render(80), "\n"); !strings.Contains(expanded, "skill row 14") || component.skillBlock.Content != content {
+		t.Fatal("full skill content was lost")
+	}
+	component.SetExpanded(false)
+	component.skillBlock.Content = strings.Repeat("long skill content ", 30)
+	rows := component.Render(12)
+	allRows := wrapText(component.skillBlock.Content, 10)
+	for i := 0; i < 10; i++ {
+		if !strings.HasPrefix(stripANSI(rows[i+2]), " "+allRows[i]) {
+			t.Fatalf("preview row %d = %q, want %q", i, rows[i+2], allRows[i])
+		}
+	}
+	if strings.Contains(stripANSI(strings.Join(rows[12:], "\n")), "skill") {
+		t.Fatal("skill body continued past the tenth visual row")
+	}
+}
+
+func TestRestoreDraftPreservesPasteAndDoesNotOverwriteNewTyping(t *testing.T) {
+	e := NewEditor()
+	pasted := strings.Repeat("pasted line\n", 15)
+	e.HandleInput("\x1b[200~" + pasted + "\x1b[201~")
+	original, cursor := e.Text(), e.GetCursor()
+	restore := e.RestoreDraftIfCleared()
+	e.Clear()
+	restore()
+	if e.Text() != original || e.GetCursor() != cursor || !strings.Contains(e.GetExpandedText(), pasted) {
+		t.Fatal("restoration lost draft state")
+	}
+	e.SetText("new user input")
+	restore()
+	if e.Text() != "new user input" {
+		t.Fatal("delayed command overwrote newer typing")
+	}
+}
