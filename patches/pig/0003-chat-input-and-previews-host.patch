@@ -0,0 +1,41 @@
+package codingagent
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestExpandInlineSkillCommands(t *testing.T) {
+	skills := []*SkillDef{
+		{Name: "alpha", Body: "alpha body", Path: "/skills/alpha.md", Dir: "/skills", SourceInfo: PiSourceInfo{Source: "inline"}},
+		{Name: "beta", Body: "beta body", Path: "/skills/beta.md", Dir: "/skills", SourceInfo: PiSourceInfo{Source: "inline"}},
+	}
+
+	t.Run("expands each known skill once and keeps the text", func(t *testing.T) {
+		text := "fix the bug /skill:beta then /skill:alpha and /skill:beta again, /skill:missing"
+		got, ok, failure := ExpandInlineSkillCommands(text, skills)
+		if !ok || failure != nil {
+			t.Fatalf("ok=%v failure=%v", ok, failure)
+		}
+		if !strings.HasSuffix(got, "\n\n"+text) {
+			t.Errorf("original text is not preserved at the end: %q", got)
+		}
+		if strings.Count(got, "<skill name=\"beta\"") != 1 || strings.Count(got, "<skill name=\"alpha\"") != 1 {
+			t.Errorf("each skill must expand once: %q", got)
+		}
+		if strings.Index(got, "name=\"beta\"") > strings.Index(got, "name=\"alpha\"") {
+			t.Errorf("blocks must follow order of first mention: %q", got)
+		}
+		if strings.Contains(got, "name=\"missing\"") {
+			t.Errorf("unknown skill expanded: %q", got)
+		}
+	})
+
+	t.Run("leaves unknown skills, plain text and commands alone", func(t *testing.T) {
+		for _, text := range []string{"use /skill:missing", "no skill here", "/other /skill:alpha", "path/skill:alpha"} {
+			if got, ok, failure := ExpandInlineSkillCommands(text, skills); ok {
+				t.Errorf("%q expanded to %q (failure %v)", text, got, failure)
+			}
+		}
+	})
+}
