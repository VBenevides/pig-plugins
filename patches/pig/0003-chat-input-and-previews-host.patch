+++ b/internal/codingagent/chat_command_line.go
@@ -0,0 +1,16 @@
+package codingagent
+
+import "strings"
+
+// chatCommandLine normalizes a command at the start of submitted input or an
+// extracted editor line. Mid-line command recognition belongs to the editor.
+func chatCommandLine(line string) string {
+	line = strings.TrimSpace(line)
+	if strings.HasPrefix(line, "//") {
+		line = line[1:]
+	}
+	if !strings.HasPrefix(line, "/") || strings.HasPrefix(line, "//") || strings.HasPrefix(line, "/skill:") {
+		return ""
+	}
+	return line
+}
