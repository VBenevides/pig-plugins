--- /dev/null
+++ b/internal/codingagent/tool_expansion_preference.go
@@ -0,0 +1,43 @@
+package codingagent
+
+import (
+	"fmt"
+	"log"
+)
+
+// Preference saves are coalesced into one joined worker, never disk IO on the
+// input loop. Shutdown drains that worker so the latest toggle is durable.
+func (m *InteractiveMode) persistToolExpansionPreference() {
+	manager := m.opts.SettingsManager
+	if manager == nil {
+		return
+	}
+	m.toolMu.Lock()
+	m.toolPreferenceVersion++
+	if m.toolPreferenceSaving {
+		m.toolMu.Unlock()
+		return
+	}
+	m.toolPreferenceSaving = true
+	m.toolMu.Unlock()
+	ownerContext := m.runCtx
+	m.backgroundTasks.Go(func() {
+		for {
+			m.toolMu.Lock()
+			expanded, version := m.toolsExpanded, m.toolPreferenceVersion
+			m.toolMu.Unlock()
+			if err := manager.UpdateGlobal(func(settings *Settings) { settings.ToolsExpanded = new(expanded) }); err != nil {
+				message := fmt.Sprintf("Cannot save tool output preference: %v", err)
+				log.Print(message)
+				m.runOnMain(ownerContext, func() { m.showError(message) })
+			}
+			m.toolMu.Lock()
+			if version == m.toolPreferenceVersion {
+				m.toolPreferenceSaving = false
+				m.toolMu.Unlock()
+				return
+			}
+			m.toolMu.Unlock()
+		}
+	})
+}
