+package tui
+
+// NewChatAutocompleteProvider completes everything with / at line start.
+// After prose, / completes skills and // completes commands. Other editors
+// retain the upstream autocomplete API.
+func NewChatAutocompleteProvider(cmds []SlashCommand, baseDir, fdPath string) *CombinedProvider {
+	provider := NewCombinedProvider(cmds, baseDir, fdPath)
+	provider.slash.chatInput = true
+	return provider
+}
