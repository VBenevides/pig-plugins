+// appendUserMessage renders every leading skill block as a mounted expandable
+// component, keeping the remaining prompt and the model's full input unchanged.
+func (m *InteractiveMode) appendUserMessage(text string) {
+	for {
+		parsed := ParseSkillBlock(text)
+		if parsed == nil {
+			if text != "" {
+				m.appendToChat(m.newUserMessageBlock(text))
+			}
+			return
+		}
+		component := tui.NewSkillInvocationMessage(tui.ParsedSkillBlock{
+			Name: parsed.Name, Content: parsed.Content,
+		})
+		component.SetExpanded(m.toolsExpanded)
+		m.appendToChat(component)
+		text = parsed.UserMessage
+		if text == "" {
+			return
+		}
+		m.appendToChat(tui.NewSpacer(1))
+	}
+}
+
