+
+const oauthAccountsMaxBytes = 4 << 20
+const oauthAccountsMaxCount = 256
+
+// OAuthAccount contains display metadata only. ID is an opaque local identity,
+// not a bearer token or the provider's account identifier.
+type OAuthAccount struct {
+	ID       string  `json:"id"`
+	Provider string  `json:"provider"`
+	Label    string  `json:"label"`
+	Active   bool    `json:"active"`
+	Expires  float64 `json:"expires"`
+}
+
+type oauthAccountRecord struct {
+	ID         string     `json:"id"`
+	Provider   string     `json:"provider"`
+	Label      string     `json:"label"`
+	Credential Credential `json:"credential"`
+}
+
+type oauthAccountData struct {
+	Version        int                  `json:"version"`
+	LegacyMigrated bool                 `json:"legacyMigrated"`
+	LegacyRevision string               `json:"legacyRevision,omitempty"`
+	Migrated       map[string]bool      `json:"migrated"`
+	Selected       map[string]string    `json:"selected"`
+	Accounts       []oauthAccountRecord `json:"accounts"`
+}
+
+func (a *AuthStorage) OAuthAccountsPath() string {
+	return filepath.Join(filepath.Dir(a.path), "oauth-accounts.json")
+}
+
+func readOAuthBounded(path string) ([]byte, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() {
+		return nil, errors.New("oauth accounts: store is not a regular file")
+	}
+	if info.Size() > oauthAccountsMaxBytes {
+		return nil, errors.New("oauth accounts: store exceeds size limit")
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+	info, err = file.Stat()
+	if err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() {
+		return nil, errors.New("oauth accounts: store is not a regular file")
+	}
+	if info.Size() > oauthAccountsMaxBytes {
+		return nil, errors.New("oauth accounts: store exceeds size limit")
+	}
+	data, err := io.ReadAll(io.LimitReader(file, oauthAccountsMaxBytes+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(data) > oauthAccountsMaxBytes {
+		return nil, errors.New("oauth accounts: store exceeds size limit")
+	}
+	return data, nil
+}
+
+func validOAuthDisplay(value string, maxBytes int) bool {
+	return value != "" && len(value) <= maxBytes && !strings.ContainsFunc(value, func(r rune) bool { return !unicode.IsPrint(r) })
+}
+
+func validateOAuthAccountData(data *oauthAccountData) error {
+	if data.Version != 1 || data.Migrated == nil || data.Selected == nil || data.Accounts == nil || len(data.Accounts) > oauthAccountsMaxCount {
+		return errors.New("oauth accounts: invalid store structure or version")
+	}
+	ids := make(map[string]string, len(data.Accounts))
+	for _, account := range data.Accounts {
+		if len(account.ID) != 67 || !strings.HasPrefix(account.ID, "oa_") {
+			return errors.New("oauth accounts: invalid account identity")
+		}
+		if _, err := hex.DecodeString(account.ID[3:]); err != nil {
+			return errors.New("oauth accounts: invalid account identity")
+		}
+		if _, exists := ids[account.ID]; exists || !validOAuthDisplay(account.Provider, 256) || !validOAuthDisplay(account.Label, 256) || account.Credential.Type != CredentialOAuth || account.Credential.Access == "" || !data.Migrated[account.Provider] {
+			return errors.New("oauth accounts: invalid account record")
+		}
+		ids[account.ID] = account.Provider
+	}
+	for provider, id := range data.Selected {
+		if ids[id] != provider {
+			return errors.New("oauth accounts: invalid selected account")
+		}
+	}
+	return nil
+}
+
+// The account lock is always acquired before the legacy lock, and both cover
+// the complete transaction, including callbacks and the durable native write.
+// Malformed stores fail closed without replacing bytes.
+func (a *AuthStorage) withOAuthAccounts(ctx context.Context, fn func(*oauthAccountData) (bool, error)) error {
+	return a.withOAuthAccountsLocked(ctx, func(data *oauthAccountData, _ *pilock.Lock) (bool, error) {
+		return fn(data)
+	})
+}
+
+func (a *AuthStorage) withOAuthAccountsLocked(ctx context.Context, fn func(*oauthAccountData, *pilock.Lock) (bool, error)) (err error) {
+	if err := context.Cause(ctx); err != nil {
+		return err
+	}
+	if err := a.accountsMu.LockContext(ctx); err != nil {
+		return err
+	}
+	defer a.accountsMu.Unlock()
+	path := a.OAuthAccountsPath()
+	lock, err := pilock.Acquire(ctx, path)
+	if err != nil {
+		return err
+	}
+	defer func() { err = errors.Join(err, lock.Release()) }()
+	return a.withFileLock(lock.Context(), true, func(legacyLock *pilock.Lock) error {
+		var data *oauthAccountData
+		if info, err := os.Lstat(path); err == nil {
+			if !info.Mode().IsRegular() || info.Mode().Perm() != 0o600 {
+				return errors.New("oauth accounts: store must be a regular owner-only file (0600)")
+			}
+		} else if !errors.Is(err, os.ErrNotExist) {
+			return err
+		}
+		revision, hasRevision := authFileRevision(path)
+		if hasRevision && a.accountsData != nil && a.accountsRevision == revision {
+			data = a.accountsData
+		} else {
+			raw, readErr := readOAuthBounded(path)
+			if readErr == nil {
+				data = new(oauthAccountData)
+				if json.Unmarshal(raw, data) != nil {
+					return errors.New("oauth accounts: invalid JSON")
+				}
+				if err := validateOAuthAccountData(data); err != nil {
+					return err
+				}
+			} else if errors.Is(readErr, os.ErrNotExist) {
+				data = &oauthAccountData{Version: 1, Migrated: map[string]bool{}, Selected: map[string]string{}, Accounts: []oauthAccountRecord{}}
+			} else {
+				return readErr
+			}
+		}
+		// Do not retain an uncommitted mutation after any failure.
+		a.accountsData = nil
+		a.accountsRevision = ""
+		changed := false
+		legacyRevision, hasLegacyRevision := authFileRevision(a.path)
+		if !data.LegacyMigrated || !hasLegacyRevision || data.LegacyRevision != legacyRevision {
+			if err := legacyLock.Check(); err != nil {
+				return err
+			}
+			legacy, err := readOAuthBounded(a.path)
+			if err != nil {
+				return err
+			}
+			credentials := map[string]rawCredential{}
+			if json.Unmarshal(text.StripBomBytes(legacy), &credentials) != nil || credentials == nil {
+				return errors.New("oauth accounts: invalid legacy auth store")
+			}
+			providers := make([]string, 0, len(credentials))
+			for provider := range credentials {
+				providers = append(providers, provider)
+			}
+			slices.Sort(providers)
+			for _, provider := range providers {
+				credential := credentials[provider].normalize()
+				// Legacy CredentialStore accepts partial OAuth values. They stay in
+				// auth.json and are not valid inputs to the strict native store.
+				if credential.Type != CredentialOAuth || credential.Access == "" {
+					continue
+				}
+				if !data.Migrated[provider] {
+					if _, err := upsertOAuthAccount(data, provider, credential); err != nil {
+						return err
+					}
+				}
+			}
+			var ok bool
+			data.LegacyRevision, ok = authFileRevision(a.path)
+			if !ok {
+				return errors.New("oauth accounts: cannot identify legacy store revision")
+			}
+			if err := legacyLock.Check(); err != nil {
+				return err
+			}
+			data.LegacyMigrated = true
+			changed = true
+		}
+		if err := legacyLock.Check(); err != nil {
+			return err
+		}
+		mutated, err := fn(data, legacyLock)
+		if err != nil {
+			return err
+		}
+		if err := legacyLock.Check(); err != nil {
+			return err
+		}
+		if !changed && !mutated {
+			a.accountsData, a.accountsRevision = data, revision
+			return nil
+		}
+		if err := validateOAuthAccountData(data); err != nil {
+			return err
+		}
+		encoded, err := json.MarshalIndent(data, "", "  ")
+		if err != nil {
+			return errors.New("oauth accounts: cannot encode store")
+		}
+		if len(encoded) > oauthAccountsMaxBytes {
+			return errors.New("oauth accounts: store exceeds size limit")
+		}
+		if err := lock.Check(); err != nil {
+			return err
+		}
+		if err := legacyLock.Check(); err != nil {
+			return err
+		}
+		if err := writeOAuthAccountFile(path, encoded, lock); err != nil {
+			return err
+		}
+		a.accountsData = data
+		a.accountsRevision, _ = authFileRevision(path)
+		return nil
+	})
+}
+
+func writeOAuthAccountFile(path string, encoded []byte, lock *pilock.Lock) (err error) {
+	file, err := ownerfile.CreateTemp(filepath.Dir(path), ".oauth-accounts-*")
+	if err != nil {
+		return err
+	}
+	name := file.Name()
+	defer func() {
+		if file != nil {
+			err = errors.Join(err, file.Close())
+		}
+		if removeErr := os.Remove(name); removeErr != nil && !errors.Is(removeErr, os.ErrNotExist) {
+			err = errors.Join(err, removeErr)
+		}
+	}()
+	if _, err := file.Write(encoded); err != nil {
+		return err
+	}
+	if err := file.Sync(); err != nil {
+		return err
+	}
+	if err := file.Close(); err != nil {
+		file = nil
+		return err
+	}
+	file = nil
+	if err := lock.Check(); err != nil {
+		return err
+	}
+	if err := os.Rename(name, path); err != nil {
+		return err
+	}
+	if err := lock.Compromised(); err != nil {
+		return err
+	}
+	dir, err := os.Open(filepath.Dir(path))
+	if err != nil {
+		return err
+	}
+	return errors.Join(dir.Sync(), dir.Close())
+}
+
+// JWT identity claims are hints for deduplication and labels, never auth proof.
+// Tokens remain the exact credentials returned by the native provider login.
+func oauthAccountIdentity(provider string, credential Credential) (string, string) {
+	identity := credential.AccountID
+	label := ""
+	parts := strings.Split(credential.Access, ".")
+	if len(parts) == 3 && len(parts[1]) <= 64<<10 {
+		payload, err := base64.RawURLEncoding.DecodeString(strings.TrimRight(parts[1], "="))
+		if err != nil {
+			payload, err = base64.RawStdEncoding.DecodeString(strings.TrimRight(parts[1], "="))
+		}
+		claims := map[string]any{}
+		if err == nil && json.Unmarshal(payload, &claims) == nil {
+			if auth, ok := claims["https://api.openai.com/auth"].(map[string]any); ok {
+				if id, ok := auth["chatgpt_account_id"].(string); ok && id != "" {
+					identity = id
+				}
+			}
+			email, _ := claims["email"].(string)
+			if profile, ok := claims["https://api.openai.com/profile"].(map[string]any); ok && email == "" {
+				email, _ = profile["email"].(string)
+			}
+			if validOAuthDisplay(email, 254) {
+				if address, err := mail.ParseAddress(email); err == nil && address.Address == email {
+					label = email
+				}
+			}
+			if identity == "" {
+				identity, _ = claims["sub"].(string)
+			}
+		}
+	}
+	if identity == "" {
+		identity = credential.ProjectID
+	}
+	if identity == "" && label == "" {
+		identity = "singleton"
+	}
+	digest := sha256.Sum256([]byte(provider + "\x00" + identity + "\x00" + strings.ToLower(label)))
+	id := "oa_" + hex.EncodeToString(digest[:])
+	if label == "" {
+		label = provider + " account " + id[3:15]
+	}
+	return id, label
+}
+
+// Only matching, present token claims establish a refresh identity constraint.
+// Provider metadata can change during refresh, and opaque tokens have no claims.
+func oauthRefreshChangesIdentity(previous, next string) bool {
+	type identityClaims struct {
+		Subject string `json:"sub"`
+		Email   string `json:"email"`
+		Auth    struct {
+			Account string `json:"chatgpt_account_id"`
+		} `json:"https://api.openai.com/auth"`
+		Profile struct {
+			Email string `json:"email"`
+		} `json:"https://api.openai.com/profile"`
+	}
+	claims := func(token string) identityClaims {
+		_, remainder, ok := strings.Cut(token, ".")
+		payloadText, signature, hasSignature := strings.Cut(remainder, ".")
+		if !ok || !hasSignature || strings.Contains(signature, ".") || len(payloadText) > 64<<10 {
+			return identityClaims{}
+		}
+		payloadText = strings.TrimRight(payloadText, "=")
+		payload, err := base64.RawURLEncoding.DecodeString(payloadText)
+		if err != nil {
+			payload, err = base64.RawStdEncoding.DecodeString(payloadText)
+		}
+		var values identityClaims
+		if err != nil || json.Unmarshal(payload, &values) != nil {
+			return identityClaims{}
+		}
+		if values.Email == "" {
+			values.Email = values.Profile.Email
+		}
+		return values
+	}
+	oldClaims, newClaims := claims(previous), claims(next)
+	changed := func(old, next string) bool { return old != "" && next != "" && old != next }
+	return changed(oldClaims.Subject, newClaims.Subject) ||
+		changed(oldClaims.Auth.Account, newClaims.Auth.Account) ||
+		(oldClaims.Email != "" && newClaims.Email != "" && !strings.EqualFold(oldClaims.Email, newClaims.Email))
+}
+
+func upsertOAuthAccount(data *oauthAccountData, provider string, credential Credential) (string, error) {
+	if credential.Type != CredentialOAuth || credential.Access == "" || !validOAuthDisplay(provider, 256) {
+		return "", errors.New("oauth accounts: invalid login credential")
+	}
+	id, label := oauthAccountIdentity(provider, credential)
+	index := slices.IndexFunc(data.Accounts, func(account oauthAccountRecord) bool { return account.ID == id })
+	record := oauthAccountRecord{ID: id, Provider: provider, Label: label, Credential: cloneCredential(credential)}
+	if index >= 0 {
+		data.Accounts[index] = record
+	} else {
+		if len(data.Accounts) >= oauthAccountsMaxCount {
+			return "", errors.New("oauth accounts: account limit reached")
+		}
+		data.Accounts = append(data.Accounts, record)
+	}
+	data.Selected[provider] = id
+	data.Migrated[provider] = true
+	return id, nil
+}
+
+// UpsertOAuthAccount persists a native login and selects that identity. Refresh
+// must use Modify instead, which updates only the selected record under lock.
+func (a *AuthStorage) UpsertOAuthAccount(ctx context.Context, provider string, credential Credential) (string, error) {
+	var id string
+	err := a.withOAuthAccounts(ctx, func(data *oauthAccountData) (bool, error) {
+		var err error
+		id, err = upsertOAuthAccount(data, provider, credential)
+		return err == nil, err
+	})
+	return id, err
+}
+
+func (a *AuthStorage) OAuthAccounts(ctx context.Context) ([]OAuthAccount, error) {
+	accounts := []OAuthAccount{}
+	err := a.withOAuthAccounts(ctx, func(data *oauthAccountData) (bool, error) {
+		for _, account := range data.Accounts {
+			accounts = append(accounts, OAuthAccount{ID: account.ID, Provider: account.Provider, Label: account.Label, Active: data.Selected[account.Provider] == account.ID, Expires: account.Credential.ExpiresMillis()})
+		}
+		return false, nil
+	})
+	return accounts, err
+}
+
+// OAuthAccountAuth explicitly returns secrets for one opaque ID. It does not
+// refresh or alter selection; enumeration never calls this method.
+func (a *AuthStorage) OAuthAccountAuth(ctx context.Context, id string) (map[string]any, error) {
+	var result map[string]any
+	err := a.withOAuthAccounts(ctx, func(data *oauthAccountData) (bool, error) {
+		for _, account := range data.Accounts {
+			if account.ID == id {
+				credential := account.Credential
+				result = map[string]any{"type": "oauth", "access": credential.Access, "expires": credential.ExpiresMillis(), "accountId": credential.AccountID}
+				if credential.AccountID == "" {
+					result["accountId"] = CodexAccountID(credential.Access)
+				}
+				return false, nil
+			}
+		}
+		return false, errors.New("oauth accounts: account not found")
+	})
+	return result, err
+}
+
+func (a *AuthStorage) SelectOAuthAccount(ctx context.Context, id string) error {
+	return a.withOAuthAccounts(ctx, func(data *oauthAccountData) (bool, error) {
+		for _, account := range data.Accounts {
+			if account.ID == id {
+				changed := data.Selected[account.Provider] != id
+				data.Selected[account.Provider] = id
+				return changed, nil
+			}
+		}
+		return false, errors.New("oauth accounts: account not found")
+	})
+}
+
+// API-key-only callers retain the singleton store's existing read behavior.
+// Native account operations themselves still validate both stores strictly.
+func (a *AuthStorage) nativeOAuthNeeded(ctx context.Context, provider string) (bool, error) {
+	if _, err := os.Lstat(a.OAuthAccountsPath()); err == nil {
+		return true, nil
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return false, err
+	}
+	legacy, err := a.readCredentialData(ctx)
+	if err != nil {
+		return false, err
+	}
+	if provider != "" {
+		credential := legacy.values[provider]
+		return credential.Type == CredentialOAuth && credential.Access != "", nil
+	}
+	for _, credential := range legacy.values {
+		if credential.Type == CredentialOAuth && credential.Access != "" {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+func (a *AuthStorage) selectedOAuthCredential(ctx context.Context, provider string) (*Credential, bool, error) {
+	needed, needErr := a.nativeOAuthNeeded(ctx, provider)
+	if needErr != nil || !needed {
+		return nil, false, needErr
+	}
+	var result *Credential
+	var handled bool
+	err := a.withOAuthAccounts(ctx, func(data *oauthAccountData) (bool, error) {
+		handled = data.Migrated[provider]
+		for _, account := range data.Accounts {
+			if account.ID == data.Selected[provider] {
+				result = new(cloneCredential(account.Credential))
+				break
+			}
+		}
+		return false, nil
+	})
+	return result, handled, err
+}
+
+func (a *AuthStorage) modifySelectedOAuth(ctx context.Context, provider string, fn func(*Credential) (*Credential, error)) (*Credential, bool, error) {
+	needed, needErr := a.nativeOAuthNeeded(ctx, provider)
+	if needErr != nil || !needed {
+		return nil, false, needErr
+	}
+	var result *Credential
+	var handled bool
+	err := a.withOAuthAccountsLocked(ctx, func(data *oauthAccountData, legacyLock *pilock.Lock) (bool, error) {
+		handled = true
+		index := slices.IndexFunc(data.Accounts, func(account oauthAccountRecord) bool { return account.ID == data.Selected[provider] })
+		if index >= 0 {
+			result = new(cloneCredential(data.Accounts[index].Credential))
+		} else {
+			credentials, err := a.loadLocked()
+			if err != nil {
+				return false, err
+			}
+			if credential, exists := credentials.values[provider]; exists && !(data.Migrated[provider] && credential.Type == CredentialOAuth && credential.Access != "") {
+				result = new(cloneCredential(credential))
+			}
+		}
+		next, err := fn(result)
+		if err != nil || next == nil {
+			return false, err
+		}
+		if index < 0 && next.Type == CredentialOAuth && next.Access != "" {
+			if _, err := upsertOAuthAccount(data, provider, *next); err != nil {
+				return false, err
+			}
+			result = new(cloneCredential(*next))
+			return true, nil
+		}
+		if next.Type != CredentialOAuth || next.Access == "" {
+			// CredentialStore mutations remain permissive; incomplete OAuth
+			// values and API keys belong to the singleton, not native records.
+			if err := legacyLock.Check(); err != nil {
+				return false, err
+			}
+			credentials, err := a.loadLocked()
+			if err != nil {
+				return false, err
+			}
+			credentials.set(provider, cloneCredential(*next))
+			if err := a.writeLocked(credentials, legacyLock); err != nil {
+				return false, err
+			}
+			delete(data.Selected, provider)
+			result = new(cloneCredential(*next))
+			return true, nil
+		}
+		if oauthRefreshChangesIdentity(data.Accounts[index].Credential.Access, next.Access) {
+			return false, errors.New("oauth accounts: refresh changed account identity")
+		}
+		data.Accounts[index].Credential = cloneCredential(*next)
+		result = new(cloneCredential(*next))
+		return true, nil
+	})
+	return result, handled, err
+}
+
+func (a *AuthStorage) deleteSelectedOAuth(ctx context.Context, provider string) (bool, error) {
+	needed, needErr := a.nativeOAuthNeeded(ctx, provider)
+	if needErr != nil || !needed {
+		return false, needErr
+	}
+	var handled bool
+	err := a.withOAuthAccounts(ctx, func(data *oauthAccountData) (bool, error) {
+		handled = data.Selected[provider] != ""
+		if !handled {
+			return false, nil
+		}
+		id := data.Selected[provider]
+		data.Accounts = slices.DeleteFunc(data.Accounts, func(account oauthAccountRecord) bool { return account.ID == id })
+		delete(data.Selected, provider)
+		return id != "", nil
+	})
+	return handled, err
+}
+
+func (a *AuthStorage) overlayOAuthAccounts(ctx context.Context, credentials map[string]Credential) error {
+	needed, needErr := a.nativeOAuthNeeded(ctx, "")
+	if needErr != nil || !needed {
+		return needErr
+	}
+	return a.withOAuthAccounts(ctx, func(data *oauthAccountData) (bool, error) {
+		for provider := range data.Migrated {
+			if credentials[provider].Type == CredentialOAuth && credentials[provider].Access != "" {
+				delete(credentials, provider)
+			}
+		}
+		for _, account := range data.Accounts {
+			if data.Selected[account.Provider] == account.ID {
+				credentials[account.Provider] = cloneCredential(account.Credential)
+			}
+		}
+		return false, nil
+	})
+}
+
+// StoreLoginCredential separates login identity upserts from request refreshes.
+func (native *AuthStorage) StoreLoginCredential(ctx context.Context, provider string, credential Credential) error {
+	if credential.Type == CredentialOAuth {
+		_, err := native.UpsertOAuthAccount(ctx, provider, credential)
+		return err
+	}
+	_, err := native.Modify(ctx, provider, func(*Credential) (*Credential, error) { return new(credential), nil })
+	return err
+}
+
+type loginCredentialStore interface {
+	StoreLoginCredential(context.Context, string, Credential) error
+}
+
+func StoreLoginCredential(ctx context.Context, store CredentialStore, provider string, credential Credential) error {
+	if native, ok := store.(loginCredentialStore); ok {
+		return native.StoreLoginCredential(ctx, provider, credential)
+	}
+	_, err := store.Modify(ctx, provider, func(*Credential) (*Credential, error) { return new(credential), nil })
+	return err
+}
