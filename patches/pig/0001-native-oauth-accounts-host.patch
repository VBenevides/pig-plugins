+func TestNativeOAuthAccountsRPCAndTUIBridge(t *testing.T) {
+	for _, mode := range []string{"rpc", "tui"} {
+		t.Run(mode, func(t *testing.T) {
+			registry, store, ids := accountRegistryFixture(t)
+			bridge := subprocess.NewUIBridge(func() {})
+			if mode == "tui" {
+				bridge.SetUIContext(nativeAccountTUI{extension.NoopUIContext})
+			}
+			detach := WireModelOperations(bridge, ModelOperationBindings{Registry: registry})
+			defer detach()
+			call := func(method, args string) *subprocess.CallResultPayload {
+				t.Helper()
+				result, err := bridge.HandleCall("quota", &subprocess.CallPayload{Method: method, Args: json.RawMessage(args)})
+				if err != nil || result == nil || result.Error != nil {
+					t.Fatal("native host action failed", method, err)
+				}
+				return result
+			}
+			metadata := call("oauthAccounts", `{}`).Result
+			if strings.Contains(string(metadata), "signature") || strings.Contains(string(metadata), "fixture-refresh") {
+				t.Fatal("account metadata exposed tokens")
+			}
+			var accounts []ai.OAuthAccount
+			if err := json.Unmarshal(metadata, &accounts); err != nil || len(accounts) != 2 {
+				t.Fatal("native enumeration failed", err)
+			}
+			args, err := json.Marshal(map[string]string{"id": ids[0]})
