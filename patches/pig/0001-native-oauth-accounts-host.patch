+func TestNativeOAuthSingletonMigrationIsIdempotent(t *testing.T) {
+	store := nativeAccountStorage(t)
+	legacy := nativeAccountCredential(t, "legacy-workspace", "legacy@example.test", "legacy-refresh", 0)
+	raw, err := json.Marshal(map[string]Credential{"openai-codex": legacy, "other": {Type: CredentialAPIKey, Key: "api-key"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(store.Path(), raw, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	accounts, err := store.OAuthAccounts(t.Context())
+	if err != nil || len(accounts) != 1 || !accounts[0].Active {
+		t.Fatal("singleton was not migrated", err)
+	}
+	before, err := os.ReadFile(store.OAuthAccountsPath())
+	if err != nil {
+		t.Fatal(err)
+	}
+	for range 3 {
+		if _, err := store.OAuthAccounts(t.Context()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	after, err := os.ReadFile(store.OAuthAccountsPath())
+	if err != nil || !bytes.Equal(before, after) {
+		t.Fatal("enumeration rewrote persisted credentials", err)
+	}
+	preserved, err := os.ReadFile(store.Path())
+	if err != nil || !bytes.Equal(raw, preserved) {
+		t.Fatal("migration changed singleton bytes", err)
+	}
+	key, err := store.Read(t.Context(), "other")
+	if err != nil || key == nil || key.Key != "api-key" {
+		t.Fatal("migration changed API-key auth", err)
+	}
+	if err := store.Delete(t.Context(), "openai-codex"); err != nil {
+		t.Fatal(err)
+	}
+	reopened, err := NewAuthStorage(store.Path())
+	if err != nil {
+		t.Fatal(err)
+	}
+	accounts, err = reopened.OAuthAccounts(t.Context())
+	if err != nil || len(accounts) != 0 {
+		t.Fatal("deleted singleton was imported again", err)
+	}
+	credential, err := reopened.Read(t.Context(), "openai-codex")
+	if err != nil || credential != nil {
+		t.Fatal("singleton fallback resurrected logged-out account", err)
+	}
+}
