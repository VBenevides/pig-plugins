+func TestNativeOAuthLegacyPartialCredentialAPIs(t *testing.T) {
+	for _, mutation := range []string{"Set", "Modify", "Update"} {
+		t.Run(mutation, func(t *testing.T) {
+			store := nativeAccountStorage(t)
+			partial := Credential{Type: CredentialOAuth}
+			if err := store.Set("provider", partial); err != nil {
+				t.Fatal(err)
+			}
+			current, err := store.Read(t.Context(), "provider")
+			if err != nil || current == nil || current.Type != CredentialOAuth || current.Access != "" {
+				t.Fatal("legacy partial credential was rejected", err)
+			}
+			if accounts, err := store.OAuthAccounts(t.Context()); err != nil || len(accounts) != 0 {
+				t.Fatal("partial credential entered the native store", err)
+			}
+			id, err := store.UpsertOAuthAccount(t.Context(), "provider", Credential{Type: CredentialOAuth, Access: "complete-access"})
+			if err != nil {
+				t.Fatal(err)
+			}
+			switch mutation {
+			case "Set":
+				err = store.Set("provider", partial)
+			case "Modify":
+				_, err = store.Modify(t.Context(), "provider", func(*Credential) (*Credential, error) { return &partial, nil })
+			case "Update":
+				err = store.Update("provider", func(_ Credential, exists bool) (Credential, error) {
+					if !exists {
+						t.Fatal("selected native credential was absent")
+					}
+					return partial, nil
+				})
+			}
+			if err != nil {
+				t.Fatal("partial mutation after migration failed", err)
+			}
+			reopened, err := NewAuthStorage(store.Path())
+			if err != nil {
+				t.Fatal(err)
+			}
+			current, err = reopened.Read(t.Context(), "provider")
+			if err != nil || current == nil || current.Type != CredentialOAuth || current.Access != "" {
+				t.Fatal("partial mutation did not survive restart", err)
+			}
+			accounts, err := reopened.OAuthAccounts(t.Context())
+			if err != nil || len(accounts) != 1 || accounts[0].ID != id || accounts[0].Active {
+				t.Fatal("partial mutation damaged native accounts", err)
+			}
+			if _, err := reopened.UpsertOAuthAccount(t.Context(), "provider", partial); err == nil {
+				t.Fatal("native login accepted a partial credential")
+			}
+		})
+	}
+}
