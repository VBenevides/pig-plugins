--- /dev/null
+++ b/internal/codingagent/oauth_accounts.go
@@ -0,0 +1,137 @@
+package codingagent
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/MichaelKinsy/PiG/ai"
+	"github.com/MichaelKinsy/PiG/tui"
+)
+
+// Account actions use the registry's actual request credential store, never an
+// independent auth-file resolver. This is shared by RPC and interactive bridges.
+func (r *ModelRegistry) nativeOAuthStorage() (*ai.AuthStorage, error) {
+	if r == nil {
+		return nil, errors.New("native OAuth account storage is unavailable")
+	}
+	r.mu.RLock()
+	store, ok := r.credentialStore.(*ai.AuthStorage)
+	r.mu.RUnlock()
+	if !ok || store == nil {
+		return nil, errors.New("native OAuth account storage is unavailable")
+	}
+	return store, nil
+}
+
+func (r *ModelRegistry) OAuthAccounts(ctx context.Context) ([]ai.OAuthAccount, error) {
+	store, err := r.nativeOAuthStorage()
+	if err != nil {
+		return nil, err
+	}
+	accounts, err := store.OAuthAccounts(ctx)
+	if err != nil {
+		return nil, err
+	}
+	r.mu.RLock()
+	runtime := r.runtimeCredentials
+	r.mu.RUnlock()
+	if runtime != nil {
+		for i := range accounts {
+			if runtime.HasRuntimeAPIKey(accounts[i].Provider) {
+				accounts[i].Active = false
+			}
+		}
+	}
+	return accounts, nil
+}
+
+func (r *ModelRegistry) OAuthAccountAuth(ctx context.Context, id string) (map[string]any, error) {
+	store, err := r.nativeOAuthStorage()
+	if err != nil {
+		return nil, err
+	}
+	return store.OAuthAccountAuth(ctx, id)
+}
+
+func (r *ModelRegistry) SelectOAuthAccount(ctx context.Context, id string) error {
+	store, err := r.nativeOAuthStorage()
+	if err != nil {
+		return err
+	}
+	accounts, err := store.OAuthAccounts(ctx)
+	if err != nil {
+		return err
+	}
+	if err := store.SelectOAuthAccount(ctx, id); err != nil {
+		return err
+	}
+	r.mu.RLock()
+	runtime := r.runtimeCredentials
+	r.mu.RUnlock()
+	if runtime != nil {
+		for _, account := range accounts {
+			if account.ID == id {
+				runtime.RemoveRuntimeAPIKey(account.Provider)
+				break
+			}
+		}
+	}
+	r.Refresh()
+	return nil
+}
+
+func accountsHandler(sc *SlashContext) error {
+	if sc.OAuthAccounts == nil || sc.SelectOAuthAccount == nil {
+		return errors.New("native OAuth account management is unavailable")
+	}
+	accounts, err := sc.OAuthAccounts()
+	if err != nil {
+		return err
+	}
+	if len(accounts) == 0 {
+		sc.Append("No native OAuth accounts. Use /login openai-codex to add a Codex account.")
+		return nil
+	}
+	if strings.TrimSpace(sc.Args) == "list" {
+		var output strings.Builder
+		for _, account := range accounts {
+			marker := " "
+			if account.Active {
+				marker = "*"
+			}
+			fmt.Fprintf(&output, "%s %s: %s [%s]\n", marker, account.Provider, account.Label, account.ID)
+		}
+		if sc.AppendText != nil {
+			sc.AppendText(output.String())
+		} else {
+			sc.Append(output.String())
+		}
+		return nil
+	}
+	id := strings.TrimSpace(sc.Args)
+	if id == "" {
+		if sc.SelectAuthProvider == nil {
+			return errors.New("account selector is unavailable; use /accounts <id>")
+		}
+		options := make([]tui.OAuthProvider, 0, len(accounts))
+		for _, account := range accounts {
+			name := account.Provider + ": " + account.Label + " [" + account.ID + "]"
+			if account.Active {
+				name += " (active)"
+			}
+			options = append(options, tui.OAuthProvider{ID: account.ID, Name: name, AuthType: "oauth"})
+		}
+		picked, ok := sc.SelectAuthProvider("accounts", options, "")
+		if !ok {
+			return nil
+		}
+		id = picked.ID
+	}
+	if err := sc.SelectOAuthAccount(id); err != nil {
+		return err
+	}
+	showStatusOrAppend(sc, "Selected native OAuth account "+id)
+	return nil
+}
