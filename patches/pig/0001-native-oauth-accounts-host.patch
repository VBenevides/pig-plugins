+func TestNativeOAuthSelectedRefreshIsolation(t *testing.T) {
+	store := nativeAccountStorage(t)
+	first := nativeAccountCredential(t, "first", "one@example.test", "first-refresh", 0)
+	second := nativeAccountCredential(t, "second", "two@example.test", "second-refresh", 0)
+	id1, err := store.UpsertOAuthAccount(t.Context(), "openai-codex", first)
+	if err != nil {
+		t.Fatal(err)
+	}
+	id2, err := store.UpsertOAuthAccount(t.Context(), "openai-codex", second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := store.SelectOAuthAccount(t.Context(), id1); err != nil {
+		t.Fatal(err)
+	}
+	refreshes := 0
+	oauth := &OAuthAuth{
+		Refresh: func(_ context.Context, current Credential) (Credential, error) {
+			refreshes++
+			if current.Refresh != first.Refresh {
+				return Credential{}, errors.New("refreshed wrong account")
+			}
+			current.Refresh = "first-rotated"
+			current.Access = strings.TrimSuffix(current.Access, "signature") + "rotated"
+			current.Expires = time.Now().Add(time.Hour).UnixMilli()
+			return current, nil
+		},
+		ToAuth: func(current Credential) (ModelAuth, error) { return ModelAuth{APIKey: current.Access}, nil },
+	}
+	accounts, err := store.OAuthAccounts(t.Context())
+	if err != nil || len(accounts) != 2 || refreshes != 0 {
+		t.Fatal("enumeration refreshed credentials", err)
+	}
+	result, err := ResolveProviderAuth(t.Context(), "openai-codex", ProviderAuth{OAuth: oauth}, store, DefaultProviderAuthContext(), AuthResolutionOverrides{})
+	if err != nil || result == nil || refreshes != 1 || result.Auth.APIKey == first.Access {
+		t.Fatal("selected request was not refreshed", err)
+	}
+	unchanged, err := store.OAuthAccountAuth(t.Context(), id2)
+	if err != nil || unchanged["access"] != second.Access {
+		t.Fatal("refresh overwrote neighboring account", err)
+	}
+	selected, err := store.Read(t.Context(), "openai-codex")
+	if err != nil || selected == nil || selected.Refresh != "first-rotated" {
+		t.Fatal("rotated credential was not persisted", err)
+	}
+	if _, err := ResolveProviderAuth(t.Context(), "openai-codex", ProviderAuth{OAuth: oauth}, store, DefaultProviderAuthContext(), AuthResolutionOverrides{}); err != nil || refreshes != 1 {
+		t.Fatal("valid token was refreshed again", err)
+	}
+}
