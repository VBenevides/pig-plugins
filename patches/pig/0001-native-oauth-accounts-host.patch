+	accounts, err = reopened.OAuthAccounts(ctx)
+	if err != nil || len(accounts) != 1 || accounts[0].ID != id1 || accounts[0].Active {
+		t.Fatal("logout removed another account or switched accounts", err)
+	}
+	selected, err = reopened.Read(ctx, "openai-codex")
+	if err != nil || selected != nil {
+		t.Fatal("logout left request auth selected", err)
+	}
+	if err := reopened.SelectOAuthAccount(ctx, id1); err != nil {
+		t.Fatal(err)
+	}
