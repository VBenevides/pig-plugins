+++ b/ai/oauth_accounts_test.go
@@ -0,0 +1,437 @@
+package ai
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func nativeAccountCredential(t *testing.T, account, email, refresh string, expires int64) Credential {
+	t.Helper()
+	payload, err := json.Marshal(map[string]any{"https://api.openai.com/auth": map[string]string{"chatgpt_account_id": account}, "https://api.openai.com/profile": map[string]string{"email": email}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return Credential{Type: CredentialOAuth, AccountID: account, Access: "header." + base64.RawURLEncoding.EncodeToString(payload) + ".signature", Refresh: refresh, Expires: expires}
+}
+
+func nativeAccountStorage(t *testing.T) *AuthStorage {
+	t.Helper()
+	store, err := NewAuthStorage(filepath.Join(t.TempDir(), "auth.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return store
+}
+
+func TestNativeOAuthTwoAccountLifecycle(t *testing.T) {
+	ctx := t.Context()
+	store := nativeAccountStorage(t)
+	expires := time.Now().Add(time.Hour).UnixMilli()
+	first := nativeAccountCredential(t, "shared-workspace", "one@example.test", "first-refresh", expires)
+	second := nativeAccountCredential(t, "shared-workspace", "two@example.test", "second-refresh", expires)
+	id1, err := store.UpsertOAuthAccount(ctx, "openai-codex", first)
+	if err != nil {
+		t.Fatal(err)
+	}
+	id2, err := store.UpsertOAuthAccount(ctx, "openai-codex", second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if id1 == id2 {
+		t.Fatal("distinct user identities were merged")
+	}
+	first.Refresh = "first-relogin"
+	if id, err := store.UpsertOAuthAccount(ctx, "openai-codex", first); err != nil || id != id1 {
+		t.Fatal("relogin did not upsert the same durable identity", err)
+	}
+	if err := store.SelectOAuthAccount(ctx, id2); err != nil {
+		t.Fatal(err)
+	}
+	reopened, err := NewAuthStorage(store.Path())
+	if err != nil {
+		t.Fatal(err)
+	}
+	accounts, err := reopened.OAuthAccounts(ctx)
+	if err != nil || len(accounts) != 2 {
+		t.Fatal("accounts did not survive restart", err)
+	}
+	active := 0
+	for _, account := range accounts {
+		if account.Active {
+			active++
+			if account.ID != id2 {
+				t.Fatal("selection did not survive restart")
+			}
+		}
+	}
+	if active != 1 {
+		t.Fatal("invalid active account count")
+	}
+	metadata, err := json.Marshal(accounts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(metadata), "signature") || strings.Contains(string(metadata), "refresh") || strings.Contains(string(metadata), "shared-workspace") {
+		t.Fatal("enumeration exposed credential values")
+	}
+	selected, err := reopened.Read(ctx, "openai-codex")
+	if err != nil || selected == nil || selected.Refresh != second.Refresh {
+		t.Fatal("request credential did not match selection", err)
+	}
+	quota, err := reopened.OAuthAccountAuth(ctx, id2)
+	if err != nil || quota["access"] != selected.Access || quota["accountId"] != selected.AccountID {
+		t.Fatal("quota credential did not match request credential", err)
