+package ai
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+	"testing/synctest"
+
+	"github.com/MichaelKinsy/PiG/internal/pilock"
+)
+
+func TestNativeOAuthRefreshAndSelectSerialize(t *testing.T) {
+	store := nativeAccountStorage(t)
+	first := nativeAccountCredential(t, "first", "one@example.test", "first-refresh", 0)
+	second := nativeAccountCredential(t, "second", "two@example.test", "second-refresh", 0)
+	id1, err := store.UpsertOAuthAccount(t.Context(), "openai-codex", first)
+	if err != nil {
+		t.Fatal(err)
+	}
+	id2, err := store.UpsertOAuthAccount(t.Context(), "openai-codex", second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := store.SelectOAuthAccount(t.Context(), id1); err != nil {
+		t.Fatal(err)
+	}
+	started := make(chan struct{})
+	release := make(chan struct{})
+	refreshed := make(chan error, 1)
+	go func() {
+		_, err := store.Modify(t.Context(), "openai-codex", func(current *Credential) (*Credential, error) {
+			close(started)
+			<-release
+			current.Refresh = "first-rotated"
+			return current, nil
+		})
+		refreshed <- err
+	}()
+	<-started
+	// A separate instance must use the same cross-process account lock.
+	other, err := NewAuthStorage(store.Path())
+	if err != nil {
+		close(release)
+		t.Fatal(err)
+	}
+	cancelled, cancel := context.WithCancel(t.Context())
+	cancel()
+	if err := other.SelectOAuthAccount(cancelled, id2); !errors.Is(err, context.Canceled) {
+		close(release)
+		t.Fatal("cancelled selection did not stop", err)
+	}
+	selected := make(chan error, 1)
+	go func() { selected <- other.SelectOAuthAccount(t.Context(), id2) }()
+	close(release)
+	if err := <-refreshed; err != nil {
+		t.Fatal(err)
+	}
+	if err := <-selected; err != nil {
+		t.Fatal(err)
+	}
+	current, err := store.Read(t.Context(), "openai-codex")
+	if err != nil || current == nil || current.Refresh != second.Refresh {
+		t.Fatal("selection did not observe refreshed transaction", err)
+	}
+	if err := store.SelectOAuthAccount(t.Context(), id1); err != nil {
+		t.Fatal(err)
+	}
+	current, err = store.Read(t.Context(), "openai-codex")
+	if err != nil || current == nil || current.Refresh != "first-rotated" {
+		t.Fatal("selection lost the previous account refresh", err)
+	}
+}
+
+func TestNativeOAuthAccountLimit(t *testing.T) {
+	data := &oauthAccountData{Version: 1, LegacyMigrated: true, Migrated: map[string]bool{}, Selected: map[string]string{}, Accounts: []oauthAccountRecord{}}
+	for i := range oauthAccountsMaxCount {
+		credential := nativeAccountCredential(t, fmt.Sprintf("account-%d", i), fmt.Sprintf("user%d@example.test", i), "fixture", 0)
+		if _, err := upsertOAuthAccount(data, "openai-codex", credential); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := upsertOAuthAccount(data, "openai-codex", nativeAccountCredential(t, "extra", "extra@example.test", "fixture", 0)); err == nil {
+		t.Fatal("account limit was not enforced")
+	}
+	if len(data.Accounts) != oauthAccountsMaxCount {
+		t.Fatal("failed account insertion changed records")
+	}
+}
+
+func TestNativeOAuthRejectsMalformedLegacyWithoutWritingAccounts(t *testing.T) {
+	store := nativeAccountStorage(t)
+	malformed := []byte(`{"openai-codex":`)
+	if err := os.WriteFile(store.Path(), malformed, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := store.OAuthAccounts(t.Context()); err == nil {
+		t.Fatal("malformed legacy store was accepted")
+	}
+	if _, err := os.Stat(store.OAuthAccountsPath()); !errors.Is(err, os.ErrNotExist) {
+		t.Fatal("failed migration created an account store", err)
+	}
+	preserved, err := os.ReadFile(store.Path())
+	if err != nil || !bytes.Equal(preserved, malformed) {
+		t.Fatal("failed migration changed legacy bytes", err)
+	}
+}
+
+func TestNativeOAuthAccountStoreRejectsSymlink(t *testing.T) {
+	store := nativeAccountStorage(t)
+	outside := filepath.Join(t.TempDir(), "outside.json")
+	original := []byte("outside fixture")
+	if err := os.WriteFile(outside, original, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, store.OAuthAccountsPath()); err != nil {
+		t.Skip("symlink unavailable", err)
+	}
+	if _, err := store.OAuthAccounts(t.Context()); err == nil {
+		t.Fatal("symlink account store was accepted")
+	}
+	preserved, err := os.ReadFile(outside)
+	if err != nil || !bytes.Equal(preserved, original) {
+		t.Fatal("symlink target changed", err)
+	}
+}
+
+func TestNativeOAuthAPIKeyLoginRetainsAccounts(t *testing.T) {
+	store := nativeAccountStorage(t)
+	id, err := store.UpsertOAuthAccount(t.Context(), "openai-codex", nativeAccountCredential(t, "account", "one@example.test", "refresh", 0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := StoreLoginCredential(t.Context(), NewRuntimeCredentials(store), "openai-codex", Credential{Type: CredentialAPIKey, Key: "fixture-key"}); err != nil {
+		t.Fatal(err)
+	}
+	current, err := store.Read(t.Context(), "openai-codex")
+	if err != nil || current == nil || current.Type != CredentialAPIKey {
+		t.Fatal("API-key login did not replace request auth", err)
+	}
+	accounts, err := store.OAuthAccounts(t.Context())
+	if err != nil || len(accounts) != 1 || accounts[0].Active {
+		t.Fatal("API-key login discarded OAuth accounts", err)
+	}
+	if err := store.Delete(t.Context(), "openai-codex"); err != nil {
+		t.Fatal(err)
+	}
+	current, err = store.Read(t.Context(), "openai-codex")
+	if err != nil || current != nil {
+		t.Fatal("API-key logout did not remove singleton key", err)
+	}
+	if err := store.SelectOAuthAccount(t.Context(), id); err != nil {
+		t.Fatal(err)
+	}
+	current, err = store.Read(t.Context(), "openai-codex")
+	if err != nil || current == nil || current.Type != CredentialOAuth {
+		t.Fatal("retained OAuth account could not be selected", err)
+	}
+}
+
+func TestNativeOAuthImportsLaterSingletonWithoutResurrection(t *testing.T) {
+	store := nativeAccountStorage(t)
+	if accounts, err := store.OAuthAccounts(t.Context()); err != nil || len(accounts) != 0 {
+		t.Fatal("empty initial store failed", err)
+	}
+	credential := nativeAccountCredential(t, "later", "later@example.test", "later-refresh", 0)
+	// A legacy writer can add a previously unseen provider after startup.
+	if _, err := store.Modify(t.Context(), "openai-codex", func(*Credential) (*Credential, error) { return &credential, nil }); err != nil {
+		t.Fatal(err)
+	}
+	accounts, err := store.OAuthAccounts(t.Context())
+	if err != nil || len(accounts) != 1 {
+		t.Fatal("later singleton was not imported", err)
+	}
+	if err := store.Delete(t.Context(), "openai-codex"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := store.Modify(t.Context(), "other", func(*Credential) (*Credential, error) {
+		return &Credential{Type: CredentialAPIKey, Key: "fixture"}, nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	accounts, err = store.OAuthAccounts(t.Context())
+	if err != nil || len(accounts) != 0 {
+		t.Fatal("legacy revision change resurrected a deleted account", err)
+	}
+}
+
+func TestNativeOAuthOperationsHonorHeldLegacyLock(t *testing.T) {
+	for _, operation := range []string{"read", "list", "modify", "delete", "accounts", "select", "accountAuth"} {
+		t.Run(operation, func(t *testing.T) {
+			synctest.Test(t, func(t *testing.T) {
+				store := nativeAccountStorage(t)
+				id, err := store.UpsertOAuthAccount(t.Context(), "openai-codex", nativeAccountCredential(t, "one", "one@example.test", "refresh", 0))
+				if err != nil {
+					t.Fatal(err)
+				}
+				before, err := os.ReadFile(store.OAuthAccountsPath())
+				if err != nil {
+					t.Fatal(err)
+				}
+				legacyLock, err := pilock.Acquire(t.Context(), store.Path())
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer func() {
+					if err := legacyLock.Release(); err != nil {
+						t.Error(err)
+					}
+				}()
+				ctx, cancel := context.WithCancelCause(t.Context())
+				defer cancel(nil)
+				cause := errors.New("cancel native operation waiting for legacy lock")
+				done := make(chan error, 1)
+				called := false
+				go func() {
+					var err error
+					switch operation {
+					case "read":
+						_, err = store.Read(ctx, "openai-codex")
+					case "list":
+						_, err = store.List(ctx)
+					case "modify":
+						_, err = store.Modify(ctx, "openai-codex", func(current *Credential) (*Credential, error) {
+							called = true
+							current.Refresh = "should-not-commit"
+							return current, nil
+						})
+					case "delete":
+						err = store.Delete(ctx, "openai-codex")
+					case "accounts":
+						_, err = store.OAuthAccounts(ctx)
+					case "select":
+						err = store.SelectOAuthAccount(ctx, id)
+					case "accountAuth":
+						_, err = store.OAuthAccountAuth(ctx, id)
+					}
+					done <- err
+				}()
+				synctest.Wait()
+				cancel(cause)
+				if err := <-done; !errors.Is(err, cause) {
+					t.Errorf("operation ignored held legacy lock: %v", err)
+				}
+				if called {
+					t.Error("cancelled native modifier ran its callback")
+				}
+				after, err := os.ReadFile(store.OAuthAccountsPath())
+				if err != nil || !bytes.Equal(before, after) {
+					t.Error("cancelled operation changed native credentials", err)
+				}
+			})
+		})
+	}
+}
diff --git a/ai/oauth_accounts_test.go b/ai/oauth_accounts_test.go
