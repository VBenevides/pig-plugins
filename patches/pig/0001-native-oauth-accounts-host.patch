+func accountRegistryFixture(t *testing.T) (*ModelRegistry, *ai.AuthStorage, []string) {
+	t.Helper()
+	dir := t.TempDir()
+	store, err := ai.NewAuthStorage(filepath.Join(dir, "auth.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	ids := []string{}
+	for _, email := range []string{"one@example.test", "two@example.test"} {
+		payload, err := json.Marshal(map[string]any{"https://api.openai.com/auth": map[string]string{"chatgpt_account_id": email}, "email": email})
+		if err != nil {
+			t.Fatal(err)
+		}
+		credential := ai.Credential{Type: ai.CredentialOAuth, Access: "header." + base64.RawURLEncoding.EncodeToString(payload) + ".signature", AccountID: email, Refresh: "fixture-refresh", Expires: time.Now().Add(time.Hour).UnixMilli()}
+		id, err := store.UpsertOAuthAccount(t.Context(), "openai-codex", credential)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ids = append(ids, id)
+	}
+	registry := NewModelRegistry(dir)
+	registry.SetAuthStorage(store)
+	return registry, store, ids
+}
