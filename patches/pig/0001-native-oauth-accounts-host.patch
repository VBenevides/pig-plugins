+func (b *UIBridge) handleOAuthAccounts(ctx context.Context, actions *HostCallbacks, method string, args json.RawMessage) (*CallResultPayload, error) {
+	extension.CallInitiated(ctx)
+	if actions == nil {
+		return nil, errors.New("native OAuth account actions are unavailable")
+	}
+	var value any
+	var err error
+	if method == "oauthAccounts" {
+		if actions.OAuthAccounts == nil {
+			return nil, errors.New("native OAuth account enumeration is unavailable")
+		}
+		value, err = actions.OAuthAccounts(ctx)
+	} else {
+		var params struct {
+			ID string `json:"id"`
+		}
+		if json.Unmarshal(args, &params) != nil || params.ID == "" {
+			return nil, errors.New("native OAuth account ID is required")
+		}
+		switch method {
+		case "oauthAccountAuth":
+			if actions.OAuthAccountAuth == nil {
+				return nil, errors.New("native OAuth credential read is unavailable")
+			}
+			value, err = actions.OAuthAccountAuth(ctx, params.ID)
+		case "selectOAuthAccount":
+			if actions.SelectOAuthAccount == nil {
+				return nil, errors.New("native OAuth account selection is unavailable")
+			}
+			err = actions.SelectOAuthAccount(ctx, params.ID)
+		}
+	}
+	if err != nil {
+		return nil, err
+	}
+	result, err := json.Marshal(value)
+	if err != nil {
+		return nil, err
+	}
+	return &CallResultPayload{Result: result}, nil
+}
