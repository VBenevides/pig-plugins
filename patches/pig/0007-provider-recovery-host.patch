+++ b/ai/codex_normal_close_retry_test.go
@@ -0,0 +1,69 @@
+package ai
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+)
+
+func TestCodexNormalCloseBeforeCompletionRetriesOverSSE(t *testing.T) {
+	for _, partialTool := range []bool{false, true} {
+		t.Run(map[bool]string{false: "after response created", true: "during tool arguments"}[partialTool], func(t *testing.T) {
+			defer CloseOpenAICodexWebSocketSessions()
+			var wsRequests, sseRequests atomic.Int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method == http.MethodPost {
+					sseRequests.Add(1)
+					w.Header().Set("Content-Type", "text/event-stream")
+					_, _ = w.Write([]byte(reviewSSEDone))
+					return
+				}
+				connection, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+				if err != nil {
+					return
+				}
+				defer connection.Close()
+				if _, _, err := connection.ReadMessage(); err != nil {
+					return
+				}
+				wsRequests.Add(1)
+				_ = connection.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.created","response":{"id":"resp_interrupted"}}`))
+				if partialTool {
+					_ = connection.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.output_item.added","output_index":0,"item":{"type":"function_call","id":"fc_edit","call_id":"call_edit","name":"edit","arguments":""}}`))
+					_ = connection.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.function_call_arguments.delta","output_index":0,"delta":"{\"path\":"}`))
+				}
+				_ = connection.WriteControl(websocket.CloseMessage, websocket.FormatCloseMessage(websocket.CloseNormalClosure, "server closed"), time.Now().Add(time.Second))
+			}))
+			defer server.Close()
+			provider := reviewCodexProvider(t, server.URL, "close-account")
+			options := StreamOptions{Transport: TransportAuto, SessionID: t.Name(), TimeoutMs: new(1000)}
+			var first *AssistantMessage
+			result, err := RetryAssistantCall(t.Context(), func() (AssistantMessage, error) {
+				stream, err := provider.Stream(context.Background(), reviewCodexCtx("edit a file"), options)
+				if err != nil {
+					return AssistantMessage{}, err
+				}
+				message := stream.Result()
+				if first == nil {
+					first = message
+				}
+				return *message, nil
+			}, &RetryPolicy{Enabled: true, MaxRetries: 1, BaseDelayMs: 1}, RetryCallbacks{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if first.StopReason != StopReasonError || !strings.Contains(first.ErrorMessage, "1000") {
+				t.Fatalf("interruption was hidden: %+v", first)
+			}
+			if result.StopReason != StopReasonStop || wsRequests.Load() != 1 || sseRequests.Load() != 1 {
+				t.Fatalf("stop=%s error=%s websocket=%d SSE=%d; want bounded SSE recovery", result.StopReason, result.ErrorMessage, wsRequests.Load(), sseRequests.Load())
+			}
+		})
+	}
+}
