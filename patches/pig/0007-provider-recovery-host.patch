@@ -0,0 +1,50 @@
+package coding
+
+import (
+	"testing"
+	"time"
+
+	"github.com/MichaelKinsy/PiG/agent"
+	"github.com/MichaelKinsy/PiG/ai"
+	"github.com/MichaelKinsy/PiG/coding/extension"
+)
+
+func TestWebSocketCloseRecoveryPreservesCompletedTools(t *testing.T) {
+	for _, interruptedTool := range []bool{false, true} {
+		t.Run(map[bool]string{false: "after completed edit", true: "partial next edit"}[interruptedTool], func(t *testing.T) {
+			tool := &retryEchoTool{}
+			failure := func([]ai.Message) *ai.AssistantMessage {
+				message := &ai.AssistantMessage{Provider: "faux", Model: "faux-1", StopReason: ai.StopReasonError, ErrorMessage: "websocket: close 1000 (normal): server closed", Timestamp: time.Now().UnixMilli()}
+				if interruptedTool {
+					message.Content = []ai.AssistantContentBlock{ai.ToolCall{ID: "partial", Name: "echo", Arguments: ai.JsonObject{"text": "must not execute"}}}
+				}
+				return message
+			}
+			h := newRetryEventsHarness(t, `{"retry":{"enabled":true,"maxRetries":1,"baseDelayMs":1}}`, extension.Extension{}, []agent.AgentTool{tool},
+				fauxToolCallOnly("echo", ai.JsonObject{"text": "completed edit"}), failure, fauxReply("recovered", ai.StopReasonStop, 0))
+			if _, err := h.session.Prompt(t.Context(), "edit", nil); err != nil {
+				t.Fatal(err)
+			}
+			if runs := tool.ran(); len(runs) != 1 || runs[0] != "completed edit" {
+				t.Fatalf("tool runs = %v", runs)
+			}
+			if last := h.session.LastAssistantText(); last == nil || *last != "recovered" {
+				t.Fatalf("did not recover: %v", last)
+			}
+			if got := h.provider.callCount(); got != 3 {
+				t.Fatalf("requests=%d, want edit, failed continuation, retry", got)
+			}
+		})
+	}
+}
+
+func TestWebSocketCloseRetryBudgetIsBounded(t *testing.T) {
+	failure := func([]ai.Message) *ai.AssistantMessage {
+		return &ai.AssistantMessage{Provider: "faux", Model: "faux-1", StopReason: ai.StopReasonError, ErrorMessage: "websocket: close 1000 (normal)", Timestamp: time.Now().UnixMilli()}
+	}
+	h := newRetryEventsHarness(t, `{"retry":{"enabled":true,"maxRetries":1,"baseDelayMs":1}}`, extension.Extension{}, nil, failure, failure)
+	_, _ = h.session.Prompt(t.Context(), "continue", nil)
+	if got := h.provider.callCount(); got != 2 {
+		t.Fatalf("requests=%d, want initial and one retry", got)
+	}
+}
