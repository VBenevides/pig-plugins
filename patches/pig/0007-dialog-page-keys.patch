+// dialogOwnsPageKey reports whether data is a page key that an open extension dialog handles itself.
+func (m *InteractiveMode) dialogOwnsPageKey(data string) bool {
+	if m.extensionDialog == nil {
+		return false
+	}
+	kb := tui.GetTUIKeybindings()
+	return kb.Matches(data, tui.KBSelectPageUp) || kb.Matches(data, tui.KBSelectPageDown)
+}
