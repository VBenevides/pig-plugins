Preserve registered extension OAuth flows in the login menu.

The model registry can expose an API-key-only composition for a legacy
subprocess provider even though its OAuth flow is registered globally.
Do not let that composition remove the extension's account login option.

diff --git a/internal/codingagent/interactive_login.go b/internal/codingagent/interactive_login.go
--- a/internal/codingagent/interactive_login.go
+++ b/internal/codingagent/interactive_login.go
@@ -18,14 +18,21 @@
-func (m *InteractiveMode) providerAuth(id string) ai.ProviderAuth {
-	if m.opts.Llama != nil && m.opts.Llama.Provider().ID == id {
-		return ai.ProviderAuth{APIKey: llamaAPIKeyAuth(m.opts.Llama.Provider())}
-	}
-	if registry := m.opts.ModelRegistry; registry != nil {
-		if provider := registry.GetProvider(id); provider != nil {
-			return provider.Auth
-		}
-		auth, _, _ := registry.registryAuthConfig(id)
-		return auth
-	}
-	auth, _ := ai.BuiltinProviderAuth(id)
-	return auth
+func (m *InteractiveMode) providerAuth(id string) (result ai.ProviderAuth) {
+	defer func() {
+		// Legacy subprocess OAuth flows are registered separately from the
+		// model registry's provider composition. Preserve their login method.
+		if result.OAuth == nil {
+			result.OAuth, _ = ai.OAuthProviderAuth(id)
+		}
+	}()
+	if m.opts.Llama != nil && m.opts.Llama.Provider().ID == id {
+		return ai.ProviderAuth{APIKey: llamaAPIKeyAuth(m.opts.Llama.Provider())}
+	}
+	if registry := m.opts.ModelRegistry; registry != nil {
+		if provider := registry.GetProvider(id); provider != nil {
+			return provider.Auth
+		}
+		auth, _, _ := registry.registryAuthConfig(id)
+		return auth
+	}
+	auth, _ := ai.BuiltinProviderAuth(id)
+	return auth
 }
diff --git a/internal/codingagent/extension_oauth_login_menu_test.go b/internal/codingagent/extension_oauth_login_menu_test.go
new file mode 100644
--- /dev/null
+++ b/internal/codingagent/extension_oauth_login_menu_test.go
@@ -0,0 +1,25 @@
+package codingagent
+
+import (
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/ai"
+	"github.com/MichaelKinsy/PiG/coding/extension"
+)
+
+func TestExtensionOAuthAccountRemainsInLoginMenu(t *testing.T) {
+	flow := &initiationCaptureOAuthProvider{}
+	ai.RegisterOAuthProvider(flow.ID(), flow)
+	t.Cleanup(func() { ai.UnregisterOAuthProvider(flow.ID()) })
+	registry := NewModelRegistry(t.TempDir())
+	if err := registry.RegisterProvider(flow.ID(), extension.ProviderConfig{BaseURL: "https://example.test", OAuth: &extension.ProviderOAuth{Name: flow.Name()}}); err != nil {
+		t.Fatal(err)
+	}
+	mode := NewInteractiveMode(InteractiveOptions{AgentDir: t.TempDir(), ModelRegistry: registry})
+	for _, option := range mode.getLoginProviderOptions(false) {
+		if option.ID == flow.ID() && option.AuthType == "oauth" {
+			return
+		}
+	}
+	t.Fatal("registered extension OAuth flow missing from account login options")
+}
