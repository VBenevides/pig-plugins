 	return lines
 }
 
+// extensionSelectorBodyRows is the most title and description rows shown at once (pig additive).
+// A longer body scrolls with the page keys instead of growing past the screen.
+const extensionSelectorBodyRows = 12
+
+// scrollBody shows at most extensionSelectorBodyRows rows of body, from e.bodyScroll, and a status row with the range.
+func (e *ExtensionSelectorComponent) scrollBody(body []string, text func(string) []string) []string {
+	if len(body) <= extensionSelectorBodyRows {
+		e.bodyScroll = 0
+		return body
+	}
+	e.bodyScroll = max(0, min(e.bodyScroll, len(body)-extensionSelectorBodyRows))
+	end := e.bodyScroll + extensionSelectorBodyRows
+	visible := append([]string(nil), body[e.bodyScroll:end]...)
+	status := "lines " + strconv.Itoa(e.bodyScroll+1) + "-" + strconv.Itoa(end) + " of " + strconv.Itoa(len(body)) +
+		"  " + extKeyHint("pgup/pgdn", "scroll")
+	return append(visible, text(ActiveTheme().FgText("muted", status))...)
+}
