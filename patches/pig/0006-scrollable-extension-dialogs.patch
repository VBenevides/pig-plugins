 // HandleInput resolves expansion, navigation, confirmation and cancellation in that order. Empty options do not complete the selector.
 func (e *ExtensionSelectorComponent) HandleInput(data string) {
 	if e.done {
@@ -165,6 +185,10 @@ func (e *ExtensionSelectorComponent) HandleInput(data string) {
 		if e.onToggleToolsExpanded != nil {
 			e.onToggleToolsExpanded()
 		}
+	case kb.Matches(data, KBSelectPageUp):
+		e.bodyScroll = max(0, e.bodyScroll-extensionSelectorBodyRows)
+	case kb.Matches(data, KBSelectPageDown):
+		e.bodyScroll += extensionSelectorBodyRows // Render clamps to the last page
 	case kb.Matches(data, KBSelectUp) || data == "k":
 		e.cursor = max(0, e.cursor-1)
 		e.updateList()
