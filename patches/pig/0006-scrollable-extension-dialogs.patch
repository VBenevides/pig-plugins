+
+func TestExtensionSelectorLongBodyHasFixedHeightAndScrolls(t *testing.T) {
+	var rows []string
+	for i := 1; i <= 40; i++ {
+		rows = append(rows, "row"+strconv.Itoa(i)+"x")
+	}
+	sel := NewExtensionSelector(strings.Join(rows, "\n"), []string{"Deny", "Allow once"})
+	first := sel.Render(80)
+	joined := strings.Join(first, "\n")
+	if !strings.Contains(joined, "row1x") || strings.Contains(joined, "row13x") || !strings.Contains(joined, "of 40") {
+		t.Fatalf("first page wrong:\n%s", joined)
+	}
+	sel.HandleInput("\x1b[6~") // pageDown
+	next := sel.Render(80)
+	if len(next) != len(first) {
+		t.Fatalf("height changed: %d -> %d", len(first), len(next))
+	}
+	if j := strings.Join(next, "\n"); !strings.Contains(j, "row13x") || strings.Contains(j, "row1x") {
+		t.Fatalf("second page wrong:\n%s", j)
+	}
+	for i := 0; i < 10; i++ {
+		sel.HandleInput("\x1b[6~")
+	}
+	if j := strings.Join(sel.Render(80), "\n"); !strings.Contains(j, "row40x") || !strings.Contains(j, "29-40 of 40") {
+		t.Fatalf("last page wrong:\n%s", j)
+	}
+	sel.HandleInput("\x1b[5~") // pageUp
+	if j := strings.Join(sel.Render(80), "\n"); !strings.Contains(j, "17-28 of 40") {
+		t.Fatalf("pageUp wrong:\n%s", j)
+	}
+	if sel.Done() {
+		t.Fatal("scrolling must not complete the selector")
+	}
+}
