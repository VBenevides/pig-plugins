@@ -0,0 +1,103 @@
+package pigletbuild
+
+import (
+	"archive/zip"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path/filepath"
+
+	"github.com/MichaelKinsy/PiG/coding/extension/host/cellpack"
+	"github.com/MichaelKinsy/PiG/coding/extension/host/subprocess"
+)
+
+// pig additive (D20): interpreted Node cells carry their selected source bytes,
+// while the host supplies its existing loader and the target supplies Node.
+func buildNodeSourceCell(cell subprocess.CellSpec, cacheRoot string, host Target) (stagedCell, error) {
+	file, err := os.CreateTemp(cacheRoot, "node-sources-*.zip")
+	if err != nil {
+		return stagedCell{}, err
+	}
+	defer file.Close()
+	archive := zip.NewWriter(file)
+	extensions := make([]cellpack.ExtEntry, 0, len(cell.Extensions))
+	var size int64
+	for _, cfg := range cell.Extensions {
+		if !fs.ValidPath(cfg.Name) || filepath.Base(cfg.Name) != cfg.Name {
+			return stagedCell{}, fmt.Errorf("invalid Node member name %q", cfg.Name)
+		}
+		info, err := os.Stat(cfg.Source)
+		if err != nil {
+			return stagedCell{}, err
+		}
+		root := cfg.Source
+		if !info.IsDir() {
+			root = filepath.Dir(root)
+		}
+		err = filepath.WalkDir(root, func(path string, entry fs.DirEntry, walkErr error) error {
+			if walkErr != nil {
+				return walkErr
+			}
+			if entry.IsDir() {
+				if path != root && (entry.Name() == ".git" || entry.Name() == "node_modules") {
+					return filepath.SkipDir
+				}
+				return nil
+			}
+			info, err := entry.Info()
+			if err != nil {
+				return err
+			}
+			if !info.Mode().IsRegular() {
+				return fmt.Errorf("Node source %s is not a regular file", path)
+			}
+			size += info.Size()
+			if size > 64<<20 {
+				return fmt.Errorf("Node cell %q exceeds 64 MiB", cell.Key)
+			}
+			relative, err := filepath.Rel(root, path)
+			if err != nil {
+				return err
+			}
+			writer, err := archive.Create(cfg.Name + "/" + filepath.ToSlash(relative))
+			if err != nil {
+				return err
+			}
+			source, err := os.Open(path)
+			if err != nil {
+				return err
+			}
+			_, copyErr := io.Copy(writer, io.LimitReader(source, info.Size()+1))
+			closeErr := source.Close()
+			if copyErr != nil {
+				return copyErr
+			}
+			return closeErr
+		})
+		if err != nil {
+			return stagedCell{}, err
+		}
+		extensions = append(extensions, cellpack.ExtEntry{Name: cfg.Name, Hash: cfg.ContentHash})
+	}
+	if err := archive.Close(); err != nil {
+		return stagedCell{}, err
+	}
+	if _, err := file.Seek(0, io.SeekStart); err != nil {
+		return stagedCell{}, err
+	}
+	digest := sha256.New()
+	if _, err := io.Copy(digest, file); err != nil {
+		return stagedCell{}, err
+	}
+	return stagedCell{
+		entry: cellpack.CellEntry{
+			Language: "node", Key: cell.Key, Strategy: string(subprocess.CellStrategyPackedNode),
+			OS: host.OS, Arch: host.Arch, Extensions: extensions,
+			Binary: "node/" + hex.EncodeToString(digest.Sum(nil)) + ".zip",
+		},
+		binaryPath: file.Name(),
+	}, nil
+}
