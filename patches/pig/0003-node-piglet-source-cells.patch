+package pigletbuild
+
+import (
+	"archive/zip"
+	"io"
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/coding/extension/host/subprocess"
+)
+
+func TestNodeSourceCellPackagesRelativeImports(t *testing.T) {
+	source := t.TempDir()
+	if err := os.Mkdir(filepath.Join(source, "src"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	for name, contents := range map[string]string{
+		"index.ts":      "import './src/helper.ts'; export default function () {}",
+		"src/helper.ts": "export const value = 42;",
+	} {
+		if err := os.WriteFile(filepath.Join(source, name), []byte(contents), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	cell := subprocess.CellSpec{Key: "node:test", Extensions: []subprocess.ExtConfig{{Name: "viewer", Source: source}}}
+	built, err := buildNodeSourceCell(cell, t.TempDir(), Target{OS: runtime.GOOS, Arch: runtime.GOARCH})
+	if err != nil {
+		t.Fatal(err)
+	}
+	archive, err := zip.OpenReader(built.binaryPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer archive.Close()
+	file, err := archive.Open("viewer/src/helper.ts")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer file.Close()
+	data, err := io.ReadAll(file)
+	if err != nil || string(data) != "export const value = 42;" {
+		t.Fatalf("relative import = %q, error = %v", data, err)
+	}
+	if built.entry.Language != "node" || built.entry.Strategy != string(subprocess.CellStrategyPackedNode) {
+		t.Fatalf("entry = %#v", built.entry)
+	}
+}
--- a/coding/extension/host/cellpack/node_sources.go
+++ b/coding/extension/host/cellpack/node_sources.go
@@ -0,0 +1,58 @@
+package cellpack
+
+import (
+	"archive/zip"
+	"bytes"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path/filepath"
+)
+
+func extractNodeSources(data []byte, dest string) error {
+	archive, err := zip.NewReader(bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		return err
+	}
+	if len(archive.File) > 8192 {
+		return fmt.Errorf("Node source archive exceeds 8192 files")
+	}
+	seen := make(map[string]bool, len(archive.File))
+	var total uint64
+	for _, file := range archive.File {
+		if !fs.ValidPath(file.Name) || !file.Mode().IsRegular() || seen[file.Name] {
+			return fmt.Errorf("invalid Node source archive member %q", file.Name)
+		}
+		seen[file.Name] = true
+		if file.UncompressedSize64 > 64<<20 || total > (64<<20)-file.UncompressedSize64 {
+			return fmt.Errorf("Node source archive exceeds 64 MiB")
+		}
+		total += file.UncompressedSize64
+	}
+	for _, file := range archive.File {
+		reader, err := file.Open()
+		if err != nil {
+			return err
+		}
+		contents, readErr := io.ReadAll(io.LimitReader(reader, int64(file.UncompressedSize64)+1))
+		closeErr := reader.Close()
+		if readErr != nil {
+			return readErr
+		}
+		if closeErr != nil {
+			return closeErr
+		}
+		if uint64(len(contents)) != file.UncompressedSize64 {
+			return fmt.Errorf("Node source member %q has invalid size", file.Name)
+		}
+		out := filepath.Join(dest, filepath.FromSlash(file.Name))
+		if err := os.MkdirAll(filepath.Dir(out), 0o755); err != nil {
+			return err
+		}
+		if err := atomicWriteFile(out, contents, 0o644); err != nil {
+			return err
+		}
+	}
+	return nil
+}
