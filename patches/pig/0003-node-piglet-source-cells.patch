@@ -0,0 +1,43 @@
+package cellpack
+
+import (
+	"archive/zip"
+	"bytes"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestNodeSourceExtraction(t *testing.T) {
+	for _, name := range []string{"preview/index.ts", "../escape.ts", "preview/../../escape.ts"} {
+		t.Run(name, func(t *testing.T) {
+			var data bytes.Buffer
+			archive := zip.NewWriter(&data)
+			file, err := archive.Create(name)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err := file.Write([]byte("export default function () {}")); err != nil {
+				t.Fatal(err)
+			}
+			if err := archive.Close(); err != nil {
+				t.Fatal(err)
+			}
+			dest := t.TempDir()
+			err = extractNodeSources(data.Bytes(), dest)
+			if name != "preview/index.ts" {
+				if err == nil {
+					t.Fatal("accepted escaping archive path")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			content, err := os.ReadFile(filepath.Join(dest, "preview", "index.ts"))
+			if err != nil || string(content) != "export default function () {}" {
+				t.Fatalf("extracted source = %q, error = %v", content, err)
+			}
+		})
+	}
+}
