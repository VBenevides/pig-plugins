diff --git a/tui/interaction_pages.go b/tui/interaction_pages.go
new file mode 100644
index 0000000..74ca2e9
--- /dev/null
+++ b/tui/interaction_pages.go
@@ -0,0 +1,179 @@
+package tui
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/MichaelKinsy/PiG/tui/widthx"
+	pigplugins "github.com/VBenevides/pig-plugins"
+)
+
+// InteractionPages selects a display-only slice of a transcript. The source
+// retains every component; session records and model messages are not changed.
+type InteractionPages struct {
+	source      *Container
+	body        *Container
+	startup     []Component
+	version     uint64
+	initialized bool
+	children    []Component
+	starts      []int
+	selected    Component
+	live        bool
+	unread      bool
+}
+
+func NewInteractionPages(source *Container, startup ...Component) *InteractionPages {
+	return &InteractionPages{source: source, body: NewContainer(), startup: append([]Component(nil), startup...), live: true}
+}
+
+func (p *InteractionPages) sync() {
+	p.source.mu.RLock()
+	defer p.source.mu.RUnlock()
+	if p.initialized && p.version == p.source.structureVersion {
+		return
+	}
+	p.initialized, p.version = true, p.source.structureVersion
+	p.children = append(p.children[:0], p.source.children...)
+	p.starts = p.starts[:0]
+	skillPrompt := false
+	for i, child := range p.children {
+		switch child.(type) {
+		case *SkillInvocationMessageComponent:
+			if !skillPrompt {
+				p.starts = append(p.starts, i)
+			}
+			skillPrompt = true
+		case *UserMessageComponent:
+			if !skillPrompt {
+				p.starts = append(p.starts, i)
+			}
+			skillPrompt = false
+		case *Spacer:
+			// A skill and its trailing prompt are separated by padding.
+		default:
+			skillPrompt = false
+		}
+	}
+	if !p.live {
+		found := false
+		for _, start := range p.starts {
+			if p.children[start] == p.selected {
+				found = true
+				break
+			}
+		}
+		if !found {
+			p.live, p.selected = true, nil
+		}
+	}
+	p.selectBody()
+}
+
+func (p *InteractionPages) index() int {
+	if p.live {
+		return len(p.starts) - 1
+	}
+	for i, start := range p.starts {
+		if p.children[start] == p.selected {
+			return i
+		}
+	}
+	return len(p.starts) - 1
+}
+
+func (p *InteractionPages) selectBody() {
+	index := p.index()
+	pigplugins.SetInteractionPage(index+1, len(p.starts))
+	start, end := 0, len(p.children)
+	if index >= 0 {
+		start = p.starts[index]
+		if index+1 < len(p.starts) {
+			end = p.starts[index+1]
+		}
+	}
+	// Keep startup content and notices on the first page only.
+	if index == 0 {
+		start = 0
+	}
+	children := p.children[start:end]
+	if index <= 0 && len(p.startup) > 0 {
+		children = append(append([]Component(nil), p.startup...), children...)
+	}
+	p.body.SetChildren(children...)
+}
+
+// Follow returns to the latest page, as when the user sends a message.
+func (p *InteractionPages) Follow() bool {
+	p.sync()
+	if p.live {
+		return false
+	}
+	p.live, p.unread, p.selected = true, false, nil
+	p.selectBody()
+	return true
+}
+
+// Move changes the selected page without changing the source transcript.
+func (p *InteractionPages) Move(delta int) bool {
+	p.sync()
+	if len(p.starts) == 0 {
+		return false
+	}
+	previous := p.index()
+	next := max(0, min(len(p.starts)-1, previous+delta))
+	if next == previous {
+		return false
+	}
+	p.live = next == len(p.starts)-1
+	if p.live {
+		p.unread = false
+	}
+	p.selected = p.children[p.starts[next]]
+	p.selectBody()
+	return true
+}
+
+func (p *InteractionPages) Render(width int) []string {
+	p.sync()
+	index := p.index()
+	if index < 0 {
+		return p.body.Render(width)
+	}
+	var prompt string
+	switch user := p.children[p.starts[index]].(type) {
+	case *UserMessageComponent:
+		prompt = user.content
+	case *SkillInvocationMessageComponent:
+		prompt = "/skill:" + user.skillBlock.Name
+	}
+	title := strings.Join(strings.Fields(widthx.StripTerminalSequences(prompt)), " ")
+	header := fmt.Sprintf("Page %d / %d · Alt+←/→ or Alt+H/L · %s", index+1, len(p.starts), title)
+	if !p.live {
+		status := "Latest page →"
+		if p.unread {
+			status = "Latest page has new output →"
+		}
+		header = fmt.Sprintf("Page %d / %d · Alt+←/→ or Alt+H/L · %s", index+1, len(p.starts), status)
+	}
+	header = widthx.TruncateToWidth(header, max(0, width), "…", false)
+	return append([]string{header}, p.body.Render(width)...)
+}
+
+// NoteOutput records activity without rendering a hidden page.
+func (p *InteractionPages) NoteOutput() {
+	if !p.live {
+		p.unread = true
+	}
+}
+
+func (p *InteractionPages) Invalidate() { p.body.Invalidate() }
+
+func (p *InteractionPages) HandleMouse(event TuiMouseEvent) *TuiMouseDispatchResult {
+	if event.Y == 0 {
+		return nil
+	}
+	event.Y--
+	event.Height = max(0, event.Height-1)
+	return DispatchMouseEvent(p.body, event)
+}
