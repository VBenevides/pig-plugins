new file mode 100644
--- /dev/null
+++ b/tui/user_message_images_test.go
@@ -0,0 +1,96 @@
+package tui
+
+import (
+	"bytes"
+	"encoding/base64"
+	"image"
+	"image/png"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func transcriptTestImage(t *testing.T) string {
+	t.Helper()
+	var data bytes.Buffer
+	if err := png.Encode(&data, image.NewRGBA(image.Rect(0, 0, 2, 2))); err != nil {
+		t.Fatal(err)
+	}
+	return base64.StdEncoding.EncodeToString(data.Bytes())
+}
+
+func TestUserMessageTerminalImagesSurvivePagesAndMissingFiles(t *testing.T) {
+	t.Setenv("PIG_PLUGINS_HOST_VERSION", "test")
+	previous := GetCapabilities()
+	SetCapabilities(TerminalCapabilities{Images: ImageProtocolKitty})
+	t.Cleanup(func() { SetCapabilities(previous) })
+	dir := t.TempDir()
+	t.Setenv("PIG_CODING_AGENT_DIR", dir)
+	hash := strings.Repeat("a", 64) + ".png"
+	ref := "image-view://sha256/" + hash
+	data := transcriptTestImage(t)
+	blob := filepath.Join(dir, "image-view", "blobs", hash)
+	if err := os.MkdirAll(filepath.Dir(blob), 0700); err != nil {
+		t.Fatal(err)
+	}
+	raw, err := base64.StdEncoding.DecodeString(data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(blob, raw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	first := NewUserMessageComponent("[Image #1]("+ref+")", nil, 0, nil)
+	source := NewContainer(first, NewUserMessageComponent("next", nil, 0, nil))
+	pages := NewInteractionPages(source)
+	pages.Render(100)
+	pages.Move(-1)
+	pages.Render(100)
+	children := first.Children()
+	if len(children) != 2 {
+		t.Fatalf("missing image child: %v", children)
+	}
+	saved, ok := children[1].(*Image)
+	if !ok || saved.Base64Data != data {
+		t.Fatal("stored image was not loaded")
+	}
+	if lines := strings.Join(saved.Render(100), "\n"); !strings.Contains(lines, "\x1b_G") {
+		t.Fatal("image did not emit Kitty graphics")
+	}
+	if err := os.Remove(blob); err != nil {
+		t.Fatal(err)
+	}
+	pages.Move(1)
+	pages.Render(100)
+	pages.Move(-1)
+	pages.Render(80)
+	if got := first.Children(); len(got) != 2 || got[1] != saved {
+		t.Fatal("page navigation discarded cached image")
+	}
+	// Session attachment data also survives the loss of its preview blob.
+	restored := NewUserMessageComponent("[Image #1]("+ref+")", nil, 0, nil)
+	restored.SetImages([]ImageBlock{{Data: data, MIMEType: "image/png"}})
+	restored.Render(100)
+	if children := restored.Children(); len(children) != 2 {
+		t.Fatal("session image not rendered")
+	}
+	missing := NewUserMessageComponent("[Image #1]("+ref+")", nil, 0, nil)
+	if lines := strings.Join(missing.Render(100), "\n"); !strings.Contains(lines, "[IMAGE NO LONGER AVAILABLE]") {
+		t.Fatalf("missing fallback: %s", lines)
+	}
+}
+
+func TestUserMessageTerminalImageFailureKeepsNeighbors(t *testing.T) {
+	t.Setenv("PIG_PLUGINS_HOST_VERSION", "test")
+	block := NewUserMessageComponent("images", nil, 0, nil)
+	block.SetImages([]ImageBlock{{Data: "broken", MIMEType: "image/png"}, {Data: transcriptTestImage(t), MIMEType: "image/png"}})
+	block.Render(100)
+	children := block.Children()
+	if len(children) != 3 {
+		t.Fatalf("children=%d", len(children))
+	}
+	if _, ok := children[2].(*Image); !ok {
+		t.Fatal("bad image suppressed successful neighbor")
+	}
+}
