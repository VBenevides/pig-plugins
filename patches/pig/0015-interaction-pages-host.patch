+)
+
+func TestInteractionSkillCommandDisplayAndInput(t *testing.T) {
+	skills := []*SkillDef{
+		{Name: "format-commit", FilePath: "/fixture/format-commit/SKILL.md", BaseDir: "/fixture/format-commit", Body: "FORMAT_SENTINEL", SourceInfo: extension.SourceInfo{Source: "inline"}},
+		{Name: "review", FilePath: "/fixture/review/SKILL.md", BaseDir: "/fixture/review", Body: "REVIEW_SENTINEL", SourceInfo: extension.SourceInfo{Source: "inline"}},
+	}
+	for _, prompt := range []string{"/skill:format-commit and commit", "/skill:format-commit", "Please /skill:format-commit then /skill:review and /skill:format-commit", "/skill:unknown and commit"} {
+		t.Run(prompt, func(t *testing.T) {
+			expand := ExpandSkillCommand
+			if !strings.HasPrefix(prompt, "/") {
+				expand = ExpandInlineSkillCommands
+			}
+			expanded, ok, failure := expand(prompt, skills)
+			if failure != nil {
+				t.Fatal(failure)
+			}
+			if !ok {
+				expanded = prompt
+			} else if !strings.Contains(expanded, "FORMAT_SENTINEL") || !strings.Contains(expanded, `location="/fixture/format-commit/SKILL.md"`) {
+				t.Fatalf("wrong agent skill input: %s", expanded)
+			}
+			msg := agent.AgentMessage{User: &agent.UserMessage{Role: agent.RoleUser, Content: ai.UserContentBlocks{ai.TextContent{Text: expanded}}}}
+			before := msg.User.Content.(ai.UserContentBlocks)[0].(ai.TextContent).Text
+			m, _ := newTickRenderProbe(t, "regular")
+			m.chatContainer.Clear()
+			pages := tui.NewInteractionPages(m.chatContainer)
+			m.addUserMessageToChat(agent.AgentMessage{}, "first")
+			pages.Render(160)
+			m.handleAgentEvent(agent.MessageStartEvent{Message: msg})
+			check := func() {
+				t.Helper()
+				got := widthx.StripAnsi(strings.Join(pages.Render(160), "\n"))
+				if !strings.Contains(got, "Page 2 / 2") || !strings.Contains(got, prompt) || strings.Contains(got, "<skill") {
+					t.Fatalf("command display: %s", got)
+				}
+				if ok && !strings.Contains(got, "[skill] format-commit") {
+					t.Fatalf("skill details missing: %s", got)
+				}
+			}
+			check()
+			pages.Move(-1)
+			pages.Move(1)
+			check()
+			entry := contextFixtureEntry(t, "u", "", "message", map[string]any{"message": map[string]any{"role": "user", "timestamp": 1, "content": "first"}})
+			skillEntry := contextFixtureEntry(t, "s", "u", "message", map[string]any{"message": map[string]any{"role": "user", "timestamp": 2, "content": expanded}})
+			m.chatContainer.Clear()
+			m.renderSessionEntryList([]SessionEntry{entry, skillEntry}, false)
+			pages = tui.NewInteractionPages(m.chatContainer)
+			check()
+			if !reflect.DeepEqual(msg.User.Content, ai.UserContentBlocks{ai.TextContent{Text: before}}) {
+				t.Fatal("display changed agent input")
+			}
+		})
+	}
+}
