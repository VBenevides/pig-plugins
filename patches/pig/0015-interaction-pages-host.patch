+)
+
+func TestInteractionPageKeysAndIsolation(t *testing.T) {
+	t.Setenv("PIG_PLUGINS_HOST_VERSION", "test")
+	m := NewInteractiveMode(nil, InteractiveModeOptions{TuiMode: "fullscreen", AgentDir: t.TempDir()})
+	m.rendererOut = io.Discard
+	handle := m.createInteractiveTui(t.Context())
+	defer handle.cleanup()
+	prepareInteractionTestLayout(m)
+	m.mountInteractiveTui(false)
+	m.headerContainer().Add(tui.NewText("startup icon"))
+	m.loadedResourcesContainer.Add(tui.NewText("startup resources"))
+	m.chatContainer.Add(tui.NewUserMessageComponent("first", nil, 0, nil))
+	m.chatContainer.Add(tui.NewText("first reply"))
+	m.chatContainer.Add(tui.NewUserMessageComponent("second", nil, 0, nil))
+	m.chatContainer.Add(tui.NewText("second reply"))
+	m.tuiInst.SetFocus(m.editor)
+	m.editor.SetText("unchanged draft")
+	rendered := func() string { return widthx.StripAnsi(strings.Join(m.transcriptScrollView.Render(100), "\n")) }
+	if !strings.Contains(rendered(), "Page 2 / 2") || strings.Contains(rendered(), "startup") {
+		t.Fatal("latest page not selected")
+	}
+	for _, key := range []string{"\x1bh", "\x1b[1;3D"} {
+		if !m.handleInteractionPageKey(key) || !strings.Contains(rendered(), "Page 1 / 2") || !strings.Contains(rendered(), "startup icon") || !strings.Contains(rendered(), "startup resources") {
+			t.Fatalf("previous key %q failed", key)
+		}
+		if !m.handleInteractionPageKey("\x1b[108;3:3u") || !strings.Contains(rendered(), "Page 1 / 2") {
+			t.Fatal("key release changed page")
+		}
+		if !m.handleInteractionPageKey("\x1bl") || !strings.Contains(rendered(), "Page 2 / 2") || strings.Contains(rendered(), "startup") {
+			t.Fatal("next key failed")
+		}
+	}
+	if !m.handleInteractionPageKey("\x1b[1;3C") {
+		t.Fatal("right boundary leaked to editor")
+	}
+	if m.handleInteractionPageKey("j") {
+		t.Fatal("ordinary input captured")
+	}
+	if got := m.editor.Text(); got != "unchanged draft" {
+		t.Fatalf("draft changed: %q", got)
+	}
+	if m.chatContainer.ChildCount() != 4 {
+		t.Fatal("source transcript changed")
+	}
+	other := tui.NewText("dialog")
+	m.tuiInst.SetFocus(other)
+	if m.handleInteractionPageKey("\x1bh") {
+		t.Fatal("dialog key captured")
+	}
+}
+
+func TestInteractionPagesOnlyMountInDistributionFullscreen(t *testing.T) {
+	for _, tc := range []struct {
+		version, mode string
+		want          bool
+	}{{"", "fullscreen", false}, {"test", "regular", false}, {"test", "fullscreen", true}} {
+		t.Run(tc.version+tc.mode, func(t *testing.T) {
+			t.Setenv("PIG_PLUGINS_HOST_VERSION", tc.version)
+			m := NewInteractiveMode(nil, InteractiveModeOptions{TuiMode: tc.mode, AgentDir: t.TempDir()})
+			m.rendererOut = io.Discard
+			handle := m.createInteractiveTui(t.Context())
+			defer handle.cleanup()
+			prepareInteractionTestLayout(m)
+			m.mountInteractiveTui(false)
+			if (m.interactionPages != nil) != tc.want {
+				t.Fatalf("pages mounted=%v, want=%v", m.interactionPages != nil, tc.want)
+			}
+		})
+	}
+}
+
+func prepareInteractionTestLayout(m *InteractiveMode) {
+	m.chatContainer = tui.NewContainer()
+	m.loadedResourcesContainer = tui.NewContainer()
+	m.startupHeaderPending = true
+	m.editor = tui.NewEditor()
+	m.editorContainer = tui.NewContainer(m.editor)
+	m.widgetContainer = tui.NewContainer()
+	m.statusContainer = tui.NewContainer()
+	m.pendingMessagesContainer = tui.NewContainer()
+}
