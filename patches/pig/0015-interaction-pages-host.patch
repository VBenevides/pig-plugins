@@ -0,0 +1,154 @@
+package tui
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/tui/widthx"
+)
+
+func pagePrompt(text string) *UserMessageComponent { return NewUserMessageComponent(text, nil, 0, nil) }
+func pageText(p *InteractionPages) string          { return widthx.StripAnsi(strings.Join(p.Render(100), "\n")) }
+
+func TestInteractionPagesDisplayOnly(t *testing.T) {
+	first, second := pagePrompt("first prompt"), pagePrompt("second prompt")
+	source := NewContainer(NewText("startup"), first, NewText("first reply"), NewText("first tool"), second, NewText("second reply"))
+	before := source.Children()
+	pages := NewInteractionPages(source)
+	if got := pageText(pages); !strings.Contains(got, "Page 2 / 2") || !strings.Contains(got, "second reply") || strings.Contains(got, "first reply") {
+		t.Fatalf("latest: %s", got)
+	}
+	if !pages.Move(-1) {
+		t.Fatal("previous page not selected")
+	}
+	if got := pageText(pages); !strings.Contains(got, "first reply") || !strings.Contains(got, "first tool") || !strings.Contains(got, "startup") || strings.Contains(got, "second reply") {
+		t.Fatalf("history: %s", got)
+	}
+	if pages.Move(-1) {
+		t.Fatal("moved past first page")
+	}
+	if !reflect.DeepEqual(before, source.Children()) {
+		t.Fatal("source transcript changed")
+	}
+	if !pages.Move(1) || pages.Move(1) {
+		t.Fatal("latest-page limit failed")
+	}
+}
+
+func TestInteractionPagesHistoryDuringLiveOutput(t *testing.T) {
+	liveReply := NewText("live reply")
+	source := NewContainer(pagePrompt("first"), NewText("old reply"), pagePrompt("second"), liveReply)
+	pages := NewInteractionPages(source)
+	pages.Render(80)
+	pages.Move(-1)
+	liveReply.SetText("updated live reply")
+	pages.NoteOutput()
+	source.Add(NewText("new tool"))
+	if got := pageText(pages); !strings.Contains(got, "Page 1 / 2") || !strings.Contains(got, "new output") || strings.Contains(got, "updated live reply") {
+		t.Fatalf("history jumped: %s", got)
+	}
+	source.Add(pagePrompt("third"))
+	if got := pageText(pages); !strings.Contains(got, "Page 1 / 3") {
+		t.Fatalf("new prompt changed selection: %s", got)
+	}
+	pages.Move(1)
+	if got := pageText(pages); !strings.Contains(got, "updated live reply") || !strings.Contains(got, "new tool") {
+		t.Fatalf("live updates lost: %s", got)
+	}
+	pages.Move(1)
+	if pages.unread {
+		t.Fatal("latest page did not clear notice")
+	}
+	source.Add(pagePrompt("fourth"))
+	if got := pageText(pages); !strings.Contains(got, "Page 4 / 4") {
+		t.Fatalf("live selection did not follow: %s", got)
+	}
+}
+
+func TestInteractionPagesFollowReturnsToLatest(t *testing.T) {
+	source := NewContainer(pagePrompt("first"), NewText("first reply"), pagePrompt("second"), NewText("second reply"))
+	pages := NewInteractionPages(source)
+	if pages.Follow() {
+		t.Fatal("latest page reported a change")
+	}
+	pages.Move(-1)
+	pages.NoteOutput()
+	source.Add(pagePrompt("third"))
+	if !pages.Follow() {
+		t.Fatal("history page did not follow")
+	}
+	if got := pageText(pages); !strings.Contains(got, "Page 3 / 3") || pages.unread {
+		t.Fatalf("not on latest page: %s", got)
+	}
+}
+
+func TestInteractionPagesResetAndResize(t *testing.T) {
+	source := NewContainer(pagePrompt("first"), NewText("first reply"), pagePrompt("second"))
+	pages := NewInteractionPages(source)
+	pages.Move(-1)
+	source.SetChildren(pagePrompt("replacement"), NewText("replacement reply"), NewText("same child count"))
+	if got := pageText(pages); !strings.Contains(got, "Page 1 / 1") || !strings.Contains(got, "replacement reply") {
+		t.Fatalf("reset: %s", got)
+	}
+	for _, width := range []int{1, 5, 20, 100} {
+		rows := pages.Render(width)
+		if widthx.VisibleWidth(rows[0]) > width {
+			t.Fatalf("header exceeds width %d: %q", width, rows[0])
+		}
+	}
+	source.Clear()
+	if rows := pages.Render(80); len(rows) != 0 || pages.Move(1) {
+		t.Fatalf("empty transcript: %v", rows)
+	}
+	source.Add(NewText("notice without prompt"))
+	if got := pageText(pages); !strings.Contains(got, "notice without prompt") || strings.Contains(got, "Page") {
+		t.Fatalf("notice: %s", got)
+	}
+}
+
+func TestInteractionPagesHiddenPagesDoNotRender(t *testing.T) {
+	hidden := &pageRenderCounter{}
+	source := NewContainer(pagePrompt("first"), hidden, pagePrompt("second"), NewText("latest"))
+	pages := NewInteractionPages(source)
+	pages.Render(80)
+	if hidden.renderCount != 0 {
+		t.Fatal("hidden page rendered")
+	}
+}
+
+type pageRenderCounter struct{ renderCount int }
+
+func (c *pageRenderCounter) Render(int) []string { c.renderCount++; return []string{"hidden"} }
+func (c *pageRenderCounter) Invalidate()         {}
+
+func TestInteractionPagesStartupOnlyOnFirstPage(t *testing.T) {
+	resources := NewContainer()
+	header := NewText("pig startup icon")
+	source := NewContainer()
+	pages := NewInteractionPages(source, header, resources)
+	if got := pageText(pages); !strings.Contains(got, "pig startup icon") {
+		t.Fatalf("startup before first prompt missing: %s", got)
+	}
+	resources.Add(NewText("startup resource information"))
+	source.Add(pagePrompt("first"))
+	if got := pageText(pages); !strings.Contains(got, "pig startup icon") || !strings.Contains(got, "startup resource information") {
+		t.Fatalf("first interaction lost startup content: %s", got)
+	}
+	source.Add(pagePrompt("second"))
+	if got := pageText(pages); strings.Contains(got, "pig startup icon") || strings.Contains(got, "startup resource information") {
+		t.Fatalf("second interaction repeats startup content: %s", got)
+	}
+	pages.Move(-1)
+	if got := pageText(pages); !strings.Contains(got, "pig startup icon") || !strings.Contains(got, "startup resource information") {
+		t.Fatalf("returning to first interaction lost startup content: %s", got)
+	}
+	pages.Move(1)
+	if got := pageText(pages); strings.Contains(got, "pig startup icon") || strings.Contains(got, "startup resource information") {
+		t.Fatalf("returning to latest repeats startup content: %s", got)
+	}
+	source.Clear()
+	if got := pageText(pages); !strings.Contains(got, "pig startup icon") || !strings.Contains(got, "startup resource information") {
+		t.Fatalf("new session lost startup content: %s", got)
+	}
+}
