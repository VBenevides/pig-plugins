diff --git a/tui/user_message_images.go b/tui/user_message_images.go
new file mode 100644
--- /dev/null
+++ b/tui/user_message_images.go
@@ -0,0 +1,49 @@
+package tui
+
+import (
+	"log"
+	"os"
+	"regexp"
+
+	pigplugins "github.com/VBenevides/pig-plugins"
+)
+
+var storedUserImage = regexp.MustCompile(`image-view://sha256/[a-f0-9]{64}\.(?:png|jpg|gif|webp)`)
+
+// ensureTerminalImages retains decoded sources with their message, so navigating
+// away and back does not depend on the original file or the preview blob.
+func (u *UserMessageComponent) ensureTerminalImages() {
+	if u.terminalImagesReady || os.Getenv("PIG_PLUGINS_HOST_VERSION") == "" {
+		return
+	}
+	u.terminalImagesReady = true
+	references := storedUserImage.FindAllString(u.content, 16)
+	count := min(16, max(len(u.images), len(references)))
+	for index := 0; index < count; index++ {
+		var source ImageBlock
+		if index < len(u.images) {
+			source = u.images[index]
+		}
+		if GetImageDimensions(source.Data, source.MIMEType) == nil && index < len(references) {
+			data, mimeType, err := pigplugins.ReadStoredImage(references[index])
+			if err != nil {
+				log.Printf("transcript image %d: %v", index+1, err)
+			} else {
+				source = ImageBlock{Data: data, MIMEType: mimeType}
+			}
+		}
+		dimensions := GetImageDimensions(source.Data, source.MIMEType)
+		if dimensions == nil {
+			if source.Data != "" {
+				log.Printf("transcript image %d: invalid image data", index+1)
+			}
+			u.Add(NewText("[IMAGE NO LONGER AVAILABLE]"))
+			continue
+		}
+		image := NewImage(source.Data, source.MIMEType, DefaultImageTheme(), ImageOptions{MaxWidthCells: 80, MaxHeightCells: 24}, dimensions)
+		u.Add(image)
+		if source.MIMEType != "image/png" {
+			ensureImageTranscoder(u.Invalidate)
+		}
+	}
+}
