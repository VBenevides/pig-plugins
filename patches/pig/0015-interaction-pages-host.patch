+++ b/internal/codingagent/interactive_pages.go
@@ -0,0 +1,28 @@
+package codingagent
+
+import "github.com/MichaelKinsy/PiG/tui"
+
+func (m *InteractiveMode) handleInteractionPageKey(data string) bool {
+	if m.interactionPages == nil || m.altScreen == nil || m.extensionDialog != nil || m.tuiInst.HasOverlay() || m.tuiInst.GetFocusedComponent() != m.editor {
+		return false
+	}
+	delta := 0
+	switch {
+	case tui.MatchesKeyID(data, "alt+left"), tui.MatchesKeyID(data, "alt+h"):
+		delta = -1
+	case tui.MatchesKeyID(data, "alt+right"), tui.MatchesKeyID(data, "alt+l"):
+		delta = 1
+	default:
+		return false
+	}
+	if tui.IsKeyRelease(data) {
+		return true
+	}
+	if m.interactionPages.Move(delta) {
+		if m.transcriptScrollView != nil {
+			m.transcriptScrollView.ScrollToStart()
+		}
+		m.tuiInst.RequestRender()
+	}
+	return true
+}
