+package tui
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestInteractionPagesKeepSkillInvocationWithPrompt(t *testing.T) {
+	for _, args := range []string{"", "and commit"} {
+		t.Run(args, func(t *testing.T) {
+			source := NewContainer(pagePrompt("first"), NewText("first reply"))
+			pages := NewInteractionPages(source)
+			pages.Render(100)
+			skill := NewSkillInvocationMessageComponent(ParsedSkillBlock{Name: "format-commit", Content: "skill instructions"}, nil, 0)
+			source.Add(NewSpacer(1))
+			source.Add(skill)
+			if args != "" {
+				source.Add(NewSpacer(1))
+				source.Add(pagePrompt(args))
+			}
+			source.Add(NewText("Warning: skill fixture"))
+			source.Add(NewText("skill reply"))
+			before := source.Children()
+			check := func() {
+				t.Helper()
+				got := pageText(pages)
+				for _, want := range []string{"Page 2 / 2", "[skill] format-commit", "Warning: skill fixture", "skill reply", args} {
+					if !strings.Contains(got, want) {
+						t.Fatalf("missing %q: %s", want, got)
+					}
+				}
+				if strings.Contains(got, "first reply") {
+					t.Fatalf("previous reply leaked: %s", got)
+				}
+			}
+			check()
+			pages.Move(-1)
+			if got := pageText(pages); strings.Contains(got, "[skill]") || strings.Contains(got, "Warning: skill fixture") {
+				t.Fatalf("skill output on previous page: %s", got)
+			}
+			pages.Move(1)
+			check()
+			skill.SetExpanded(true)
+			if got := pageText(pages); !strings.Contains(got, "skill instructions") {
+				t.Fatalf("cannot expand skill: %s", got)
+			}
+			if !reflect.DeepEqual(before, source.Children()) {
+				t.Fatal("source changed")
+			}
+			restored := NewInteractionPages(NewContainer(before...))
+			if got := pageText(restored); !strings.Contains(got, "Page 2 / 2") || !strings.Contains(got, "Warning: skill fixture") {
+				t.Fatalf("rebuilt page lost skill output: %s", got)
+			}
+		})
+	}
+}
