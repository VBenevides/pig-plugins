diff --git b/internal/codingagent/skill_message_collapse_test.go b/internal/codingagent/skill_message_collapse_test.go
new file mode 100644
index 0000000..a0bf7a9
--- /dev/null
+++ b/internal/codingagent/skill_message_collapse_test.go
@@ -0,0 +1,61 @@
+package codingagent
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/agent"
+	"github.com/MichaelKinsy/PiG/ai"
+	"github.com/MichaelKinsy/PiG/tui"
+)
+
+func TestSkillMessagesCollapseLiveAndResumed(t *testing.T) {
+	for _, live := range []bool{true, false} {
+		for _, multiple := range []bool{false, true} {
+			t.Run(fmt.Sprintf("live=%v/multiple=%v", live, multiple), func(t *testing.T) {
+				m := statusBorderMode(t, false)
+				text := "<skill name=\"alpha\" location=\"/alpha.md\">\n" + strings.Repeat("preview\n", 20) + "ALPHA_END\n</skill>\n\n"
+				if multiple {
+					text += "<skill name=\"beta\" location=\"/beta.md\">\n" + strings.Repeat("preview\n", 20) + "BETA_END\n</skill>\n\n"
+				}
+				text += "Original prompt /skill:alpha"
+				if live {
+					message := agent.AgentMessage{User: &agent.UserMessage{Role: agent.RoleUser, Content: ai.UserContentBlocks{ai.TextContent{Text: text}}}}
+					m.handleAgentEvent(agent.MessageStartEvent{Message: message})
+					if extractAgentMessageText(message) != text {
+						t.Fatal("display changed model input")
+					}
+				} else {
+					entry := contextFixtureEntry(t, "skills", "", "message", map[string]any{"message": map[string]any{"role": "user", "content": text}})
+					m.renderSessionEntryList([]SessionEntry{entry}, false)
+				}
+				wantSkills := 1
+				if multiple {
+					wantSkills++
+				}
+				var skills int
+				for _, child := range m.chatContainer.Children() {
+					if _, ok := child.(*tui.SkillInvocationMessageComponent); ok {
+						skills++
+					}
+				}
+				if skills != wantSkills {
+					t.Fatalf("mounted skills = %d, want %d", skills, wantSkills)
+				}
+				for _, expanded := range []bool{false, true, false} {
+					if m.toolsExpanded != expanded {
+						m.toggleAllTools() // Ctrl+O action
+					}
+					view := strings.Join(m.chatContainer.Render(80), "\n")
+					if strings.Contains(view, "ALPHA_END") != expanded || (multiple && strings.Contains(view, "BETA_END") != expanded) {
+						t.Fatalf("expanded=%v: %q", expanded, view)
+					}
+					if !strings.Contains(view, "Original prompt /skill:alpha") || strings.Contains(view, "<skill name=") {
+						t.Fatalf("prompt or skill framing incorrect: %q", view)
+					}
+				}
+			})
+		}
+	}
+}
