+// q cancels like Escape: this selector has no filter input, so q is never text (pig additive).
+func TestExtensionSelectorQCancelsLikeEscape(t *testing.T) {
+	sel := NewExtensionSelector("Pick one", []string{"a", "b"})
+	sel.HandleInput("q")
+	if !sel.Done() || !sel.Cancelled() {
+		t.Fatal("q must cancel the selector")
+	}
+	other := NewExtensionSelector("Pick one", []string{"a", "b"})
+	other.HandleInput("j")
+	other.HandleInput("\r")
+	if !other.Done() || other.Cancelled() || other.SelectedValue() != "b" {
+		t.Fatal("navigation and confirmation must be unchanged")
+	}
+}
