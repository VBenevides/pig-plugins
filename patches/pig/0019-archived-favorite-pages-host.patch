diff --git a/internal/codingagent/interactive_page_marks.go b/internal/codingagent/interactive_page_marks.go
new file mode 100644
index 00000000..1400a6fe
--- /dev/null
+++ b/internal/codingagent/interactive_page_marks.go
@@ -0,0 +1,120 @@
+package codingagent
+
+import (
+	"encoding/json"
+
+	"github.com/MichaelKinsy/PiG/internal/orderedjson"
+	"github.com/MichaelKinsy/PiG/tui"
+)
+
+// favoriteEntryType is the custom session entry that records a bookmark. The
+// model context never includes custom entries.
+const favoriteEntryType = "pig-plugins/favorite"
+
+// keepArchivedHistory reports whether a compaction keeps the older transcript.
+// Only the interaction-page view can mark pages that left the context, so the
+// regular transcript still shows the agent context only.
+func (m *InteractiveMode) keepArchivedHistory() bool {
+	return m.pagesActive
+}
+
+// pageEntry is one interaction page: a user prompt on the active branch.
+type pageEntry struct {
+	id       string
+	archived bool
+}
+
+// branchPages lists the user prompts of a branch, oldest first, as the page view
+// counts them. A prompt is archived when it lies before the kept range of the
+// latest compaction, so the agent no longer receives it.
+func (s *Session) branchPages(branch []SessionEntry) []pageEntry {
+	entries := make([]parsedEntry, len(branch))
+	for i, entry := range branch {
+		entries[i] = parsedEntry{entry: entry}
+	}
+	keptFrom := compactionTrimIndex(entries)
+	var pages []pageEntry
+	for i, entry := range branch {
+		if entry.Base().Type != "message" {
+			continue
+		}
+		message, ok := s.messageFor(entry)
+		// The transcript renders a prompt with text or images; a prompt with neither has no page.
+		if !ok || message.Message.User == nil || extractAgentMessageText(message.Message) == "" && len(userMessageImages(message.Message)) == 0 {
+			continue
+		}
+		pages = append(pages, pageEntry{id: entry.Base().ID, archived: i < keptFrom})
+	}
+	return pages
+}
+
+// favoriteTargets returns the prompts the branch currently marks as favorite.
+// The newest record for a prompt wins.
+func favoriteTargets(branch []SessionEntry) map[string]bool {
+	favorites := map[string]bool{}
+	for _, entry := range branch {
+		var custom CustomEntry
+		// The entry's own decoder keeps `data` as ordered JSON; its embedded base decoder would drop it.
+		if json.Unmarshal(entry.Raw(), &custom) != nil || custom.CustomType != favoriteEntryType {
+			continue
+		}
+		data, _ := orderedjson.Map(custom.Data)
+		target, _ := data["entryId"].(string)
+		on, _ := data["favorite"].(bool)
+		if target != "" {
+			favorites[target] = on
+		}
+	}
+	return favorites
+}
+
+// pageMarks is the marker of the interaction pages. It reads the session, never the transcript.
+func (m *InteractiveMode) pageMarks() []tui.PageMark {
+	session := m.currentSession()
+	if session == nil {
+		return nil
+	}
+	branch := session.GetBranch()
+	favorites := favoriteTargets(branch)
+	pages := session.branchPages(branch)
+	marks := make([]tui.PageMark, len(pages))
+	for i, page := range pages {
+		marks[i] = tui.PageMark{Archived: page.archived, Favorite: favorites[page.id]}
+	}
+	return marks
+}
+
+// refreshPageMarks makes the page view read the marks again.
+func (m *InteractiveMode) refreshPageMarks() {
+	if m.interactionPages != nil {
+		m.interactionPages.RefreshMarks()
+	}
+}
+
+// toggleFavoritePage bookmarks or unbookmarks the selected interaction page.
+func (m *InteractiveMode) toggleFavoritePage() {
+	session := m.currentSession()
+	if m.interactionPages == nil || session == nil {
+		return
+	}
+	index, total := m.interactionPages.Position()
+	branch := session.GetBranch()
+	pages := session.branchPages(branch)
+	if total == 0 || index < 0 || index >= len(pages) {
+		m.showWarning("Nothing to favorite on this page yet")
+		return
+	}
+	target := pages[index].id
+	favorite := !favoriteTargets(branch)[target]
+	if _, err := session.AppendCustomEntry(favoriteEntryType, map[string]any{"entryId": target, "favorite": favorite}); err != nil {
+		m.showError("Could not save favorite: " + err.Error())
+		return
+	}
+	m.refreshPageMarks()
+	if favorite {
+		m.showStatus("Page added to favorites")
+	} else {
+		m.showStatus("Page removed from favorites")
+	}
+	m.tuiInst.RequestRender()
+}
diff --git a/internal/codingagent/interactive_page_marks_test.go b/internal/codingagent/interactive_page_marks_test.go
new file mode 100644
index 00000000..604d3e50
--- /dev/null
+++ b/internal/codingagent/interactive_page_marks_test.go
@@ -0,0 +1,137 @@
+package codingagent
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/MichaelKinsy/PiG/agent"
+	"github.com/MichaelKinsy/PiG/ai"
+)
+
+func pageMarksTestSession(t *testing.T) (*Session, []string) {
+	t.Helper()
+	session := NewSession("page-marks", t.TempDir())
+	now := time.Now().UnixMilli()
+	var prompts []string
+	for _, text := range []string{"one", "two", "three"} {
+		id, err := session.AppendMessage(agent.AgentMessage{User: &agent.UserMessage{Role: agent.RoleUser, Content: ai.UserContentBlocks{ai.TextContent{Text: text}}, Timestamp: now}})
+		if err != nil {
+			t.Fatal(err)
+		}
+		prompts = append(prompts, id)
+		if _, err := session.AppendMessage(agent.AgentMessage{Assistant: &agent.AssistantMessage{Role: "assistant", Content: []ai.AssistantContentBlock{ai.TextContent{Text: "reply " + text}}, StopReason: ai.StopReasonStop, API: "anthropic-messages", Provider: "anthropic", ModelID: "claude", Timestamp: now}}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return session, prompts
+}
+
+func TestBranchPagesArchiveOnlyPromptsOutsideTheKeptRange(t *testing.T) {
+	session, prompts := pageMarksTestSession(t)
+	if got := session.branchPages(session.GetBranch()); len(got) != 3 || got[0].archived || got[2].archived {
+		t.Fatalf("before compaction: %+v", got)
+	}
+	// The kept range starts at the second prompt, so only the first leaves the context.
+	if _, err := session.AppendCompaction("summary", prompts[1], 100, nil, true, nil); err != nil {
+		t.Fatal(err)
+	}
+	got := session.branchPages(session.GetBranch())
+	want := []bool{true, false, false}
+	if len(got) != len(want) {
+		t.Fatalf("pages = %+v", got)
+	}
+	for i := range want {
+		if got[i].id != prompts[i] || got[i].archived != want[i] {
+			t.Errorf("page %d = %+v, want id %s archived %v", i, got[i], prompts[i], want[i])
+		}
+	}
+	// A prompt after the compaction stays active, and the older ones stay in the list.
+	if _, err := session.AppendMessage(agent.AgentMessage{User: &agent.UserMessage{Role: agent.RoleUser, Content: ai.UserContentBlocks{ai.TextContent{Text: "four"}}, Timestamp: time.Now().UnixMilli()}}); err != nil {
+		t.Fatal(err)
+	}
+	if got := session.branchPages(session.GetBranch()); len(got) != 4 || !got[0].archived || got[3].archived {
+		t.Fatalf("after new prompt: %+v", got)
+	}
+}
+
+func TestBranchPagesArchiveEverythingWhenNoKeptEntryExists(t *testing.T) {
+	session, _ := pageMarksTestSession(t)
+	if _, err := session.AppendCompaction("summary", "missing", 100, nil, true, nil); err != nil {
+		t.Fatal(err)
+	}
+	for i, page := range session.branchPages(session.GetBranch()) {
+		if !page.archived {
+			t.Errorf("page %d is not archived", i)
+		}
+	}
+}
+
+func TestFavoriteRecordsUseTheNewestStateAndStayOutOfTheModelContext(t *testing.T) {
+	session, prompts := pageMarksTestSession(t)
+	contextBefore := len(session.BuildContext(nil))
+	for _, on := range []bool{true, true, false, true} {
+		if _, err := session.AppendCustomEntry(favoriteEntryType, map[string]any{"entryId": prompts[1], "favorite": on}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := session.AppendCustomEntry("other-extension", map[string]any{"entryId": prompts[0], "favorite": true}); err != nil {
+		t.Fatal(err)
+	}
+	favorites := favoriteTargets(session.GetBranch())
+	if !favorites[prompts[1]] || favorites[prompts[0]] || favorites[prompts[2]] {
+		t.Fatalf("favorites = %v", favorites)
+	}
+	if after := len(session.BuildContext(nil)); after != contextBefore {
+		t.Fatalf("a favorite record changed the model context from %d to %d messages", contextBefore, after)
+	}
+	if got := session.branchPages(session.GetBranch()); len(got) != 3 {
+		t.Fatalf("a favorite record changed the page count: %+v", got)
+	}
+}
+
+func TestCompactionKeepsOlderPromptsOnlyWhilePagesAreActive(t *testing.T) {
+	build := func(sess *Session) {
+		var prompts []string
+		for _, text := range []string{"old question", "kept question"} {
+			id, err := sess.AppendMessage(userMsg(text))
+			if err != nil {
+				t.Fatal(err)
+			}
+			prompts = append(prompts, id)
+			if _, err := sess.AppendMessage(assistantMsg("", ai.TextContent{Text: "reply to " + text})); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if _, err := sess.AppendCompaction("the summary", prompts[1], 100, nil, false, nil); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := sess.AppendMessage(userMsg("new question")); err != nil {
+			t.Fatal(err)
+		}
+	}
+	event := agent.CompactionEndEvent{Summary: "the summary", TokensBefore: 100}
+	for _, tc := range []struct {
+		name  string
+		pages bool
+		old   bool
+	}{{"pages keep the archived prompt", true, true}, {"regular transcript drops it", false, false}} {
+		t.Run(tc.name, func(t *testing.T) {
+			m := resumedModeWithOutputPad(t, 1, build)
+			m.pagesActive = tc.pages
+			m.renderCompactionResult(event, m.currentSession().BuildContextEntries())
+			got := renderedChat(m)
+			if strings.Contains(got, "old question") != tc.old {
+				t.Errorf("old prompt visible = %v, want %v:\n%s", !tc.old, tc.old, got)
+			}
+			for _, want := range []string{"kept question", "new question", "[compaction]"} {
+				if !strings.Contains(got, want) {
+					t.Errorf("transcript lacks %q:\n%s", want, got)
+				}
+			}
+			if strings.Count(got, "[compaction]") != 1 {
+				t.Errorf("compaction summary appears %d times:\n%s", strings.Count(got, "[compaction]"), got)
+			}
+		})
+	}
+}
