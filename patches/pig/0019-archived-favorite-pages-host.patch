+	pages.Move(1)
+	if got := pageText(pages); strings.Contains(got, "ARCHIVED") || !strings.Contains(got, FavoritePageLabel) {
+		t.Fatalf("second page marks: %s", got)
+	}
+	if reads != 1 {
+		t.Fatalf("marker read %d times without a refresh", reads)
+	}
+	marks = []PageMark{{}, {}, {}}
+	pages.RefreshMarks()
+	if got := pageText(pages); strings.Contains(got, FavoritePageLabel) {
+		t.Fatalf("refresh did not clear the label: %s", got)
+	}
+	if index, total := pages.Position(); index != 1 || total != 3 {
+		t.Fatalf("position = %d/%d", index, total)
+	}
+}
+
+func TestInteractionPagesMarkLinesAreFullWidthStyledAndKeepMouseRows(t *testing.T) {
+	prompt := pagePrompt("only")
+	source := NewContainer(prompt, NewText("reply"))
+	pages := NewInteractionPages(source)
+	pages.SetMarker(func() []PageMark { return []PageMark{{Archived: true, Favorite: true}} })
+	lines := pages.Render(60)
+	if len(lines) < 4 {
+		t.Fatalf("lines = %q", lines)
+	}
+	for _, line := range lines[1:3] {
+		if !strings.Contains(line, "\x1b[48;") || widthx.VisibleWidth(line) != 60 {
+			t.Fatalf("mark line is not a full-width background line: %q", line)
+		}
+	}
+	if !strings.Contains(lines[1], "\x1b[48;2;88;88;94m") || !strings.Contains(lines[2], "\x1b[48;2;230;190;60m") {
+		t.Skipf("terminal color mode is not true color: %q", lines[1:3])
+	}
+	// Page header plus two mark lines sit above the body, so a click on them reaches no body component.
+	for y := range 3 {
+		if pages.HandleMouse(TuiMouseEvent{Y: y, Height: 10}) != nil {
+			t.Fatalf("row %d reached the body", y)
+		}
+	}
+}
