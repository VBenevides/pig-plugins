+package tui
+
+import (
+	"context"
+	"slices"
+	"strings"
+	"testing"
+)
+
+func TestChatAutocompleteNamespaces(t *testing.T) {
+	p := NewChatAutocompleteProvider(skillTestCommands(), t.TempDir(), "")
+	for _, text := range []string{"/", "//"} {
+		got := p.GetSuggestions(t.Context(), []string{text}, 0, len(text), AutocompleteSuggestionOptions{Force: true})
+		if got == nil || len(got.Items) == 0 {
+			t.Fatalf("forced %q lost namespace suggestions", text)
+		}
+		want := []string{"help", "skill:humanizer", "skill:research-last30days", "skill:brainstorm"}
+		if text == "//" {
+			want = []string{"help"}
+		}
+		if gotValues := suggestionValues(got); !slices.Equal(gotValues, want) {
+			t.Fatalf("forced %q = %v, want %v", text, gotValues, want)
+		}
+	}
+	for _, text := range []string{"//skill:", "///", "draft /hel"} {
+		if got := p.GetSuggestions(t.Context(), []string{text}, 0, len(text), AutocompleteSuggestionOptions{}); got != nil {
+			for _, item := range got.Items {
+				if p.slash.hasCommand(item.Value) {
+					t.Fatalf("%q offered command %q", text, item.Value)
+				}
+			}
+		}
+	}
+	for _, text := range []string{"//hel", "/hel", " /hum", "first\n//hel", "first\n /hel"} {
+		lines := strings.Split(text, "\n")
+		row := len(lines) - 1
+		col := len(lines[row])
+		got := p.GetSuggestions(t.Context(), lines, row, col, AutocompleteSuggestionOptions{})
+		if got == nil || len(got.Items) != 1 {
+			t.Fatalf("%q suggestions=%+v", text, got)
+		}
+		out, _, cursor := p.ApplyCompletion(lines, row, col, got.Items[0], got.Prefix)
+		want := "//help "
+		switch text {
+		case "/hel":
+			want = "/help "
+		case " /hum":
+			want = " /skill:humanizer "
+		case "first\n /hel":
+			want = " /help "
+		}
+		if out[row] != want || cursor != len(want) {
+			t.Fatalf("%q completion=%q cursor=%d", text, out[row], cursor)
+		}
+	}
+}
+
+func TestChatCommandArgumentCompletions(t *testing.T) {
+	calls := 0
+	p := NewChatAutocompleteProvider([]SlashCommand{{Name: "model", GetArgumentCompletions: func(string) []AutocompleteItem { calls++; return []AutocompleteItem{{Value: "test"}} }, AwaitArgumentCompletions: func(string) ([]AutocompleteItem, error) { calls++; return []AutocompleteItem{{Value: "test"}}, nil }}}, t.TempDir(), "")
+	for _, text := range []string{"/model ", "//model "} {
+		if got := p.GetSuggestions(t.Context(), []string{text}, 0, len(text), AutocompleteSuggestionOptions{}); got == nil {
+			t.Fatalf("%q missing argument completion", text)
+		}
+		_, task, ok := p.SuggestionTask([]string{text}, 0, len(text), false)
+		if !ok {
+			t.Fatalf("%q missing async completion", text)
+		}
+		if _, err := task(context.Background()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if calls != 4 {
+		t.Fatalf("calls=%d", calls)
+	}
+}
