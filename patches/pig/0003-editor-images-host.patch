+package codingagent
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/MichaelKinsy/PiG/coding/extension"
+	"github.com/MichaelKinsy/PiG/tui/widthx"
+)
+
+func clearEditorHandler(sc *SlashContext) error {
+	if sc.Args != "" {
+		return fmt.Errorf("usage: /clear")
+	}
+	if sc.ClearEditor == nil {
+		return fmt.Errorf("/clear requires an interactive editor")
+	}
+	sc.ClearEditor()
+	return nil
+}
+
+func sendEditorHandler(queue bool) SlashHandler {
+	name := "//send-steer"
+	if queue {
+		name = "//send-queue"
+	}
+	return func(sc *SlashContext) error {
+		if sc.Args != "" {
+			return fmt.Errorf("usage: %s", name)
+		}
+		if sc.SendEditor == nil {
+			return fmt.Errorf("%s requires an interactive editor", name)
+		}
+		sc.SendEditor(queue)
+		return nil
+	}
+}
+
+// handleInlineEditorCommand runs local commands before the editor submit path
+// can clear the draft or resolve the idle getUserInput promise.
+func (m *InteractiveMode) handleInlineEditorCommand(ctx context.Context) bool {
+	m.syncExtensionSlashCommands()
+	command, ok := m.editor.TakeInlineCommand(func(name string) bool {
+		_, found := m.slashRegistry.Resolve(name)
+		return found
+	})
+	if !ok {
+		return false
+	}
+	name, _ := parseSlashLine(chatCommandLine(command))
+	canonical, _ := m.slashRegistry.Resolve(name)
+	if canonical == "clear" || canonical == "send-queue" || canonical == "send-steer" || canonical == "quit" {
+		m.dispatchSlash(ctx, command)
+	} else {
+		m.dispatchSlash(ctx, command, m.editor.RestoreDraftIfCleared())
+	}
+	return true
+}
+
+func (m *InteractiveMode) sendEditorDraft(ctx context.Context, queue bool) {
+	text := widthx.JSTrim(m.editor.GetExpandedText())
+	if text == "" {
+		return
+	}
+	m.editor.AddToHistory(text)
+	m.editor.Clear()
+	if !queue {
+		// Send as prompt text, not another command: //send-steer must not execute a
+		// second slash token left in the draft.
+		if m.isCompacting {
+			m.compactionQueue = append(m.compactionQueue, compactionQueuedMessage{text: text, mode: compactionQueueSteer})
+			m.showStatus("Queued message for after compaction")
+			m.updatePendingMessagesDisplay()
+			return
+		}
+		m.promptUserInput(ctx, text, nil, false, extension.InputSourceUser, true)
+		return
+	}
+	if m.isCompacting {
+		m.compactionQueue = append(m.compactionQueue, compactionQueuedMessage{text: text, mode: compactionQueueFollowUp})
+		m.showStatus("Queued message for after compaction")
+		m.updatePendingMessagesDisplay()
+		return
+	}
+	m.promptUserInput(ctx, text, nil, true, extension.InputSourceUser, true)
+}
