+package codingagent
+
+import (
+	"context"
+	"testing"
+)
+
+func TestChatCommandsRequireDoubleSlashAfterText(t *testing.T) {
+	q := newInputQueueMode(t)
+	defer q.stop()
+	defer q.backgroundCancel()
+	q.isCompacting = true
+	calls := 0
+	q.slashRegistry.Register(BuiltinSlashCommand{Name: "example", TakesArguments: true, Handler: func(sc *SlashContext) error {
+		calls++
+		if sc.Args != "argument" {
+			t.Fatalf("args = %q", sc.Args)
+		}
+		return nil
+	}})
+	for _, text := range []string{"explain /example argument", "//unknown", "//skill:example"} {
+		q.editor.SetText(text)
+		if q.handleInlineEditorCommand(context.Background()) {
+			t.Fatalf("executed literal %q", text)
+		}
+		q.handleSubmit(context.Background(), text)
+		if calls != 0 {
+			t.Fatalf("dispatched %q", text)
+		}
+	}
+	if len(q.compactionQueue) != 3 {
+		t.Fatalf("queue = %+v", q.compactionQueue)
+	}
+	q.handleSubmit(context.Background(), "//example argument")
+	if calls != 1 || len(q.compactionQueue) != 3 {
+		t.Fatalf("calls=%d queue=%+v", calls, q.compactionQueue)
+	}
+	q.editor.SetText("draft //example argument")
+	if !q.handleInlineEditorCommand(context.Background()) || calls != 2 || q.editor.Text() != "draft " {
+		t.Fatal("inline command failed")
+	}
+}
