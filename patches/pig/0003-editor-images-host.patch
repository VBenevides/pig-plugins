+package codingagent
+
+import (
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/coding/extension"
+	"github.com/MichaelKinsy/PiG/coding/extension/host/inproc"
+)
+
+func TestChatLineStartCommands(t *testing.T) {
+	q := newInputQueueMode(t)
+	defer q.stop()
+	defer q.backgroundCancel()
+	q.isCompacting = true
+	calls := 0
+	q.slashRegistry.Register(BuiltinSlashCommand{Name: "example", Handler: func(sc *SlashContext) error {
+		calls++
+		if sc.Args != "argument" {
+			t.Errorf("args=%q", sc.Args)
+		}
+		return nil
+	}})
+	for _, text := range []string{"/example argument", " \t/example argument", "//example argument"} {
+		prevCalls := calls
+		q.handleSubmit(t.Context(), text)
+		if calls != prevCalls+1 || len(q.compactionQueue) != 0 {
+			t.Fatalf("%q calls=%d queue=%v", text, calls, q.compactionQueue)
+		}
+	}
+	for _, text := range []string{"before /example argument", "/skill:example", "//skill:example"} {
+		q.editor.SetText(text)
+		if q.handleInlineEditorCommand(t.Context()) || q.editor.Text() != text {
+			t.Fatalf("executed %q", text)
+		}
+	}
+	q.editor.SetText("earlier prose\n  /example argument")
+	if !q.handleInlineEditorCommand(t.Context()) || calls != 4 || q.editor.Text() != "earlier prose\n  " {
+		t.Fatalf("later line calls=%d draft=%q", calls, q.editor.Text())
+	}
+}
+
+func TestChatLineStartTemplateExpansion(t *testing.T) {
+	m, ctx, _ := newStreamingRoutingMode(t)
+	m.promptTemplates = []PromptTemplate{{Name: "review", Content: "Review: $ARGUMENTS"}}
+	onLoop(m, ctx, func() {
+		for _, text := range []string{"/review first", "//review second", "explain /review third"} {
+			m.promptUserInput(ctx, text, nil, false, "user", true)
+		}
+		steering, _ := m.agent.PendingMessages()
+		if len(steering) != 3 {
+			t.Errorf("steering=%v", steering)
+			return
+		}
+		for i, want := range []string{"Review: first", "Review: second", "explain /review third"} {
+			if got := extractAgentMessageText(steering[i]); got != want {
+				t.Errorf("message %d=%q want %q", i, got, want)
+			}
+		}
+	})
+}
+
+func TestChatLineStartSendCommands(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		mode compactionQueueMode
+	}{
+		{"send-steer", compactionQueueSteer},
+		{"send-queue", compactionQueueFollowUp},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			q := newInputQueueMode(t)
+			defer q.stop()
+			defer q.backgroundCancel()
+			q.isCompacting = true
+			q.editor.SetText("draft\n/" + tc.name)
+			if !q.handleInlineEditorCommand(t.Context()) || q.editor.Text() != "" || len(q.compactionQueue) != 1 {
+				t.Fatalf("draft=%q queue=%v", q.editor.Text(), q.compactionQueue)
+			}
+			if got := q.compactionQueue[0]; got.text != "draft" || got.mode != tc.mode {
+				t.Fatalf("queued=%v", got)
+			}
+		})
+	}
+}
+
+func TestChatLineStartExtensionRecognition(t *testing.T) {
+	q := newInputQueueMode(t)
+	defer q.stop()
+	defer q.backgroundCancel()
+	q.newRunner = inproc.NewRunner([]extension.Extension{{Name: "test", Commands: map[string]extension.RegisteredCommand{
+		"example": {Name: "example"},
+	}}}, t.TempDir())
+	for _, tc := range []struct {
+		text string
+		want bool
+	}{
+		{"/example", true},
+		{"  /example argument", true},
+		{"//example", true},
+		{"before /example", false},
+		{"/skill:example", false},
+		{"//skill:example", false},
+		{"///example", false},
+	} {
+		if got := q.isExtensionCommand(tc.text); got != tc.want {
+			t.Errorf("%q = %v, want %v", tc.text, got, tc.want)
+		}
+	}
+}
