diff --git a/tui/editor_select_all.go b/tui/editor_select_all.go
new file mode 100644
index 0000000..8eb01b0
--- /dev/null
+++ b/tui/editor_select_all.go
@@ -0,0 +1,79 @@
+package tui
+
+import (
+	"strings"
+	"unicode/utf8"
+)
+
+// Whole-text selection for the editor (pig additive). tui.editor.selectAll marks everything selected; typing or
+// pasting replaces it, a delete key removes it, and any other key (movement, Enter, Escape, ...) clears the mark
+// and acts normally. There is no partial selection and no clipboard action.
+
+// handleSelectAll reports whether it consumed data. It runs before autocomplete and ordinary editing.
+func (e *Editor) handleSelectAll(data string) bool {
+	kb := GetTUIKeybindings()
+	if kb.Matches(data, KBEditorSelectAll) {
+		if e.Text() != "" {
+			e.AutocompleteCancel()
+			e.lastAction = ""
+			e.selectedAll = true
+			e.Invalidate()
+		}
+		return true
+	}
+	if !e.selectedAll {
+		return false
+	}
+	switch {
+	case kb.Matches(data, KBEditorDeleteCharBack), kb.Matches(data, KBEditorDeleteCharForward),
+		kb.Matches(data, KBEditorDeleteWordBack), kb.Matches(data, KBEditorDeleteWordForward),
+		kb.Matches(data, KBEditorDeleteToLineStart), kb.Matches(data, KBEditorDeleteToLineEnd):
+		e.saveHistory()
+		e.clearAllText()
+		return true
+	case isTypedText(data):
+		e.saveHistory()
+		e.clearAllText()
+		e.lastAction = "type-word" // The undo state above already holds the replaced text.
+		return false
+	}
+	e.selectedAll = false
+	e.Invalidate()
+	return false
+}
+
+// clearAllText empties the editor without recording an undo state; callers record it first.
+func (e *Editor) clearAllText() {
+	e.AutocompleteCancel()
+	e.selectedAll = false
+	e.lastAction = ""
+	e.inputHistIdx = -1
+	e.inputHistSaved = nil
+	e.pastes = nil
+	e.pasteCounter = 0
+	e.lines = []string{""}
+	e.cursor = [2]int{0, 0}
+	e.Invalidate()
+}
+
+// isTypedText reports whether data is printable text rather than a control byte or an escape sequence.
+func isTypedText(data string) bool {
+	if data == "" || strings.HasPrefix(data, "\x1b") || !utf8.ValidString(data) {
+		return false
+	}
+	for _, r := range data {
+		if r < 0x20 || r == 0x7f {
+			return false
+		}
+	}
+	return true
+}
+
+// selectedRow draws one row of selected text in reverse video. An empty row still shows one selected cell so a
+// selected line break is visible.
+func selectedRow(text string) string {
+	if text == "" {
+		text = " "
+	}
+	return "\x1b[7m" + text + "\x1b[27m"
+}
diff --git a/tui/editor_select_all_test.go b/tui/editor_select_all_test.go
new file mode 100644
index 0000000..351dc52
--- /dev/null
+++ b/tui/editor_select_all_test.go
@@ -0,0 +1,130 @@
+package tui
+
+import (
+	"strings"
+	"testing"
+)
+
+// selectAllKeys binds ctrl+a to select all and leaves home for the line start, as config/agent/keybindings.json does.
+func selectAllKeys(t *testing.T) {
+	t.Helper()
+	previous := globalTUIKeybindings
+	SetTUIKeybindings(NewTUIKeybindingsManager(map[string][]string{
+		string(KBEditorSelectAll):       {"ctrl+a"},
+		string(KBEditorCursorLineStart): {"home"},
+	}))
+	t.Cleanup(func() { globalTUIKeybindings = previous })
+}
+
+func newSelected(t *testing.T, text string) *Editor {
+	t.Helper()
+	selectAllKeys(t)
+	e := NewEditor()
+	e.SetText(text)
+	e.HandleInput("\x01")
+	return e
+}
+
+func plainRows(e *Editor, width int) string {
+	return stripANSI(strings.Join(e.Render(width), "\n"))
+}
+
+func TestSelectAllMarksTheWholeTextAndRendersItReversed(t *testing.T) {
+	e := newSelected(t, "alpha beta\ngamma")
+	if !e.selectedAll {
+		t.Fatal("ctrl+a must select all")
+	}
+	rendered := strings.Join(e.Render(40), "\n")
+	if strings.Count(rendered, "\x1b[7m") < 2 || !strings.Contains(plainRows(e, 40), "alpha beta") || !strings.Contains(plainRows(e, 40), "gamma") {
+		t.Fatalf("every text row must be drawn reversed: %q", rendered)
+	}
+	if e.Text() != "alpha beta\ngamma" {
+		t.Fatalf("selecting must not change the text: %q", e.Text())
+	}
+}
+
+func TestSelectAllOnAnEmptyEditorSelectsNothing(t *testing.T) {
+	selectAllKeys(t)
+	e := NewEditor()
+	e.HandleInput("\x01")
+	if e.selectedAll {
+		t.Fatal("there is nothing to select")
+	}
+	e.HandleInput("x")
+	if e.Text() != "x" {
+		t.Fatalf("typing still works: %q", e.Text())
+	}
+}
+
+func TestTypingOrPastingReplacesTheSelectionAndUndoRestoresIt(t *testing.T) {
+	e := newSelected(t, "old text")
+	e.HandleInput("N")
+	e.HandleInput("ew")
+	if e.Text() != "New" || e.selectedAll {
+		t.Fatalf("typing must replace the selection, got %q", e.Text())
+	}
+	e.HandleInput("\x1f") // ctrl+- undo: one step restores the replaced text.
+	if e.Text() != "old text" {
+		t.Fatalf("undo must bring the replaced text back, got %q", e.Text())
+	}
+
+	e = newSelected(t, "old text")
+	e.HandleInput("\x1b[200~pasted\nlines\x1b[201~")
+	if got := e.Text(); !strings.Contains(got, "pasted") || strings.Contains(got, "old") {
+		t.Fatalf("a paste must replace the selection, got %q", got)
+	}
+}
+
+func TestDeleteKeysRemoveTheSelectionAndOnlyThat(t *testing.T) {
+	for name, key := range map[string]string{"backspace": "\x7f", "delete": "\x1b[3~", "ctrl+w": "\x17", "ctrl+u": "\x15", "ctrl+k": "\x0b"} {
+		e := newSelected(t, "one two\nthree")
+		e.HandleInput(key)
+		if e.Text() != "" || e.selectedAll {
+			t.Errorf("%s must delete the selected text, got %q selected=%v", name, e.Text(), e.selectedAll)
+		}
+		e.HandleInput("\x1f")
+		if e.Text() != "one two\nthree" {
+			t.Errorf("%s: undo must restore the text, got %q", name, e.Text())
+		}
+	}
+}
+
+func TestOtherKeysClearTheSelectionWithoutChangingTheText(t *testing.T) {
+	for name, key := range map[string]string{"left": "\x1b[D", "right": "\x1b[C", "home": "\x1b[H", "end": "\x1b[F", "escape": "\x1b", "up": "\x1b[A"} {
+		e := newSelected(t, "keep me")
+		e.HandleInput(key)
+		if e.selectedAll || e.Text() != "keep me" {
+			t.Errorf("%s: selected=%v text=%q", name, e.selectedAll, e.Text())
+		}
+	}
+	e := newSelected(t, "submit me")
+	var submitted string
+	e.OnSubmit = func(text string) { submitted = text }
+	e.HandleInput("\r")
+	if submitted != "submit me" {
+		t.Fatalf("Enter must submit the whole text, got %q", submitted)
+	}
+}
+
+func TestSelectAllIsOffUntilBoundAndKeepsLineStartOnCtrlA(t *testing.T) {
+	previous := globalTUIKeybindings
+	SetTUIKeybindings(NewTUIKeybindingsManager(nil))
+	t.Cleanup(func() { globalTUIKeybindings = previous })
+	if keys := GetTUIKeybindings().GetKeys(string(KBEditorSelectAll)); len(keys) != 0 {
+		t.Fatalf("select all must have no default key, got %v", keys)
+	}
+	e := NewEditor()
+	e.SetText("hello")
+	e.HandleInput("\x01")
+	if e.selectedAll || e.cursor[1] != 0 {
+		t.Fatalf("by default ctrl+a still moves to the line start: selected=%v col=%d", e.selectedAll, e.cursor[1])
+	}
+}
+
+func TestSetTextClearsTheSelection(t *testing.T) {
+	e := newSelected(t, "first")
+	e.SetText("second")
+	if e.selectedAll {
+		t.Fatal("replacing the text must clear the selection")
+	}
+}
