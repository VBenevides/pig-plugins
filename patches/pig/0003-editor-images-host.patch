new file mode 100644
index 0000000..4e755bb
--- /dev/null
+++ b/coding/extension/host/subprocess/conditional_editor.go
@@ -0,0 +1,38 @@
+package subprocess
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+
+	"github.com/MichaelKinsy/PiG/coding/extension"
+)
+
+// Optional additive capability: compare and replacement must share the editor owner loop.
+type conditionalEditorUI interface {
+	CompareAndSetEditorText(context.Context, string, string) (bool, error)
+}
+
+func (b *UIBridge) handleCompareAndSetEditorText(ctx context.Context, ui extension.UIContext, args json.RawMessage) (*CallResultPayload, error) {
+	var p struct {
+		Expected string `json:"expected"`
+		Text     string `json:"text"`
+	}
+	if err := json.Unmarshal(args, &p); err != nil {
+		return nil, fmt.Errorf("parse compareAndSetEditorText args: %w", err)
+	}
+	applied := false
+	if ui != extension.NoopUIContext {
+		conditional, ok := ui.(conditionalEditorUI)
+		if !ok {
+			return nil, fmt.Errorf("UI does not support atomic editor replacement")
+		}
+		var err error
+		applied, err = conditional.CompareAndSetEditorText(ctx, p.Expected, p.Text)
+		if err != nil {
+			return nil, fmt.Errorf("replace unchanged editor text: %w", err)
+		}
+	}
+	result, err := json.Marshal(map[string]bool{"applied": applied})
+	return &CallResultPayload{Result: result}, err
+}
diff --git a/coding/extension/host/subprocess/conditional_editor_test.go b/coding/extension/host/subprocess/conditional_editor_test.go
