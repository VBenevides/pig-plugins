+package codingagent
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/MichaelKinsy/PiG/agent"
+	"github.com/MichaelKinsy/PiG/ai"
+
+	"github.com/MichaelKinsy/PiG/tui"
+)
+
+func TestInlineCommandRunsWithoutSubmittingDraft(t *testing.T) {
+	for _, idle := range []bool{true, false} {
+		q := newInputQueueMode(t)
+		q.isIdle = idle
+		q.editor.SetText("explain this //mode ask")
+		q.editor.OnSubmit = func(string) { t.Fatal("local command submitted the draft") }
+		calls := 0
+		q.slashRegistry.Register(BuiltinSlashCommand{Name: "mode", TakesArguments: true, Handler: func(sc *SlashContext) error {
+			calls++
+			if sc.Args != "ask" {
+				t.Fatalf("args = %q", sc.Args)
+			}
+			q.editor.Clear() // Commands that clear input must still preserve the draft.
+			return nil
+		}})
+		if err := q.handleEditorAction(context.Background(), actionSubmit, "\r"); err != nil {
+			t.Fatal(err)
+		}
+		if calls != 1 || q.editor.Text() != "explain this " {
+			t.Fatalf("idle=%v calls=%d draft=%q", idle, calls, q.editor.Text())
+		}
+		q.stop()
+		q.backgroundCancel()
+	}
+}
+
+func TestInlineClearDiscardsOnlyInput(t *testing.T) {
+	q := newInputQueueMode(t)
+	defer q.stop()
+	defer q.backgroundCancel()
+	q.chatContainer.Add(tui.NewText("conversation remains"))
+	q.editor.SetText("discard this //clear")
+	if !q.handleInlineEditorCommand(context.Background()) {
+		t.Fatal("clear not handled")
+	}
+	if q.editor.Text() != "" || len(q.chatContainer.Render(80)) == 0 {
+		t.Fatal("clear did not discard just the input")
+	}
+}
+
+func TestInlineSendQueuesDraftOnceDuringCompaction(t *testing.T) {
+	for _, tc := range []struct {
+		command string
+		mode    compactionQueueMode
+	}{
+		{"//send-steer", compactionQueueSteer},
+		{"//send-queue", compactionQueueFollowUp},
+	} {
+		t.Run(tc.command, func(t *testing.T) {
+			q := newInputQueueMode(t)
+			defer q.stop()
+			defer q.backgroundCancel()
+			q.isCompacting = true
+			q.editor.SetText("send this draft " + tc.command)
+			if !q.handleInlineEditorCommand(context.Background()) {
+				t.Fatal("send not handled")
+			}
+			if q.editor.Text() != "" || len(q.compactionQueue) != 1 || q.compactionQueue[0].text != "send this draft" || q.compactionQueue[0].mode != tc.mode {
+				t.Fatalf("draft=%q queue=%+v", q.editor.Text(), q.compactionQueue)
+			}
+			if q.handleInlineEditorCommand(context.Background()) || len(q.compactionQueue) != 1 {
+				t.Fatal("send duplicated a queued message")
+			}
+		})
+	}
+}
+
+func TestDraftCommandValidationDoesNotDiscardInput(t *testing.T) {
+	q := newInputQueueMode(t)
+	defer q.stop()
+	defer q.backgroundCancel()
+	q.editor.SetText("keep this //send-steer invalid")
+	if !q.handleInlineEditorCommand(context.Background()) || q.editor.Text() != "keep this " {
+		t.Fatal("invalid send lost draft")
+	}
+	for _, line := range []string{"/clear invalid", "/send-steer invalid", "/send-queue invalid"} {
+		sc := q.buildSlashContext(context.Background())
+		if err := q.slashRegistry.Dispatch(sc, line, nil); err == nil {
+			t.Fatalf("%q accepted invalid arguments", line)
+		}
+	}
+}
+
+func TestSendCommandsRejectOldSyntaxAndEmptyDrafts(t *testing.T) {
+	q := newInputQueueMode(t)
+	defer q.stop()
+	defer q.backgroundCancel()
+	for _, text := range []string{"draft //send queue", "draft //send steer", "draft /send-queue", "draft /send-steer"} {
+		q.editor.SetText(text)
+		if q.handleInlineEditorCommand(context.Background()) || q.editor.Text() != text {
+			t.Fatalf("obsolete or literal command executed: %q", text)
+		}
+	}
+	if _, ok := q.slashRegistry.Resolve("send"); ok {
+		t.Fatal("old send command registered")
+	}
+	for _, idle := range []bool{true, false} {
+		q.isIdle = idle
+		for _, name := range []string{"send-queue", "send-steer"} {
+			q.editor.Clear()
+			q.handleSubmit(context.Background(), "//"+name)
+			if q.editor.Text() != "" || len(q.compactionQueue) != 0 {
+				t.Fatal("empty draft queued")
+			}
+			if err := q.slashRegistry.Dispatch(&SlashContext{}, "/"+name, nil); err == nil {
+				t.Fatal("missing editor accepted")
+			}
+		}
+	}
+}
+
+func TestSendCommandsWhileStreaming(t *testing.T) {
+	m, ctx, _ := newStreamingRoutingMode(t)
+	onLoop(m, ctx, func() {
+		for _, name := range []string{"send-steer", "send-queue"} {
+			m.editor.SetText("draft " + name + " //" + name)
+			if !m.handleInlineEditorCommand(ctx) || m.editor.Text() != "" {
+				t.Errorf("%s did not send draft", name)
+			}
+		}
+		steering, followUps := m.agent.PendingMessages()
+		if len(steering) != 1 || extractAgentMessageText(steering[0]) != "draft send-steer" || len(followUps) != 1 || extractAgentMessageText(followUps[0]) != "draft send-queue" {
+			t.Errorf("steering=%v followUps=%v", steering, followUps)
+		}
+	})
+}
+
+func TestSendCommandsWhileIdle(t *testing.T) {
+	for _, name := range []string{"send-steer", "send-queue"} {
+		t.Run(name, func(t *testing.T) {
+			q := newInputQueueMode(t)
+			defer q.stop()
+			defer q.backgroundCancel()
+			provider := captureStreamOptionsProvider{seen: make(chan capturedStreamRequest, 2)}
+			model := &ai.Model{ID: "capture", Provider: provider}
+			q.opts.Model = model
+			var err error
+			q.agent, err = agent.NewAgent(agent.AgentOptions{Model: model, StreamFn: providerStreamFn})
+			if err != nil {
+				t.Fatal(err)
+			}
+			q.isIdle = true
+			loopDone := make(chan struct{})
+			go q.drainLoop(q.runCtx, loopDone)
+			defer func() { q.stop(); <-loopDone }()
+			onLoop(q.InteractiveMode, q.runCtx, func() {
+				q.editor.SetText("idle draft //" + name)
+				if !q.handleInlineEditorCommand(q.runCtx) || q.editor.Text() != "" {
+					t.Error("idle draft not sent")
+				}
+			})
+			select {
+			case request := <-provider.seen:
+				if got := lastUserMessageText(t, request.Messages); got != "idle draft" {
+					t.Fatalf("prompt=%q", got)
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("idle send did not start a turn")
+			}
+			deadline := time.Now().Add(5 * time.Second)
+			for q.turnActive.Load() && time.Now().Before(deadline) {
+				time.Sleep(time.Millisecond)
+			}
+			if q.turnActive.Load() {
+				t.Fatal("idle turn did not settle")
+			}
+			select {
+			case <-provider.seen:
+				t.Fatal("draft sent twice")
+			default:
+			}
+		})
+	}
+}
