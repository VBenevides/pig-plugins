+// missingToolMessage is the error for an unknown tool name. When tool_search is
+// active the tool may be a deferred one that was released earlier, so the message
+// says how to load it again. The "Tool NAME not found" prefix stays unchanged.
+func missingToolMessage(tools []AgentTool, name string) string {
+	message := "Tool " + name + " not found"
+	if findTool(tools, "tool_search") != nil {
+		message += ". If it is a deferred tool, it is not loaded now. Call tool_search with a query for it, then call it again"
+	}
+	return message
+}
