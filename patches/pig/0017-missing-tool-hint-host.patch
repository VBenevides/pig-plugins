+package agent
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestMissingToolMessageHintsToolSearchOnlyWhenActive(t *testing.T) {
+	without := missingToolMessage([]AgentTool{iserrorTool("bash", nil)}, "todo")
+	if without != "Tool todo not found" {
+		t.Fatalf("without tool_search = %q", without)
+	}
+	with := missingToolMessage([]AgentTool{iserrorTool("tool_search", nil)}, "todo")
+	if !strings.HasPrefix(with, "Tool todo not found") || !strings.Contains(with, "Call tool_search") {
+		t.Fatalf("with tool_search = %q", with)
+	}
+}
