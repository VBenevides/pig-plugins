+package codingagent
+
+import (
+	"context"
+	"sync"
+	"time"
+)
+
+// CompareAndSetEditorText applies a background draft transform only if typing or
+// submission has not changed the expanded text. All editor access stays on its owner.
+func (u *ExtUIContext) CompareAndSetEditorText(ctx context.Context, expected, text string) (bool, error) {
+	// Bound cleanup even if the owner loop is shutting down or in a modal phase.
+	ctx, cancel := context.WithTimeout(ctx, time.Second)
+	defer cancel()
+	apply := func() bool {
+		if ctx.Err() != nil || u.m.editor == nil || u.m.editor.GetExpandedText() != expected {
+			return false
+		}
+		u.m.editor.SetText(text)
+		if u.m.tuiInst != nil {
+			u.m.requestRender()
+		}
+		return true
+	}
+	if err := ctx.Err(); err != nil {
+		return false, err
+	}
+	if u.m.runCtx == nil {
+		return apply(), nil
+	}
+	var mu sync.Mutex
+	applied, cancelled := false, false
+	result := make(chan struct{}, 1)
+	if err := u.m.postToMain(ctx, func() {
+		mu.Lock()
+		if !cancelled {
+			applied = apply()
+		}
+		mu.Unlock()
+		result <- struct{}{}
+	}); err != nil {
+		return false, err
+	}
+	var err error
+	select {
+	case <-result:
+	case <-ctx.Done():
+		err = ctx.Err()
+	case <-u.m.runCtx.Done():
+		err = context.Cause(u.m.runCtx)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	cancelled = true
+	if applied {
+		return true, nil
+	}
+	if err == nil {
+		err = ctx.Err()
+	}
+	return false, err
+}
