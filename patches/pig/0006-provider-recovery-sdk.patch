@@ -0,0 +1,30 @@
+package sdk
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestProviderGenerationReplayDeclaration(t *testing.T) {
+	stream := func(map[string]any, map[string]any, ProviderStreamOptions) (*ModelEventStream, error) {
+		return nil, nil
+	}
+	for _, prohibited := range []bool{false, true} {
+		provider := &Provider{ID: "synthetic", ReplayProhibited: prohibited, GetModels: func() ([]map[string]any, error) { return nil, nil }, Stream: stream, StreamSimple: stream, Auth: ProviderAuth{APIKey: &APIKeyAuth{Resolve: func(APIKeyAuthInput) (*AuthResult, error) { return nil, nil }}}}
+		decl, err := providerDeclaration(provider, "key")
+		if err != nil {
+			t.Fatal(err)
+		}
+		data, err := json.Marshal(decl)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var restored providerObjectDeclaration
+		if err = json.Unmarshal(data, &restored); err != nil {
+			t.Fatal(err)
+		}
+		if restored.ReplayProhibited != prohibited {
+			t.Fatalf("lost declaration: %s", data)
+		}
+	}
+}
