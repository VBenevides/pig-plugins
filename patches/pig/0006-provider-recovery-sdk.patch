diff --git a/provider_backpressure.go b/provider_backpressure.go
new file mode 100644
index 0000000..56103a8
--- /dev/null
+++ b/provider_backpressure.go
@@ -0,0 +1,37 @@
+package sdk
+
+import "context"
+
+// PushWithBackpressure queues one event, waiting for any preceding event to
+// leave the SDK queue. Use one serialized producer per stream; do not mix this
+// with concurrent Push calls. Events must be immutable and caller-size-bounded.
+// Cancellation never queues the event; callers still own terminal reporting.
+func (s *ModelEventStream) PushWithBackpressure(ctx context.Context, event map[string]any) error {
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		s.mu.Lock()
+		if s.terminal {
+			s.mu.Unlock()
+			return nil
+		}
+		if len(s.queue) == 0 {
+			s.mu.Unlock()
+			s.push(event)
+			return nil
+		}
+		if s.drained == nil {
+			s.drained = make(chan struct{})
+		}
+		drained, done := s.drained, s.done
+		s.mu.Unlock()
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-done:
+			return nil
+		case <-drained:
+		}
+	}
+}
diff --git a/provider_backpressure_test.go b/provider_backpressure_test.go
new file mode 100644
index 0000000..9bc1184
--- /dev/null
+++ b/provider_backpressure_test.go
@@ -0,0 +1,71 @@
+package sdk
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestProviderBackpressureCancellationAndOrder(t *testing.T) {
+	s := CreateAssistantMessageEventStream()
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	if err := s.PushWithBackpressure(ctx, map[string]any{"type": "start"}); err != nil {
+		t.Fatal(err)
+	}
+	waiting := make(chan error, 1)
+	go func() {
+		waiting <- s.PushWithBackpressure(ctx, map[string]any{"type": "text_delta", "delta": "second"})
+	}()
+	select {
+	case err := <-waiting:
+		t.Fatalf("producer escaped unread event: %v", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+	cancel()
+	if err := <-waiting; !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancel=%v", err)
+	}
+	s.mu.Lock()
+	queued := len(s.queue)
+	s.mu.Unlock()
+	if queued != 1 {
+		t.Fatalf("queued=%d", queued)
+	}
+	s.Push(map[string]any{"type": "done", "message": map[string]any{"ok": true}})
+	events := s.Events(t.Context())
+	if first := <-events; first["type"] != "start" {
+		t.Fatalf("first=%v", first)
+	}
+	if last := <-events; last["type"] != "done" {
+		t.Fatalf("last=%v", last)
+	}
+	if _, open := <-events; open {
+		t.Fatal("stream did not close")
+	}
+}
+
+func TestProviderBackpressureResumesOnDrain(t *testing.T) {
+	s := CreateAssistantMessageEventStream()
+	if err := s.PushWithBackpressure(t.Context(), map[string]any{"type": "start"}); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() {
+		done <- s.PushWithBackpressure(t.Context(), map[string]any{"type": "done", "message": map[string]any{"ok": true}})
+	}()
+	events := s.Events(t.Context())
+	if (<-events)["type"] != "start" {
+		t.Fatal("order")
+	}
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if (<-events)["type"] != "done" {
+		t.Fatal("terminal lost")
+	}
+	if s.Result()["ok"] != true {
+		t.Fatal("result lost")
+	}
+}
