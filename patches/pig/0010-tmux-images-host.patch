+package tui
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/MichaelKinsy/PiG/internal/linkerexec"
+)
+
+const tmuxDCS = "\x1bPtmux;"
+
+var tmuxImageProbe = probeTmuxImages
+
+func insideTmux() bool {
+	return os.Getenv("TMUX") != "" || strings.HasPrefix(strings.ToLower(os.Getenv("TERM")), "tmux")
+}
+
+// Probe the attached client, not inherited outer-terminal environment hints.
+// A failed or timed-out probe leaves the existing text fallback in use.
+func probeTmuxImages() ImageProtocol {
+	ctx, cancel := context.WithTimeout(context.Background(), tmuxProbeTimeout)
+	defer cancel()
+	out, err := linkerexec.CommandContext(ctx, "tmux", "display-message", "-p", "#{allow-passthrough}\n#{client_termtype}\n#{client_termname}").Output()
+	if err != nil {
+		return ""
+	}
+	return tmuxImageProtocol(string(out))
+}
+
+func tmuxImageProtocol(output string) ImageProtocol {
+	fields := strings.Split(strings.TrimSpace(strings.ToLower(output)), "\n")
+	if len(fields) != 3 || (fields[0] != "on" && fields[0] != "all") {
+		return ""
+	}
+	for _, terminal := range fields[1:] {
+		switch terminal {
+		case "kitty", "xterm-kitty", "ghostty", "xterm-ghostty", "wezterm":
+			return ImageProtocolKitty
+		}
+	}
+	return ""
+}
+
+func wrapTmuxKitty(command string) string {
+	if !insideTmux() {
+		return command
+	}
+	return tmuxDCS + strings.ReplaceAll(command, "\x1b", "\x1b\x1b") + "\x1b\\"
+}
+
+// unwrapTmuxKitty is limited to the envelopes emitted by this encoder.
+func unwrapTmuxKitty(line string) string {
+	var result strings.Builder
+	for {
+		start := strings.Index(line, tmuxDCS)
+		if start < 0 {
+			result.WriteString(line)
+			break
+		}
+		result.WriteString(line[:start])
+		rest := line[start+len(tmuxDCS):]
+		var payload strings.Builder
+		end := -1
+		for i := 0; i < len(rest); i++ {
+			if rest[i] == '\x1b' && i+1 < len(rest) {
+				if rest[i+1] == '\x1b' {
+					payload.WriteByte('\x1b')
+					i++
+					continue
+				}
+				if rest[i+1] == '\\' {
+					end = i + 2
+					break
+				}
+			}
+			payload.WriteByte(rest[i])
+		}
+		if end < 0 {
+			result.WriteString(line[start:])
+			break
+		}
+		result.WriteString(payload.String())
+		line = rest[end:]
+	}
+	return result.String()
+}
+
+func wrapKittyCommands(line string) string {
+	var result strings.Builder
+	for {
+		start := strings.Index(line, kittyPrefix)
+		if start < 0 {
+			result.WriteString(line)
+			break
+		}
+		end := strings.Index(line[start:], "\x1b\\")
+		if end < 0 {
+			result.WriteString(line)
+			break
+		}
+		end += start + 2
+		result.WriteString(line[:start])
+		result.WriteString(wrapTmuxKitty(line[start:end]))
+		line = line[end:]
+	}
+	return result.String()
+}
+
+// Kitty's fixed row/column diacritic mapping, not a Unicode codepoint offset.
+// https://sw.kovidgoyal.net/kitty/graphics-protocol/#unicode-placeholders
