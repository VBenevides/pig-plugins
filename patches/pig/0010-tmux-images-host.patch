+package tui
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/tui/widthx"
+)
+
+func TestTmuxImageDetection(t *testing.T) {
+	for _, tc := range []struct {
+		output string
+		want   ImageProtocol
+	}{
+		{"on\nxterm-kitty\nkitty\n", ImageProtocolKitty},
+		{"all\nxterm-ghostty\nghostty", ImageProtocolKitty},
+		{"on\nxterm-256color\nWezTerm", ImageProtocolKitty},
+		{"off\nxterm-kitty\nkitty", ""},
+		{"on\ntmux-256color\ntmux", ""},
+		{"on\nxterm-256color\n", ""},
+		{"", ""},
+	} {
+		if got := tmuxImageProtocol(tc.output); got != tc.want {
+			t.Errorf("probe %q: %q, want %q", tc.output, got, tc.want)
+		}
+	}
+	t.Setenv("TMUX", "test")
+	t.Setenv("TERM", "tmux-256color")
+	t.Setenv("KITTY_WINDOW_ID", "inherited")
+	previous := tmuxImageProbe
+	t.Cleanup(func() { tmuxImageProbe = previous })
+	for _, protocol := range []ImageProtocol{"", ImageProtocolKitty} {
+		tmuxImageProbe = func() ImageProtocol { return protocol }
+		caps := detectCapabilitiesFromEnvironment(func() bool { return true }, "linux")
+		if caps.Images != protocol || !caps.Hyperlinks {
+			t.Fatalf("capabilities: %+v", caps)
+		}
+	}
+}
+
+func TestTmuxKittyTransport(t *testing.T) {
+	t.Setenv("TMUX", "test")
+	command := "\x1b_Ga=d,q=2\x1b\\"
+	want := "\x1bPtmux;\x1b\x1b_Ga=d,q=2\x1b\x1b\\\x1b\\"
+	if got := wrapTmuxKitty(command); got != want {
+		t.Fatalf("wrapper: %q", got)
+	}
+	for _, size := range []int{4, 4096, 4097, 9000} {
+		data := strings.Repeat("A", size)
+		encoded := EncodeKitty(data, 3, 2, 42, false)
+		raw := unwrapTmuxKitty(encoded)
+		if strings.Count(encoded, tmuxDCS) != (size+4095)/4096 {
+			t.Fatalf("unwrapped chunk at size %d", size)
+		}
+		if !strings.Contains(raw, "U=1") {
+			t.Fatal("missing virtual placement")
+		}
+		var payload strings.Builder
+		for _, part := range strings.Split(raw, "\x1b_G")[1:] {
+			controls, chunk, ok := strings.Cut(part, ";")
+			if !ok || !strings.Contains(controls, "q=2") {
+				t.Fatalf("reply not suppressed: %q", controls)
+			}
+			payload.WriteString(strings.TrimSuffix(chunk, "\x1b\\"))
+		}
+		if payload.String() != data {
+			t.Fatal("transfer changed image data")
+		}
+	}
+	for _, deletion := range []string{DeleteKittyImage(42), DeleteAllKittyImages(), DeleteAllKittyPlacements()} {
+		if !strings.HasPrefix(deletion, tmuxDCS) {
+			t.Fatalf("bare deletion: %q", deletion)
+		}
+	}
+	t.Setenv("TMUX", "")
+	t.Setenv("TERM", "xterm-kitty")
+	if wrapTmuxKitty(command) != command {
+		t.Fatal("wrapped outside tmux")
+	}
+	if got := EncodeKitty("AAAA", 3, 2, 42, false); got != "\x1b_Ga=T,f=100,q=2,C=1,c=3,r=2,i=42;AAAA\x1b\\" {
+		t.Fatalf("direct rendering changed: %q", got)
+	}
+}
+
+func TestTmuxKittyPlaceholderLifecycle(t *testing.T) {
+	t.Setenv("TMUX", "test")
+	previous := GetCapabilities()
+	SetCapabilities(TerminalCapabilities{Images: ImageProtocolKitty})
+	t.Cleanup(func() { SetCapabilities(previous) })
+	dims := ImageDimensions{WidthPx: 36, HeightPx: 54}
+	preview := NewImage(strings.Repeat("A", 9000), "image/png", DefaultImageTheme(), ImageOptions{MaxWidthCells: 4, MaxHeightCells: 3, ImageID: 0xab123456}, &dims)
+	lines := preview.Render(6)
+	if len(lines) != 3 {
+		t.Fatalf("rows: %d", len(lines))
+	}
+	for row, line := range lines {
+		if widthx.VisibleWidth(line) != 4 {
+			t.Fatalf("row %d width: %d", row, widthx.VisibleWidth(line))
+		}
+		if !strings.HasSuffix(line, kittyPlaceholderRow(0xab123456, 4, row)) {
+			t.Fatalf("row %d has wrong coordinates", row)
+		}
+	}
+	if !strings.Contains(lines[0], "U=1") {
+		t.Fatal("no virtual placement")
+	}
+	placement, ok := GetKittyImagePlacement(lines[0])
+	if !ok || !strings.HasPrefix(placement.Sequence, tmuxDCS) || !strings.Contains(placement.Sequence, "U=1") {
+		t.Fatalf("placement: %+v, %v", placement, ok)
+	}
+	if strings.Contains(placement.ReplacementLine, "AAAA") || !strings.HasSuffix(placement.ReplacementLine, kittyPlaceholderRow(0xab123456, 4, 0)) {
+		t.Fatal("cached placement lost cells or retained payload")
+	}
+	cropped := CropKittyImageLine(lines[0], 1, 2)
+	if !strings.HasSuffix(cropped, kittyPlaceholderRow(0xab123456, 4, 1)) || !strings.Contains(cropped, "r=3") {
+		t.Fatal("crop resized virtual placement or lost row coordinates")
+	}
+	if _, ok := GetKittyImagePlacement(cropped); !ok {
+		t.Fatal("cropped upload cannot be cached")
+	}
+	view := NewScrollView(preview, ScrollViewOptions{Scrollbar: "never"})
+	RenderLayoutFrame(view, 6, 1, nil)
+	view.ScrollTo(2)
+	frame := RenderLayoutFrame(view, 6, 1, nil)
+	if !strings.Contains(frame.Lines[0], tmuxDCS) || !strings.HasSuffix(frame.Lines[0], kittyPlaceholderRow(0xab123456, 4, 2)) {
+		t.Fatal("scrolling past placeholder rows lost the upload")
+	}
+	renderer := &TuiAltScreen{uploadedKittyImages: map[int]cachedKittyImage{}}
+	first, _ := renderer.prepareKittyScreen(frame.Lines)
+	second, _ := renderer.prepareKittyScreen(frame.Lines)
+	if !strings.Contains(first[0], "AAAA") || strings.Contains(second[0], "AAAA") || !strings.Contains(second[0], "U=1") {
+		t.Fatal("upload cache did not preserve the virtual placement")
+	}
+	if _, ok := GetKittyImagePlacement(tmuxDCS + "broken"); ok {
+		t.Fatal("accepted an incomplete envelope")
+	}
+}
