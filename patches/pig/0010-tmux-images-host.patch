+}
+
+func kittyPlaceholderRow(imageID, columns, row int) string {
+	var line strings.Builder
+	fmt.Fprintf(&line, "\x1b[39;59m\x1b[38;2;%d;%d;%dm", (imageID>>16)&255, (imageID>>8)&255, imageID&255)
+	for col := range columns {
+		line.WriteRune('\U0010eeee')
+		line.WriteRune(kittyDiacritics[row])
+		line.WriteRune(kittyDiacritics[col])
+		line.WriteRune(kittyDiacritics[(imageID>>24)&255])
+	}
+	line.WriteString("\x1b[39;59m")
+	return line.String()
+}
