+package tui
+
+import (
+	"fmt"
+	"strings"
+)
+
+const collapsedToolPreviewRows = 10
+
+// collapsedToolRows caps visible output, not the retained tool result. Headers,
+// expansion hints and separately rendered images keep their normal framing.
+func (c *ToolExecutionComponent) collapsedToolRows(rows []string, width int) []string {
+	if !c.Collapsed || len(rows) <= collapsedToolPreviewRows {
+		return rows
+	}
+	out := append([]string(nil), rows[:collapsedToolPreviewRows]...)
+	remaining := len(rows) - collapsedToolPreviewRows
+	hint := fmt.Sprintf("... (%d more line%s, %s to expand)", remaining, plural(remaining), AppKeyText("app.tools.expand", "ctrl+o"))
+	// A renderer may already have truncated its result. Its remaining count is
+	// unknown here, so do not describe the discarded hint as hidden output.
+	if strings.Contains(strings.Join(rows, ""), "to expand") {
+		hint = "... (" + AppKeyText("app.tools.expand", "ctrl+o") + " to expand)"
+	}
+	return append(out, wrapText(ActiveTheme().FgText("muted", hint), max(1, width))...)
+}
+
+type toolResultPreview struct {
+	card  *ToolExecutionComponent
+	child Component
+}
+
+func (p *toolResultPreview) Render(width int) []string {
+	return p.card.collapsedToolRows(flattenVisualRows(p.child.Render(width)), width)
+}
+func (p *toolResultPreview) Invalidate() { p.child.Invalidate() }
+func (p *toolResultPreview) IsDirty() bool {
+	dirty, ok := p.child.(rendererDirtyReporter)
+	return ok && dirty.IsDirty()
+}
+func (p *toolResultPreview) HandleMouse(event TuiMouseEvent) *TuiMouseDispatchResult {
+	if p.card.Collapsed && event.Y >= collapsedToolPreviewRows {
+		return nil
+	}
+	return DispatchMouseEvent(p.child, event)
+}
