+package codingagent
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/tui"
+)
+
+func TestToolExpansionPreferenceSurvivesNewSession(t *testing.T) {
+	cwd, agentDir := t.TempDir(), t.TempDir()
+	sm := NewSettingsManager(cwd, agentDir)
+	mode := NewInteractiveMode(InteractiveOptions{CWD: cwd, AgentDir: agentDir, SettingsManager: sm, Settings: sm.Get()})
+	if mode.toolsExpanded {
+		t.Fatal("fresh tools must be collapsed")
+	}
+	if classifyKeyWithBindings("\x0f", DefaultKeybindingsManager()) != actionToggleTools {
+		t.Fatal("Ctrl+O must toggle tools")
+	}
+	mode.toggleAllTools()
+	mode.backgroundTasks.Wait()
+	data, err := os.ReadFile(filepath.Join(agentDir, "settings.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var stored map[string]any
+	if err := json.Unmarshal(data, &stored); err != nil {
+		t.Fatal(err)
+	}
+	if stored["toolsExpanded"] != true {
+		t.Fatalf("preference not persisted: %s", data)
+	}
+	sm = NewSettingsManager(cwd, agentDir)
+	next := NewInteractiveMode(InteractiveOptions{CWD: cwd, AgentDir: agentDir, SettingsManager: sm, Settings: sm.Get()})
+	if !next.toolsExpanded {
+		t.Fatal("new session lost expanded preference")
+	}
+	next.toggleAllTools()
+	next.backgroundTasks.Wait()
+	sm = NewSettingsManager(cwd, agentDir)
+	last := NewInteractiveMode(InteractiveOptions{CWD: cwd, AgentDir: agentDir, SettingsManager: sm, Settings: sm.Get()})
+	if last.toolsExpanded {
+		t.Fatal("collapsed preference did not survive restart")
+	}
+}
+
+func TestToolExpansionPreferenceRapidTogglesPersistLatest(t *testing.T) {
+	sm := NewSettingsManager(t.TempDir(), t.TempDir())
+	mode := NewInteractiveMode(InteractiveOptions{SettingsManager: sm, Settings: sm.Get()})
+	for range 101 {
+		mode.toggleAllTools()
+	}
+	mode.backgroundTasks.Wait()
+	reloaded := NewSettingsManager(sm.cwd, sm.agentDir)
+	data, err := json.Marshal(reloaded.Get())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var stored map[string]any
+	_ = json.Unmarshal(data, &stored)
+	if stored["toolsExpanded"] != true {
+		t.Fatalf("latest preference lost: %s", data)
+	}
+}
+
+func TestToolExpansionPreferenceFailureIsVisible(t *testing.T) {
+	cwd, agentDir := t.TempDir(), t.TempDir()
+	sm := NewSettingsManager(cwd, agentDir)
+	if err := os.Mkdir(filepath.Join(agentDir, "settings.json"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	mode := NewInteractiveMode(InteractiveOptions{SettingsManager: sm, Settings: sm.Get()})
+	mode.chatContainer = tui.NewContainer()
+	mode.toggleAllTools()
+	mode.backgroundTasks.Wait()
+	for {
+		select {
+		case task := <-mode.uiTaskCh:
+			task()
+		default:
+			if !strings.Contains(strings.Join(mode.chatContainer.Render(100), "\n"), "Cannot save tool output preference") {
+				t.Fatal("save failure was hidden")
+			}
+			return
+		}
+	}
+}
+
+func TestToolExpansionSettingsRoundTripAndIsolation(t *testing.T) {
+	var global, project Settings
+	if err := json.Unmarshal([]byte(`{"toolsExpanded":true}`), &global); err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal([]byte(`{"toolsExpanded":false}`), &project); err != nil {
+		t.Fatal(err)
+	}
+	merged := mergeSettings(global, project)
+	if merged.ToolsExpanded == nil || *merged.ToolsExpanded {
+		t.Fatal("explicit project false did not override true")
+	}
+	*merged.ToolsExpanded = true
+	if *project.ToolsExpanded {
+		t.Fatal("merged settings aliased project state")
+	}
+	copy := cloneSettings(global)
+	*copy.ToolsExpanded = false
+	if !*global.ToolsExpanded {
+		t.Fatal("snapshot aliased global preference")
+	}
+	data, err := json.Marshal(project)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded map[string]any
+	if err := json.Unmarshal(data, &decoded); err != nil {
+		t.Fatal(err)
+	}
+	if decoded["toolsExpanded"] != false {
+		t.Fatal("explicit false lost on save")
+	}
+	if err := json.Unmarshal([]byte(`{"toolsExpanded":"false"}`), &project); err == nil {
+		t.Fatal("invalid preference type was accepted")
+	}
+}
