+package tui
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+)
+
+func TestCollapsedToolOutputCapsVisualRows(t *testing.T) {
+	for _, width := range []int{20, 80} {
+		for _, definition := range []bool{false, true} {
+			for _, size := range []int{9, 10, 15} {
+				card := NewToolExecutionComponent("custom", "test")
+				var lines []string
+				for i := 1; i <= size; i++ {
+					lines = append(lines, fmt.Sprintf("row-%02d", i))
+				}
+				body := strings.Join(lines, "\n")
+				if definition {
+					card.SetDefinition(&ToolDefinitionRenderers{Result: func(ToolRenderInput) (Component, bool) { return NewText(body), true }}, nil)
+				} else {
+					card.BodyRenderer = func(int, bool) []string { return lines }
+				}
+				card.SetResult(body, false, 0)
+				card.SetExpanded(false)
+				collapsed := strings.Join(card.Render(width), "\n")
+				if size > 10 && strings.Contains(collapsed, "row-11") {
+					t.Fatalf("width=%d definition=%v: oversized preview: %s", width, definition, collapsed)
+				}
+				if size <= 10 && !strings.Contains(collapsed, fmt.Sprintf("row-%02d", size)) {
+					t.Fatal("short output was clipped")
+				}
+				card.SetExpanded(true)
+				if expanded := strings.Join(card.Render(width), "\n"); !strings.Contains(expanded, fmt.Sprintf("row-%02d", size)) {
+					t.Fatal("expanded output was clipped")
+				}
+			}
+		}
+	}
+}
+
+func TestCollapsedToolOutputCapsWrappedFallbackRows(t *testing.T) {
+	for _, definition := range []bool{false, true} {
+		card := NewToolExecutionComponent("custom", "test")
+		if definition {
+			card.SetDefinition(&ToolDefinitionRenderers{}, nil)
+		}
+		card.SetResult(strings.Repeat("abcdefghij", 30), false, 0)
+		card.SetExpanded(false)
+		collapsed := strings.Join(card.Render(12), "\n")
+		if rows := strings.Count(collapsed, "abcdefghij"); rows != 10 {
+			t.Fatalf("definition=%v preview rows=%d, want 10", definition, rows)
+		}
+		card.SetExpanded(true)
+		if rows := strings.Count(strings.Join(card.Render(12), "\n"), "abcdefghij"); rows != 30 {
+			t.Fatalf("expanded rows=%d, want 30", rows)
+		}
+	}
+}
